<section class="b-pricing-enterprise section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="grid b-plans">
      {{#each plans}}
      <article class="card stack b-plan" {{#if featured}}data-featured{{/if}} data-field="plans.{{@index}}">
        <div class="cluster b-plan-head">
          <h3>{{name}}</h3>
          {{#if featured}}{{#if ../featuredLabel}}<p class="badge">{{../featuredLabel}}</p>{{/if}}{{/if}}
        </div>
        <p><span class="b-amount">{{price}}</span> <span class="b-muted">{{period}}</span></p>
        {{#if description}}<p class="b-muted">{{nl2br description}}</p>{{/if}}
        <ul class="b-checks" role="list">
          {{#each features}}
          <li data-field="plans.{{@../index}}.features.{{@index}}">{{svgIcon "check"}}<span>{{text}}</span></li>
          {{/each}}
        </ul>
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
      </article>
      {{/each}}
    </div>
    <div class="b-enterprise">
      <div class="stack b-copy">
        <h3 data-field="enterpriseTitle">{{enterpriseTitle}}</h3>
        {{#if enterpriseText}}<p class="b-muted" data-field="enterpriseText">{{nl2br enterpriseText}}</p>{{/if}}
        {{#if perks.length}}
        <ul class="b-checks b-perks" role="list">
          {{#each perks}}
          <li data-field="perks.{{@index}}">{{svgIcon "check"}}<span>{{text}}</span></li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
      <a class="btn btn-{{enterpriseButton.variant}}" href="{{href enterpriseButton.link}}" {{linkAttrs enterpriseButton.link}} data-field="enterpriseButton">{{enterpriseButton.label}}</a>
    </div>
  </div>
</section>
