            {
              "text": "Unlimited roadmaps"
            },
            {
              "text": "Feedback portal"
            },
            {
              "text": "Jira and Linear sync"
            }
          ],
          "featured": false,
          "button": {
            "label": "Start free trial",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "secondary"
          }
        },
        {
          "name": "Growth",
          "price": "$36",
          "period": "per seat, per month",
          "description": "For product orgs planning across several teams.",
          "features": [
            {
              "text": "Everything in Team"
            },
            {
              "text": "Portfolio views and OKRs"
            },
            {
              "text": "Custom fields and formulas"
