<section class="b-cta-two-cards section">
  <div class="container stack b-inner">
    {{#if title}}<h2 class="b-title" data-field="title">{{title}}</h2>{{/if}}
    <ul class="b-cards" role="list">
      {{#each paths}}
      <li class="card stack b-card"{{#if highlight}} data-highlight{{/if}} data-field="paths.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <h3>{{title}}</h3>
        {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
        <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
