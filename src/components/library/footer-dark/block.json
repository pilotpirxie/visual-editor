    {
      "name": "socials",
      "label": "Social links",
      "type": "list",
      "group": "Social",
      "minItems": 0,
      "maxItems": 6,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Name",
          "type": "text",
          "default": "Social network"
        },
        {
          "name": "icon",
          "label": "Icon",
          "type": "icon",
          "default": "globe",
          "iconPurpose": "brand"
