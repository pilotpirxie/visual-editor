              "link": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            }
          ]
        },
        {
          "title": "Resources",
          "links": [
            {
              "label": "Research guide",
              "link": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            },
            {
              "label": "Interview templates",
              "link": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            },
            {
              "label": "Webinars",
              "link": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            },
            {
              "label": "Help center",
              "link": {
                "type": "url",
                "url": "#",
