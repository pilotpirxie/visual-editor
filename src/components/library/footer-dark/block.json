{
  "name": "Footer, dark",
  "category": "footers",
  "description": "A dark footer with a short statement, a button, link columns and social links.",
  "tags": ["footer", "dark", "links", "columns", "social"],
  "fieldGroups": ["Brand", "Button", "Columns", "Social", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "tagline",
      "label": "Tagline",
      "type": "textarea",
      "default": "Hear what customers really mean, not just what they click.",
      "group": "Brand"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Button",
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      }
    },
    {
      "name": "columns",
      "label": "Link columns",
      "type": "list",
      "group": "Columns",
      "minItems": 1,
      "maxItems": 4,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "title",
          "label": "Column title",
          "type": "text",
          "default": "Column"
        },
        {
          "name": "links",
          "label": "Links",
          "type": "list",
          "minItems": 0,
          "maxItems": 8,
          "itemLabel": "label",
          "itemFields": [
            {
              "name": "label",
              "label": "Label",
              "type": "text",
              "default": "Link"
            },
            {
              "name": "link",
              "label": "Link",
              "type": "link",
              "default": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            }
          ],
          "default": []
        }
      ],
      "default": [
        {
          "title": "Product",
          "links": [
            {
              "label": "Features",
              "link": {
                "type": "section",
                "anchor": "features",
                "newTab": false
              }
            },
            {
              "label": "Pricing",
              "link": {
                "type": "section",
                "anchor": "pricing",
                "newTab": false
              }
            },
            {
              "label": "Integrations",
              "link": {
                "type": "url",
