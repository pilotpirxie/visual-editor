<section class="b-content-overlap-card section" data-card-side="{{cardSide}}">
  <div class="container b-inner">
    <div class="media b-media" style="--image-ratio: {{image.width}} / {{image.height}}" data-field="image">{{img image}}</div>
    <div class="card stack b-card">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
      {{#if showLink}}<a class="b-link" href="{{href link}}" {{linkAttrs link}} data-field="link"><span data-field="linkLabel">{{linkLabel}}</span>{{svgIcon "arrow-right"}}</a>{{/if}}
    </div>
  </div>
</section>
