{
  "name": "Call to action, background image",
  "category": "call-to-action",
  "description": "A centered pitch with two buttons over a darkened full-width photo.",
  "tags": ["cta", "background", "image", "photo", "overlay", "dark"],
  "fieldGroups": ["Content", "Buttons", "Image"],
  "styleOverrides": ["--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Field-tested",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Hear it from customers, not from a slide deck",
      "group": "Content",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Fieldnote records, transcribes and tags every conversation, so the whole team can listen in on what customers really said.",
      "group": "Content"
    },
    {
      "name": "primaryButton",
      "label": "Primary button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Buttons"
    },
    {
      "name": "showSecondary",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Buttons"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "Watch the tour",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Buttons",
      "visibleWhen": {
        "field": "showSecondary",
        "equals": true
      }
    },
    {
      "name": "image",
      "label": "Background image",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "A product team listening to a customer interview in a meeting room",
        "decorative": true,
        "width": 2100,
        "height": 900,
        "placeholder": {
          "ratio": "21:9",
          "subject": "photo"
        }
      },
      "group": "Image"
    }
  ]
}
