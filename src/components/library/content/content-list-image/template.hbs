<section class="b-content-list-image section" data-image-side="{{imageSide}}">
  <div class="container b-inner">
    <div class="stack b-copy">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
      <ul class="b-list" role="list">
        {{#each items}}
        <li class="b-item" data-field="items.{{@index}}">
          {{#if ../checkIcon}}<span class="b-check">{{svgIcon ../checkIcon}}</span>{{/if}}
          <span>{{text}}</span>
        </li>
        {{/each}}
      </ul>
      {{#if showButton}}
      <div class="cluster b-actions">
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      </div>
      {{/if}}
    </div>
    <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}" data-field="image">
      {{img image}}
    </div>
  </div>
</section>
