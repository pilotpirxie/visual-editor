<section class="b-content-quote section">
  <div class="container">
    <figure class="stack b-figure">
      {{#if showIcon}}{{#if quoteIcon}}<span class="b-icon" data-field="quoteIcon">{{svgIcon quoteIcon}}</span>{{/if}}{{/if}}
      <blockquote class="b-quote" data-field="quote"><p>{{nl2br quote}}</p></blockquote>
      {{#if name}}
      <figcaption class="b-attribution">
        {{#if showPhoto}}<div class="media b-photo" data-field="photo">{{img photo}}</div>{{/if}}
        <p class="b-source">
          <span class="b-name" data-field="name">{{name}}</span>
          {{#if role}}<span class="b-role" data-field="role">{{role}}</span>{{/if}}
        </p>
      </figcaption>
      {{/if}}
    </figure>
  </div>
</section>
