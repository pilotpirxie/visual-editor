{
  "name": "Content, course curriculum",
  "category": "content",
  "description": "Modules that open to show their lessons and durations, with course totals above, for a course or a book.",
  "tags": [
    "curriculum",
    "course",
    "modules",
    "lessons",
    "syllabus",
    "chapters",
    "table of contents",
    "programme",
    "what you will learn",
    "book contents"
  ],
  "fieldGroups": ["Heading", "Modules", "Button"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Course curriculum",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "From your first wash to three finished paintings",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Watercolor for Beginners starts with what to buy and ends with paintings you will want to frame. Open a module to see every lesson in it.",
      "group": "Heading"
    },
    {
      "name": "summary",
      "label": "Totals",
      "type": "text",
      "default": "4 modules, 18 lessons, 3 hours 22 minutes of video",
      "group": "Heading",
      "help": "Leave empty to hide the line."
    },
    {
      "name": "modules",
      "label": "Modules",
      "type": "list",
      "group": "Modules",
      "minItems": 1,
      "maxItems": 12,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Module"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Module title"
        },
        {
          "name": "text",
          "label": "Text",
          "type": "textarea",
          "default": "What this module covers."
        },
        {
          "name": "meta",
          "label": "Lessons and length",
          "type": "text",
          "default": "1 lesson, 10 min"
        },
        {
          "name": "lessons",
          "label": "Lessons",
          "type": "list",
          "minItems": 1,
          "maxItems": 12,
          "itemLabel": "title",
          "itemFields": [
            {
              "name": "title",
              "label": "Title",
              "type": "text",
              "default": "Lesson title"
            },
            {
              "name": "duration",
              "label": "Duration",
              "type": "text",
              "default": "10 min",
              "maxLength": 20
            },
            {
              "name": "tag",
              "label": "Tag",
              "type": "text",
              "default": "",
              "maxLength": 24
            }
          ],
          "default": [
            {
              "title": "Lesson title",
              "duration": "10 min",
              "tag": ""
            }
          ]
        }
      ],
      "default": [
        {
