<aside class="b-banner-spotlight" aria-label="Announcement">
  <div class="container b-bar">
    <p class="b-message">
      {{#if label}}<span class="badge b-label" data-field="label">{{label}}</span>{{/if}}
      <span class="b-text" data-field="text">{{text}}</span>
    </p>
    {{#if showButton}}
    <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}{{svgIcon "arrow-right"}}</a>
    {{/if}}
  </div>
</aside>
