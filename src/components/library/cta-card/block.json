{
  "name": "Call to action, boxed card",
  "category": "call-to-action",
  "description": "A centered card with an icon, a short pitch, two buttons and a small note.",
  "tags": ["cta", "card", "icon", "trial", "boxed"],
  "fieldGroups": ["Content", "Buttons"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "icon",
      "label": "Icon",
      "type": "icon",
      "default": "rocket",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Your first study, set up in ten minutes",
      "group": "Content",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Import last quarter’s calls, invite your team and see the first themes appear before lunch.",
      "group": "Content"
    },
    {
      "name": "note",
      "label": "Note",
      "type": "text",
      "default": "Free for 14 days. No credit card needed.",
      "group": "Content"
    },
    {
      "name": "primaryButton",
      "label": "Primary button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Buttons"
    },
    {
      "name": "showSecondary",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Buttons"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "See a sample project",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Buttons",
      "visibleWhen": {
        "field": "showSecondary",
        "equals": true
      }
    }
  ]
}
