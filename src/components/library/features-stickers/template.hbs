<section class="b-features-stickers section">
  <div class="container stack b-inner">
    <header class="stack" style="--stack-gap: var(--space-3)">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-sheet" aria-hidden="true">
      {{#if sheetLabel}}<p class="b-label" data-field="sheetLabel">{{sheetLabel}}</p>{{/if}}
      <ul class="b-stickers" role="list">
        {{#each items}}
        <li class="b-sticker" data-field="items.{{@index}}">{{svgIcon icon}}<span>{{name}}</span></li>
        {{/each}}
      </ul>
    </div>
    <dl class="grid" style="--grid-min: 18rem">
      {{#each items}}
      <div data-field="items.{{@index}}">
        <dt>{{name}}</dt>
        <dd>{{nl2br text}}</dd>
      </div>
      {{/each}}
    </dl>
  </div>
</section>
