<section class="b-content-tilted-band section">
  <div class="b-band" data-theme="{{theme}}">
    <div class="container b-inner">
      <div class="stack b-head">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 class="b-title" data-field="title">{{title}}</h2>
      </div>
      <div class="stack b-copy">
        {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
        {{#if showButton}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
      </div>
    </div>
  </div>
</section>
