{
  "name": "Content, tilted band",
  "category": "content",
  "description": "A full-width band in the primary or dark theme colours, tilted about 2 degrees, with the text inside set straight.",
  "tags": ["band", "tilted", "slanted", "diagonal", "stripe", "statement", "bold", "expressive"],
  "fieldGroups": ["Content", "Button", "Style"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Open studio, every first Saturday",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Bring a file. Leave with fifty posters.",
      "group": "Content",
      "required": true,
      "maxLength": 100
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Loud Paper is a two-drum risograph studio above the old tram depot in Leeds. On open days we help you set up your artwork, pick two of our fourteen inks and run the job while you wait. 35 pounds covers paper, ink and tea.",
      "group": "Content"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "See the next open day",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "theme",
      "label": "Band colours",
      "type": "select",
      "default": "dark",
      "group": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    }
  ]
}
