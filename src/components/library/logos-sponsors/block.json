{
  "name": "Logo cloud, sponsor tiers",
  "category": "logo-clouds",
  "description": "Sponsor logos grouped by tier, larger for higher tiers, with a button to become a sponsor.",
  "tags": ["logos", "sponsors", "partners", "tiers", "event", "conference", "open source"],
  "fieldGroups": ["Heading", "Tiers", "Button"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Sponsors",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Made possible by our sponsors",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Northside Dev Days is run by volunteers. These companies cover the venue, travel grants and the free livestream.",
      "group": "Heading"
    },
    {
      "name": "tiers",
      "label": "Tiers",
      "type": "list",
      "group": "Tiers",
      "minItems": 1,
      "maxItems": 5,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "name",
          "label": "Tier name",
          "type": "text",
          "default": "Tier"
        },
        {
          "name": "size",
          "label": "Logo size",
          "type": "select",
          "default": "medium",
          "options": [
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ]
        },
        {
          "name": "logos",
          "label": "Logos",
          "type": "list",
          "minItems": 1,
          "maxItems": 12,
          "itemLabel": "company",
          "itemFields": [
            {
              "name": "company",
              "label": "Company",
              "type": "text",
              "default": "Company"
            },
            {
              "name": "image",
              "label": "Logo",
              "type": "image",
              "default": {
                "source": "placeholder",
