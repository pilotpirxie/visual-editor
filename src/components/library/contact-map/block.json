{
  "name": "Contact, form and map",
  "category": "contacts",
  "description": "A message form beside a map, the office address and opening hours.",
  "tags": ["contact", "form", "map", "address", "location", "office", "hours", "visit"],
  "fieldGroups": ["Heading", "Form", "Location"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Visit us",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Come and meet the team in Toronto",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Send us a message, or book a seat in our interview room and see how product teams run research with Fieldnote.",
      "group": "Heading"
    },
    {
      "name": "nameLabel",
      "label": "Name field label",
      "type": "text",
      "default": "Your name",
      "required": true,
      "group": "Form"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "required": true,
      "group": "Form"
    },
    {
      "name": "messageLabel",
      "label": "Message field label",
      "type": "text",
      "default": "What would you like to talk about?",
      "required": true,
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Send message",
      "required": true,
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    },
    {
      "name": "image",
      "label": "Map image",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "Map of our office near King Street West, Toronto",
        "decorative": false,
        "width": 1200,
        "height": 900,
        "placeholder": {
          "ratio": "4:3",
          "subject": "photo"
        }
      },
      "group": "Location"
    },
    {
      "name": "addressTitle",
      "label": "Address title",
      "type": "text",
      "default": "Office",
      "group": "Location"
    },
    {
      "name": "address",
      "label": "Address",
      "type": "textarea",
      "default": "220 King Street West\nSuite 400\nToronto, ON M5H 1K4",
      "group": "Location"
    },
    {
      "name": "hoursTitle",
      "label": "Opening hours title",
      "type": "text",
      "default": "Opening hours",
      "group": "Location"
    },
    {
      "name": "hours",
      "label": "Opening hours",
      "type": "textarea",
      "default": "Weekdays, 9 am to 6 pm\nWeekends by appointment",
      "group": "Location"
    }
  ]
}
