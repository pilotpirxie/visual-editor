{
  "name": "Banner, announcement bar",
  "category": "banners",
  "description": "A slim strip above the navigation with one short line of news and a link.",
  "tags": ["announcement", "banner", "news", "release", "top bar", "notice"],
  "fieldGroups": ["Message", "Link"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "showIcon",
      "label": "Show icon",
      "type": "boolean",
      "default": true,
      "group": "Message"
    },
    {
      "name": "icon",
      "label": "Icon",
      "type": "icon",
      "default": "sparkles",
      "visibleWhen": {
        "field": "showIcon",
        "equals": true
      },
      "group": "Message"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "text",
      "default": "Fieldnote now transcribes interviews in 30 languages, including Japanese and Polish.",
      "required": true,
      "maxLength": 140,
      "group": "Message"
    },
    {
      "name": "linkLabel",
      "label": "Link text",
      "type": "text",
      "default": "Read the release notes",
      "group": "Link"
    },
    {
      "name": "link",
      "label": "Link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Link"
    }
  ]
}
