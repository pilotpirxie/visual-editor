<section class="b-steps-duration section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="card b-sheet">
      <ol class="b-steps" role="list">
        {{#each steps}}
        <li class="b-step" data-field="steps.{{@index}}">
          <div class="stack b-body">
            <h3>{{title}}</h3>
            {{#if text}}<p class="b-muted">{{nl2br text}}</p>{{/if}}
          </div>
          {{#if duration}}<span class="badge b-time">{{svgIcon "clock"}}{{duration}}</span>{{/if}}
        </li>
        {{/each}}
      </ol>
      {{#if (or total showButton)}}
      <div class="b-total">
        {{#if total}}<p class="b-sum" data-field="total">{{svgIcon "clock"}}{{total}}</p>{{/if}}
        {{#if showButton}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
      </div>
      {{/if}}
    </div>
  </div>
</section>
