<section class="b-contact-business-cards section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-desk" role="list">
      {{#each people}}
      <li class="b-slot" data-field="people.{{@index}}">
        <article class="b-bizcard">
          {{#if ../firm}}<p class="b-firm">{{../firm}}</p>{{/if}}
          <h3 class="b-name">{{name}}</h3>
          {{#if role}}<p class="b-role">{{role}}</p>{{/if}}
          <address class="b-lines">
            {{#if phone}}<a href="tel:{{phone}}">{{svgIcon "phone"}}<span>{{phone}}</span></a>{{/if}}
            {{#if email}}<a href="mailto:{{email}}">{{svgIcon "mail"}}<span>{{email}}</span></a>{{/if}}
          </address>
        </article>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
