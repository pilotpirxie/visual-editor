<aside class="b-banner-version" aria-label="New version">
  <div class="container b-bar">
    <a class="b-pill" href="{{href link}}" {{linkAttrs link}} data-field="text">
      <span class="b-tag" data-field="version">{{version}}</span>
      <span class="b-text">{{text}}</span>
      {{#if linkLabel}}<span class="b-more" data-field="linkLabel">{{linkLabel}}{{svgIcon "arrow-right"}}</span>{{/if}}
    </a>
  </div>
</aside>
