<section class="b-content-two-columns section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <div class="b-columns">
      <div class="prose b-column" data-field="left">{{richText left}}</div>
      <div class="prose b-column" data-field="right">{{richText right}}</div>
    </div>
  </div>
</section>
