{
  "name": "Newsletter, over image",
  "category": "newsletters",
  "description": "A signup card centered over a full-width background photo.",
  "tags": ["newsletter", "email", "subscribe", "signup", "form", "background", "image", "photo"],
  "fieldGroups": ["Heading", "Form", "Image"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Newsletter",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Field notes, straight to your inbox",
      "group": "Heading",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Interview tips, research templates and stories from teams who talk to customers every week.",
      "group": "Heading"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Email address",
      "group": "Form",
      "required": true
    },
    {
      "name": "emailPlaceholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "you@company.com",
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Subscribe",
      "group": "Form",
      "required": true
    },
    {
      "name": "note",
      "label": "Privacy note",
      "type": "text",
      "default": "One email a month. Unsubscribe any time.",
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    },
    {
      "name": "image",
      "label": "Background image",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "",
        "decorative": true,
        "width": 1600,
        "height": 900,
        "placeholder": {
          "ratio": "16:9",
          "subject": "photo"
        }
      },
      "group": "Image"
    }
  ]
}
