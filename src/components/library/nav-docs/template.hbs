<nav class="b-nav-docs" data-behavior="menu" aria-label="Main">
  <div class="container b-bar">
    <div class="b-brand">
      <a class="b-logo" href="index.html" data-field="logoIcon">{{svgIcon logoIcon}}<span>{{site.title}}</span></a>
      {{#if version}}<span class="b-version" data-field="version">{{version}}</span>{{/if}}
    </div>
    {{#if showRepo}}
    <a class="b-repo" href="{{href repoLink}}" {{linkAttrs repoLink}} data-field="repoLink">{{svgIcon repoIcon}}<span class="visually-hidden">{{repoLabel}}</span>{{#if repoStars}}<span class="b-stars">{{svgIcon "star"}}{{repoStars}}</span>{{/if}}</a>
    {{/if}}
    <button type="button" class="btn btn-ghost b-toggle" popovertarget="{{block.id}}-menu" aria-controls="{{block.id}}-menu" aria-expanded="false" data-field="menuIcon">
      {{svgIcon menuIcon}}<span class="visually-hidden">Menu</span>
    </button>
    <div id="{{block.id}}-menu" class="b-menu" popover>
      <ul class="b-links" role="list">
        {{#each links}}
        <li><a href="{{href link}}" {{linkAttrs link}} data-field="links.{{@index}}">{{label}}</a></li>
        {{/each}}
      </ul>
      {{#if showCta}}
      <a class="btn btn-{{cta.variant}} b-cta" href="{{href cta.link}}" {{linkAttrs cta.link}} data-field="cta">{{cta.label}}</a>
      {{/if}}
    </div>
  </div>
</nav>
