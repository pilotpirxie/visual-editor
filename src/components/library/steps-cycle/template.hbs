<section class="b-steps-cycle section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-loop">
      <ol class="b-steps" role="list">
        {{#each steps}}
        <li class="card stack b-step" data-field="steps.{{@index}}">
          <span class="b-icon">{{svgIcon icon}}</span>
          <h3>{{title}}</h3>
          <p class="b-muted">{{nl2br text}}</p>
        </li>
        {{/each}}
      </ol>
      <span class="b-hub" aria-hidden="true">{{svgIcon "repeat"}}</span>
    </div>
    {{#if loopNote}}<p class="b-note" data-field="loopNote">{{svgIcon "refresh"}}{{loopNote}}</p>{{/if}}
  </div>
</section>
