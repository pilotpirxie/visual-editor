{
  "name": "Team, photo grid",
  "category": "team",
  "description": "A heading, a short intro and a grid of photos with names and roles.",
  "tags": ["team", "people", "about", "photos", "speakers", "grid"],
  "fieldGroups": ["Heading", "People"],
