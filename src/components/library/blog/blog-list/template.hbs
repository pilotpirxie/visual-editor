<section class="b-blog-list section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-list">
      {{#each posts}}
      <article class="b-post" data-field="posts.{{@index}}">
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}">{{img image}}</div>
        <div class="stack b-body">
          {{#if (or category date)}}
          <p class="b-meta">
            {{#if category}}<span class="b-category">{{category}}</span>{{/if}}
            {{#if date}}<time datetime="{{date}}">{{formatDate date}}</time>{{/if}}
          </p>
          {{/if}}
          <h3 class="b-title"><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{title}}</a></h3>
          {{#if excerpt}}<p class="b-excerpt">{{nl2br excerpt}}</p>{{/if}}
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
