<section class="b-content-big-word section">
  <div class="container b-inner">
    {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
    <h2 class="b-word" style="--size: {{size}}" data-field="word">{{word}}</h2>
    <div class="b-tuck">
      <div class="stack b-copy">
        {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
        {{#if showButton}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
      </div>
    </div>
  </div>
</section>
