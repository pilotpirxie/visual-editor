<section class="b-gallery-before-after section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="stack b-pairs">
      {{#each pairs}}
      <article class="b-pair" data-field="pairs.{{@index}}">
        <div class="stack b-about">
          <h3 class="b-title">{{title}}</h3>
          {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
        </div>
        <div class="b-images">
          <figure class="b-figure">
            <div class="media b-media">{{img before}}</div>
            <figcaption class="badge b-label">{{../beforeLabel}}</figcaption>
          </figure>
          <figure class="b-figure">
            <div class="media b-media">{{img after}}</div>
            <figcaption class="badge b-label" data-after>{{../afterLabel}}</figcaption>
          </figure>
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
