{
  "name": "Blog posts, text over images",
  "category": "blog",
  "description": "Tall image cards with the topic, title and byline over a dark fade.",
  "tags": ["blog", "posts", "articles", "cards", "overlay", "image", "visual"],
  "fieldGroups": ["Heading", "Button", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Field stories",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "How teams put customer conversations to work",
      "group": "Heading",
      "required": true
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Read more stories",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 1,
      "maxItems": 6,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Image",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Cover image",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "photo"
            }
          }
        },
        {
          "name": "category",
          "label": "Category",
          "type": "text",
          "default": "Research"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Post title"
        },
        {
          "name": "author",
          "label": "Author",
          "type": "text",
          "default": "Author name"
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Sticky notes grouped into themes on a whiteboard",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "photo"
            }
          },
          "category": "Synthesis",
          "title": "Tagging is not synthesis: from 40 interviews to three decisions",
          "author": "Yuki Tanaka",
          "date": "2026-09-01",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Two colleagues reviewing call highlights on a shared screen",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "photo"
            }
          },
          "category": "Research ops",
          "title": "Your sales calls are the research you are not using",
          "author": "Jonas Becker",
          "date": "2026-08-18",
          "link": {
