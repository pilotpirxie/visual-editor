{
  "name": "Newsletter, compact strip",
  "category": "newsletters",
  "description": "A slim strip with an icon, one line of text and an email form on the same row.",
  "tags": ["newsletter", "email", "subscribe", "signup", "form", "strip", "compact", "inline"],
  "fieldGroups": ["Content", "Form"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "icon",
      "label": "Icon",
      "type": "icon",
      "default": "mail",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Get one research tip every Tuesday",
      "group": "Content",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "text",
      "default": "Short, practical and free. Join 12,400 researchers.",
      "group": "Content"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Email address",
      "group": "Form",
      "required": true
    },
    {
      "name": "emailPlaceholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "you@company.com",
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Subscribe",
      "group": "Form",
      "required": true
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    }
  ]
}
