{
  "name": "Gallery, click to enlarge",
  "category": "gallery",
  "description": "A grid of square photos. Selecting one opens it full width with its caption, and only one stays open. Works without JavaScript.",
  "tags": ["gallery", "photos", "images", "lightbox", "enlarge", "zoom", "grid", "portfolio"],
  "fieldGroups": ["Heading", "Photos", "Labels"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Inside the studio",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Our King Street office",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Two quiet interview booths, one long table and a wall of quotes. Select a photo to see it larger.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 1,
      "maxItems": 24,
      "itemLabel": "caption",
      "itemFields": [
