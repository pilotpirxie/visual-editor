<section class="b-testimonial-pull-quote section">
  <div class="container b-inner">
    <figure class="b-figure">
      <blockquote class="b-quote" data-field="quote"><p>{{nl2br quote}}</p></blockquote>
      <figcaption class="b-credit">
        <span class="b-name" data-field="name">{{name}}</span>
        {{#if role}}<span class="b-role" data-field="role">{{role}}</span>{{/if}}
      </figcaption>
    </figure>
  </div>
</section>
