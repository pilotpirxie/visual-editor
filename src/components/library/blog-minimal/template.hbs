<section class="b-blog-minimal section">
  <div class="container stack b-inner">
    <div class="b-head">
      <header class="stack b-heading">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
      </header>
      {{#if showButton}}
      <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      {{/if}}
    </div>
    <ul class="b-list" role="list">
      {{#each posts}}
      <li class="b-post" data-field="posts.{{@index}}">
        {{#if date}}<time class="b-date" datetime="{{date}}">{{formatDate date}}</time>{{/if}}
        <h3 class="b-title"><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{title}}</a></h3>
        {{#if category}}<p class="b-category">{{category}}</p>{{/if}}
        <span class="b-arrow">{{svgIcon "arrow-right"}}</span>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
