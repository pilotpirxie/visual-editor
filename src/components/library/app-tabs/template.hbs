<section class="b-app-tabs section" data-behavior="tabs">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-tablist" role="tablist" aria-label="{{title}}" hidden>
      {{#each items}}
      <button type="button" class="b-tab" id="{{../block.id}}-tab-{{@index}}" aria-controls="{{../block.id}}-panel-{{@index}}" data-field="items.{{@index}}">{{svgIcon icon}}<span>{{label}}</span></button>
      {{/each}}
    </div>
    <div class="b-panels">
      {{#each items}}
      <div class="b-panel" id="{{../block.id}}-panel-{{@index}}" data-field="items.{{@index}}">
        <div class="b-device">
          <div class="device b-phone">
            <div class="media device-screen">{{img screenshot}}</div>
          </div>
        </div>
        <div class="stack b-copy">
          <h3>{{title}}</h3>
          {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
