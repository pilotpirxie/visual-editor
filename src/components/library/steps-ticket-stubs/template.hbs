<section class="b-steps-ticket-stubs section">
  <div class="container stack">
    <header class="stack">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-stubs" role="list">
      {{#each steps}}
      <li data-field="steps.{{@index}}">
        {{#if label}}<p class="b-label">{{label}}</p>{{/if}}
        <h3>{{title}}</h3>
        <p>{{nl2br text}}</p>
      </li>
      {{/each}}
    </ol>
  </div>
</section>
