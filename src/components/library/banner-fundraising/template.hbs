<aside class="b-banner-fundraising" aria-label="Fundraising campaign">
  <div class="container b-bar">
    <p class="b-message" data-field="text">{{text}}</p>
    <div class="b-progress" data-field="progress">
      <div class="b-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progress}}" aria-labelledby="{{block.id}}-amount" style="--progress: {{progress}}">
        <span class="b-fill"></span>
      </div>
      <p class="b-amount" id="{{block.id}}-amount"><strong data-field="raised">{{raised}}</strong>{{#if goal}} <span data-field="goal">{{goal}}</span>{{/if}}</p>
    </div>
    <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{svgIcon "heart"}}{{button.label}}</a>
  </div>
</aside>
