{
  "name": "Pricing, plan rows",
  "category": "pricing",
  "description": "Plans stacked as wide rows with key features, a price and a button on one line.",
  "tags": ["pricing", "plans", "rows", "list", "hosting", "horizontal", "tiers"],
  "fieldGroups": ["Heading", "Plans"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Hosting plans",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Fast hosting with room to grow",
      "group": "Heading",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Every plan runs on NVMe storage with free SSL, daily backups and a 30-day money-back guarantee.",
      "group": "Heading"
    },
    {
      "name": "featuredLabel",
      "label": "Label on the featured plan",
      "type": "text",
      "default": "Best for most sites",
      "group": "Plans"
    },
    {
      "name": "plans",
      "label": "Plans",
      "type": "list",
      "group": "Plans",
      "minItems": 1,
      "maxItems": 6,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "name",
          "label": "Plan name",
          "type": "text",
          "default": "Plan"
        },
        {
          "name": "description",
          "label": "Description",
          "type": "textarea",
          "default": "Who this plan is for."
        },
        {
          "name": "features",
          "label": "Key features",
          "type": "list",
          "minItems": 0,
          "maxItems": 4,
          "itemLabel": "text",
          "itemFields": [
            {
              "name": "text",
              "label": "Text",
              "type": "text",
              "default": "What is included"
            }
          ],
          "default": [
            {
              "text": "First feature"
            },
            {
              "text": "Second feature"
            }
          ]
        },
        {
          "name": "price",
          "label": "Price",
          "type": "text",
          "default": "$0"
        },
        {
          "name": "period",
          "label": "Period",
          "type": "text",
          "default": "per month"
        },
        {
          "name": "featured",
          "label": "Featured",
          "type": "boolean",
          "default": false
        },
        {
          "name": "button",
          "label": "Button",
          "type": "button",
          "default": {
            "label": "Choose plan",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "secondary"
          }
        }
      ],
      "default": [
        {
          "name": "Personal",
          "description": "One site, a blog or a portfolio.",
          "features": [
            {
              "text": "1 website"
            },
            {
              "text": "10 GB storage"
            },
            {
              "text": "Free domain for a year"
            }
          ],
          "price": "$4",
          "period": "per month",
          "featured": false,
          "button": {
            "label": "Choose Personal",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "secondary"
          }
        },
        {
          "name": "Business",
          "description": "Shops and busy company sites.",
          "features": [
            {
              "text": "10 websites"
            },
            {
              "text": "100 GB storage"
            },
            {
              "text": "Staging and Git deploys"
            }
          ],
          "price": "$12",
          "period": "per month",
          "featured": true,
          "button": {
            "label": "Choose Business",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "primary"
          }
        },
        {
          "name": "Agency",
          "description": "Client sites with separate access.",
          "features": [
            {
              "text": "50 websites"
            },
            {
              "text": "400 GB storage"
            },
            {
              "text": "Client billing"
            }
          ],
          "price": "$39",
          "period": "per month",
          "featured": false,
          "button": {
            "label": "Choose Agency",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "secondary"
          }
        }
      ]
    }
  ]
}
