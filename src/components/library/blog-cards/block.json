{
  "name": "Blog posts, card grid",
  "category": "blog",
  "description": "A heading, a link to all posts and a grid of post cards with images.",
  "tags": ["blog", "posts", "articles", "news", "cards", "grid"],
  "fieldGroups": ["Heading", "Button", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "From the blog",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Field notes on talking to customers",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "View all posts",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 3,
      "maxItems": 6,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Image",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Cover image",
            "decorative": false,
            "width": 1200,
            "height": 800,
            "placeholder": {
              "ratio": "3:2",
              "subject": "photo"
            }
          }
        },
        {
          "name": "category",
          "label": "Category",
          "type": "text",
          "default": "Research"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Post title"
        },
        {
          "name": "excerpt",
          "label": "Excerpt",
          "type": "textarea",
          "default": "One or two sentences that make readers want the rest."
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
