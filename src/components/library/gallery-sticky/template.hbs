<section class="b-gallery-sticky section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-stack" role="list">
      {{#each items}}
      <li class="b-card" data-field="items.{{@index}}">
        <div class="media b-photo">{{img image}}</div>
        <div class="stack b-copy">
          <h3 class="b-title">{{title}}</h3>
          {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
          {{#if meta}}<p class="b-meta">{{meta}}</p>{{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
  </div>
</section>
