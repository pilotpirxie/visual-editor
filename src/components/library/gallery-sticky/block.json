{
  "name": "Gallery, sticky stack",
  "category": "gallery",
  "description": "Large numbered photo cards with captions beside them that stick and pile up as visitors scroll.",
  "tags": ["gallery", "photos", "sticky", "scroll", "story", "case study", "cards"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Case study",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "How Ledgerly rebuilt month-end close",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Four moments from a twelve-week research project, in the order they happened.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 1,
      "maxItems": 6,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
