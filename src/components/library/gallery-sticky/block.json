            "alt": "Photo",
            "decorative": false,
            "width": 1200,
            "height": 800,
            "placeholder": {
              "ratio": "3:2",
              "subject": "photo"
            }
          }
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Title"
        },
        {
          "name": "text",
          "label": "Text",
          "type": "textarea",
          "default": ""
