{
  "name": "Contact, big email and phone",
  "category": "contacts",
  "description": "A short heading with an oversized email address and phone number, and an optional address.",
  "tags": ["contact", "email", "phone", "minimal", "large", "typography", "agency"],
  "fieldGroups": ["Heading", "Details"],
