{
  "name": "Blog posts, archive by year",
  "category": "blog",
  "description": "Every post grouped under a large year label that stays in view while you scroll.",
  "tags": ["blog", "posts", "articles", "news", "archive", "years", "list", "index"],
  "fieldGroups": ["Heading", "Years"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Archive",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Everything we have written",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Five years of interview guides, research ops playbooks and customer stories, newest first.",
      "group": "Heading"
    },
    {
      "name": "years",
      "label": "Years",
      "type": "list",
      "group": "Years",
      "minItems": 1,
      "maxItems": 10,
      "itemLabel": "year",
      "itemFields": [
        {
          "name": "year",
          "label": "Year",
          "type": "text",
          "default": "2026"
        },
        {
          "name": "posts",
          "label": "Posts",
          "type": "list",
          "minItems": 1,
          "maxItems": 20,
          "itemLabel": "title",
          "itemFields": [
            {
              "name": "title",
              "label": "Title",
              "type": "text",
              "default": "Post title"
            },
            {
              "name": "category",
              "label": "Category",
              "type": "text",
              "default": "Research"
            },
            {
              "name": "date",
              "label": "Date",
              "type": "date",
              "default": "2026-09-01"
            },
            {
              "name": "link",
              "label": "Link",
              "type": "link",
              "default": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            }
          ],
