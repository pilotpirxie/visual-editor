<nav class="b-nav-language" data-behavior="menu dropdown" aria-label="Main">
  <div class="container b-bar">
    <a class="b-logo" href="index.html">{{site.title}}</a>
    <button type="button" class="btn btn-ghost b-toggle" popovertarget="{{block.id}}-menu" aria-controls="{{block.id}}-menu" aria-expanded="false" data-field="menuIcon">
      {{svgIcon menuIcon}}<span class="visually-hidden">Menu</span>
    </button>
    <div id="{{block.id}}-menu" class="b-menu" popover>
      <ul class="b-links" role="list">
        {{#each links}}
        <li><a href="{{href link}}" {{linkAttrs link}} data-field="links.{{@index}}">{{label}}</a></li>
        {{/each}}
      </ul>
      <div class="b-end">
        <div class="b-lang">
          <p class="b-lang-heading" data-field="languageLabel">{{svgIcon "globe"}}<span>{{languageLabel}}</span></p>
          <button type="button" class="b-lang-toggle" popovertarget="{{block.id}}-lang" aria-expanded="false" style="anchor-name: --{{block.id}}-lang" data-field="currentLanguage">{{svgIcon "globe"}}<span aria-hidden="true">{{currentLanguage}}</span><span class="visually-hidden">{{languageLabel}}: {{currentLanguage}}</span>{{svgIcon "chevron-down"}}</button>
          <ul id="{{block.id}}-lang" class="b-langs" role="list" popover data-dropdown-menu style="position-anchor: --{{block.id}}-lang">
            {{#each languages}}
            <li><a href="{{href link}}" {{linkAttrs link}} lang="{{code}}" hreflang="{{code}}" data-field="languages.{{@index}}">{{label}}</a></li>
            {{/each}}
          </ul>
        </div>
        {{#if showCta}}
        <a class="btn btn-{{cta.variant}}" href="{{href cta.link}}" {{linkAttrs cta.link}} data-field="cta">{{cta.label}}</a>
        {{/if}}
      </div>
    </div>
  </div>
</nav>
