{
  "name": "Blog posts, mixed sizes",
  "category": "blog",
  "description": "A bento grid with one large story over its image, one tall post and a row of small ones.",
  "tags": ["blog", "posts", "articles", "news", "bento", "grid", "featured", "mixed"],
  "fieldGroups": ["Heading", "Button", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "The Fieldnote journal",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "What we are reading, writing and learning",
      "group": "Heading",
      "required": true
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "View all posts",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 3,
      "maxItems": 8,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Image",
