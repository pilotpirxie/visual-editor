<footer class="b-footer-offices section">
  <div class="container stack b-inner">
    <div class="b-top">
      <div class="stack b-brand">
        <a class="b-logo" href="index.html">{{site.title}}</a>
        {{#if tagline}}<p class="b-muted" data-field="tagline">{{nl2br tagline}}</p>{{/if}}
      </div>
      <ul class="b-offices" role="list">
        {{#each offices}}
        <li class="stack b-office" data-field="offices.{{@index}}">
          <h2 class="b-city">{{city}}{{#if label}} <span class="badge">{{label}}</span>{{/if}}</h2>
          <address class="b-muted">{{nl2br address}}</address>
          {{#if phone}}<a class="b-phone" href="tel:{{phone}}">{{phone}}</a>{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    <div class="b-bottom">
      <p class="b-muted" data-field="copyright">{{copyright}}</p>
      <nav aria-label="Footer">
        <ul class="cluster b-links" role="list">
          {{#each links}}
          <li><a href="{{href link}}" {{linkAttrs link}} data-field="links.{{@index}}">{{label}}</a></li>
          {{/each}}
        </ul>
      </nav>
    </div>
  </div>
</footer>
