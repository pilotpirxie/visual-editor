<section class="b-features-glossary section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-entries">
      {{#each items}}
      <article class="b-entry" data-field="items.{{@index}}">
        <h3 class="b-term">{{term}}</h3>
        {{#if (or sound kind)}}<p class="b-meta">{{#if sound}}<span class="b-sound">{{sound}}</span>{{/if}}{{#if kind}}<em class="b-kind">{{kind}}</em>{{/if}}</p>{{/if}}
        <p class="b-definition">{{nl2br definition}}</p>
        {{#if example}}<p class="b-example">{{example}}</p>{{/if}}
      </article>
      {{/each}}
    </div>
  </div>
</section>
