{
  "name": "Gallery, masonry",
  "category": "gallery",
  "description": "A heading and photos of mixed shapes stacked in columns, with optional captions.",
  "tags": ["gallery", "photos", "images", "masonry", "columns", "portfolio"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Research week",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Notes from the field",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Our team spent a week with customers at Northwind, Brightpath and Ledgerly. A few moments from the visits.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 2,
      "maxItems": 12,
      "itemLabel": "caption",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
