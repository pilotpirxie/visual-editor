{
  "name": "Team, expandable bios",
  "category": "team",
  "description": "Tall portraits with a Read bio button that opens each person’s story over their photo.",
  "tags": ["team", "people", "bio", "portraits", "expand", "about", "leadership"],
  "fieldGroups": ["Heading", "People", "Labels"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "The team",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Get to know us",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Short bios, longer stories. Open a card to read how each of us ended up building research tools.",
      "group": "Heading"
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 12,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "person"
            }
          }
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Name"
        },
        {
          "name": "role",
          "label": "Role",
          "type": "text",
          "default": "Role"
        },
        {
          "name": "bio",
          "label": "Bio",
          "type": "textarea",
          "maxLength": 400,
          "default": "A few sentences about this person."
        },
        {
          "name": "askMe",
          "label": "Fun fact",
          "type": "text",
          "default": "",
          "maxLength": 80
        }
      ],
