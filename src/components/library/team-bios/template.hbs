<section class="b-team-bios section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-grid" role="list">
      {{#each people}}
      <li class="b-person" data-field="people.{{@index}}">
        <div class="b-frame">
          <div class="media b-photo">{{img photo}}</div>
          <details class="b-more">
            <summary class="b-toggle">
              <span class="b-open">{{../moreLabel}}</span>
              <span class="b-close">{{../closeLabel}}</span>
              <span class="visually-hidden">: {{name}}</span>
              {{svgIcon "plus"}}
            </summary>
            <div class="stack b-bio">
              <p>{{nl2br bio}}</p>
              {{#if askMe}}<p class="b-ask">{{askMe}}</p>{{/if}}
            </div>
          </details>
        </div>
        <h3 class="b-name">{{name}}</h3>
        {{#if role}}<p class="b-role">{{role}}</p>{{/if}}
      </li>
      {{/each}}
    </ul>
  </div>
</section>
