<section class="b-faq-calm section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-list">
      {{#each items}}
      <details class="b-item" name="{{../block.id}}" data-field="items.{{@index}}" {{#if @first}}open{{/if}}>
        <summary class="b-question"><span>{{question}}</span><span class="b-icon">{{svgIcon "chevron-down"}}</span></summary>
        <div class="prose b-answer">{{richText answer}}</div>
      </details>
      {{/each}}
    </div>
    {{#if (or note button.label)}}
    <div class="stack b-foot">
      {{#if note}}<p class="b-note" data-field="note">{{nl2br note}}</p>{{/if}}
      {{#if button.label}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
    </div>
    {{/if}}
  </div>
</section>
