<section class="b-features-explorer section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-list" role="radiogroup" aria-label="{{title}}" style="--n: {{items.length}}">
      {{#each items}}
      <div class="b-item" data-field="items.{{@index}}">
        <label class="b-option">
          <input type="radio" name="{{../block.id}}-feature" value="{{@index}}" {{#if @first}}checked{{/if}}>
          {{svgIcon icon}}
          <span>{{name}}</span>
        </label>
        <div class="b-detail">
          <div class="media b-shot">{{img image}}</div>
          <p>{{nl2br text}}</p>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
