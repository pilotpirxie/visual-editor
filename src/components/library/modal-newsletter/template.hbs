<div class="b-modal-newsletter" data-behavior="modal">
  <dialog class="modal b-dialog" id="{{block.id}}-dialog" aria-labelledby="{{block.id}}-title">
    <span class="b-airmail" aria-hidden="true"></span>
    <button type="button" class="modal-close" command="close" commandfor="{{block.id}}-dialog" data-field="closeLabel">{{svgIcon "x"}}<span class="visually-hidden">{{closeLabel}}</span></button>
    <div class="stack b-body">
      <div class="b-head">
        <span class="b-stamp" data-field="stampLabel" aria-hidden="true"><span class="b-stamp-inner">{{svgIcon icon}}<span>{{stampLabel}}</span></span></span>
        <div class="stack b-titles">
          {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
          <h2 id="{{block.id}}-title" data-field="title">{{title}}</h2>
        </div>
      </div>
      {{#if text}}<p class="b-muted" data-field="text">{{nl2br text}}</p>{{/if}}
      {{#if perks.length}}
      <ul class="b-perks" role="list">
        {{#each perks}}
        <li data-field="perks.{{@index}}">{{svgIcon "check"}}<span>{{text}}</span></li>
        {{/each}}
      </ul>
      {{/if}}
      <form class="b-form" {{#if formAction}}action="{{safeUrl formAction}}" method="{{formMethod}}"{{else}}method="dialog"{{/if}} data-field="formAction">
        <div class="field b-field">
          <label class="visually-hidden" for="{{block.id}}-email" data-field="emailLabel">{{emailLabel}}</label>
          <input id="{{block.id}}-email" type="email" name="email" autocomplete="email" required placeholder="{{emailPlaceholder}}">
        </div>
        <button type="submit" class="btn btn-primary" data-field="buttonLabel">{{buttonLabel}}</button>
      </form>
      {{#if note}}<p class="b-muted b-note" data-field="note">{{note}}</p>{{/if}}
    </div>
  </dialog>
</div>
