<section class="b-features-orbit section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-layout">
      <ul class="b-list b-start" role="list">
        {{#each startItems}}
        <li class="stack b-item" data-field="startItems.{{@index}}">
          <span class="b-icon">{{svgIcon icon}}</span>
          <h3>{{title}}</h3>
          <p>{{nl2br text}}</p>
        </li>
        {{/each}}
      </ul>
      <div class="b-visual" data-field="image">
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}">{{img image}}</div>
      </div>
      <ul class="b-list" role="list">
        {{#each endItems}}
        <li class="stack b-item" data-field="endItems.{{@index}}">
          <span class="b-icon">{{svgIcon icon}}</span>
          <h3>{{title}}</h3>
          <p>{{nl2br text}}</p>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
