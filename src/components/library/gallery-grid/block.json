{
  "name": "Gallery, uniform grid",
  "category": "gallery",
  "description": "A heading and an even grid of same-shape photos with optional captions.",
  "tags": ["gallery", "photos", "images", "grid", "event", "portfolio"],
  "fieldGroups": ["Heading", "Photos", "Layout"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Fieldnote Research Summit 2026",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Two days of talks and workshops in Berlin",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Three hundred researchers, designers and product managers met to swap methods, war stories and interview tips. Here is what it looked like.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 1,
      "maxItems": 16,
      "itemLabel": "caption",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          }
        },
        {
          "name": "caption",
          "label": "Caption",
          "type": "text",
          "default": ""
        }
      ],
      "default": [
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Priya Raman on stage in front of a full auditorium",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "caption": "Priya Raman opens the summit"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Workshop tables covered in printed transcripts and sticky notes",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "caption": "Workshop: synthesis in an afternoon"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Jonas Becker presenting a slide of interview clips",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "caption": "Jonas Becker on research for engineers"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Four panelists seated on stage answering audience questions",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "caption": "Customer panel with Northwind and Ledgerly"
