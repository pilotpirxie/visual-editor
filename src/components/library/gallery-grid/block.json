        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A large screen showing highlights being tagged during a live interview",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "caption": "Live tagging demo on the main stage"
