    {
      "name": "ratio",
      "label": "Photo shape",
      "type": "select",
      "default": "landscape",
      "group": "Layout",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape 4:3"
        },
        {
          "value": "portrait",
          "label": "Portrait 3:4"
        }
      ]
    },
    {
      "name": "columns",
      "label": "Columns on desktop",
      "type": "select",
      "default": "3",
      "group": "Layout",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
