{
  "name": "Newsletter, dark",
  "category": "newsletters",
  "description": "A dark section with a pitch and subscriber count beside a form panel.",
  "tags": ["newsletter", "email", "subscribe", "signup", "form", "dark", "social proof"],
  "fieldGroups": ["Heading", "Social proof", "Form"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "The Fieldnote letter",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "What 400 product teams learned from their customers this month",
      "group": "Heading",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "One email on the first Monday of each month: the best interview moments, a technique worth stealing and the research templates our customers share.",
      "group": "Heading"
    },
    {
      "name": "count",
      "label": "Number",
      "type": "text",
      "default": "12,400",
      "group": "Social proof"
    },
    {
      "name": "countLabel",
      "label": "Number label",
      "type": "text",
      "default": "researchers and designers read it every month",
      "group": "Social proof"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "group": "Form",
      "required": true
    },
    {
      "name": "emailPlaceholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "you@company.com",
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Get the letter",
      "group": "Form",
      "required": true
    },
    {
      "name": "note",
      "label": "Privacy note",
      "type": "text",
      "default": "Free, monthly and easy to leave.",
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    }
  ]
}
