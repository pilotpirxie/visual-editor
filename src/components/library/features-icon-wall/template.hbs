<section class="b-features-icon-wall section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-wall" role="list">
      {{#each items}}
      <li class="b-tile" data-field="items.{{@index}}"><span class="b-icon">{{svgIcon icon}}</span><span>{{label}}</span></li>
      {{/each}}
      {{#if moreLabel}}<li class="b-more"><a href="{{href moreLink}}" {{linkAttrs moreLink}} data-field="moreLabel"><span>{{moreLabel}}</span>{{svgIcon "arrow-right"}}</a></li>{{/if}}
    </ul>
  </div>
</section>
