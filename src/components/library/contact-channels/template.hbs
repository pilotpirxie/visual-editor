<section class="b-contact-channels section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-tiles" role="list">
      {{#each channels}}
      <li class="stack b-tile" data-field="channels.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <h3>{{title}}</h3>
        {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
        {{#if meta}}<p class="b-meta">{{svgIcon "clock"}}<span>{{meta}}</span></p>{{/if}}
        <a class="b-link" href="{{href link.link}}" {{linkAttrs link.link}}><span>{{link.label}}</span>{{svgIcon "arrow-right"}}</a>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
