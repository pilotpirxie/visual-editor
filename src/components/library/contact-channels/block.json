        {
          "name": "meta",
          "label": "Reply time",
          "type": "text",
          "default": ""
        },
        {
          "name": "link",
          "label": "Link",
          "type": "button",
          "default": {
            "label": "Write to us",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "ghost"
          }
        }
      ]
