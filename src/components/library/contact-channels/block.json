{
  "name": "Contact, channel tiles",
  "category": "contacts",
  "description": "Tiles for sales, support, press and partnerships, each with an icon, a reply time and a link.",
  "tags": ["contact", "channels", "tiles", "sales", "support", "press", "partners"],
  "fieldGroups": ["Heading", "Channels"],
