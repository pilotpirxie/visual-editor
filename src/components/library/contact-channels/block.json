      "group": "Heading"
    },
    {
      "name": "channels",
      "label": "Channels",
      "type": "list",
      "default": [
        {
          "icon": "briefcase",
          "title": "Sales",
          "text": "Plans, pilots, security reviews and procurement.",
          "meta": "Replies within 4 hours",
          "link": {
            "label": "Talk to sales",
            "link": {
              "type": "email",
              "url": "sales@fieldnote.example",
              "newTab": false
            },
            "variant": "ghost"
          }
        },
        {
          "icon": "support",
          "title": "Support",
          "text": "Help with recordings, transcripts and integrations.",
          "meta": "Replies within 1 hour",
          "link": {
            "label": "Open a ticket",
            "link": {
              "type": "email",
              "url": "support@fieldnote.example",
              "newTab": false
            },
            "variant": "ghost"
          }
        },
        {
          "icon": "mic",
          "title": "Press",
          "text": "Interviews, logos and our research reports.",
          "meta": "Replies within 1 day",
          "link": {
            "label": "Email press team",
            "link": {
              "type": "email",
              "url": "press@fieldnote.example",
              "newTab": false
            },
            "variant": "ghost"
          }
        },
        {
          "icon": "puzzle",
          "title": "Partners",
          "text": "Agencies, consultants and integration partners.",
          "meta": "Replies within 2 days",
          "link": {
            "label": "Become a partner",
            "link": {
              "type": "email",
              "url": "partners@fieldnote.example",
              "newTab": false
            },
            "variant": "ghost"
          }
        }
