<div class="b-modal-sheet" data-behavior="modal">
  <dialog class="b-sheet" id="{{block.id}}-dialog" aria-labelledby="{{block.id}}-title">
    <div class="b-handle" aria-hidden="true"></div>
    <button type="button" class="modal-close" command="close" commandfor="{{block.id}}-dialog" data-field="closeLabel">{{svgIcon "x"}}<span class="visually-hidden">{{closeLabel}}</span></button>
    <div class="stack b-body">
      <header class="stack b-head">
        <h2 id="{{block.id}}-title" data-field="title">{{title}}</h2>
        {{#if text}}<p class="b-muted" data-field="text">{{nl2br text}}</p>{{/if}}
      </header>
      <ul class="b-options" role="list">
        {{#each options}}
        <li data-field="options.{{@index}}">
          <a class="b-option" href="{{href link}}" {{linkAttrs link}}>
            <span class="b-icon">{{svgIcon icon}}</span>
            <span class="b-copy"><strong>{{title}}</strong>{{#if text}}<span class="b-muted">{{text}}</span>{{/if}}</span>
            {{svgIcon "chevron-right"}}
          </a>
        </li>
        {{/each}}
      </ul>
      {{#if cancelLabel}}<button type="button" class="btn btn-secondary" command="close" commandfor="{{block.id}}-dialog" data-field="cancelLabel">{{cancelLabel}}</button>{{/if}}
    </div>
  </dialog>
</div>
