<section class="b-pricing-tickets section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="grid b-tickets">
      {{#each tickets}}
      <article class="b-ticket" {{#if soldOut}}data-sold-out{{/if}} data-field="tickets.{{@index}}">
        <div class="stack b-stub">
          <div class="cluster b-ticket-head">
            <h3>{{name}}</h3>
            {{#if soldOut}}<p class="badge">{{../soldOutLabel}}</p>{{/if}}
          </div>
          <p class="b-amount">{{price}}</p>
          {{#if window}}<p class="b-window">{{svgIcon "calendar"}}<span>{{window}}</span></p>{{/if}}
        </div>
        <div class="stack b-body">
          <ul class="b-checks" role="list">
            {{#each features}}
            <li data-field="tickets.{{@../index}}.features.{{@index}}">{{svgIcon "check"}}<span>{{text}}</span></li>
            {{/each}}
          </ul>
          {{#if soldOut}}
          <button type="button" class="btn btn-secondary b-disabled" disabled>{{../soldOutLabel}}</button>
          {{else}}
          <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
          {{/if}}
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
