<section class="b-blog-zine section">
  <div class="container stack">
    <header class="stack b-head">
      {{#if issue}}<p class="b-issue" data-field="issue">{{issue}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-pages">
      {{#each posts}}
      <article class="stack b-page" data-field="posts.{{@index}}">
        <div class="media b-photo">{{img image}}</div>
        <h3 class="b-title"><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{title}}</a></h3>
        {{#if excerpt}}<p>{{nl2br excerpt}}</p>{{/if}}
        <p class="b-meta">
          {{#if author}}<span>{{author}}</span>{{/if}}
          {{#if date}}<time datetime="{{date}}">{{formatDate date}}</time>{{/if}}
        </p>
      </article>
      {{/each}}
    </div>
  </div>
</section>
