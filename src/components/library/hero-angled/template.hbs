<header class="b-hero-angled section">
  <div class="b-visual">
    {{#if showStripe}}<span class="b-stripe" aria-hidden="true" data-field="showStripe"></span>{{/if}}
    <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}" data-field="image">
      {{img image}}
    </div>
  </div>
  <div class="container b-inner">
    <div class="stack b-copy">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h1 data-field="title">{{title}}</h1>
      {{#if text}}<p class="b-lead" data-field="text">{{nl2br text}}</p>{{/if}}
      <div class="cluster b-actions">
        <a class="btn btn-{{primaryButton.variant}}" href="{{href primaryButton.link}}" {{linkAttrs primaryButton.link}} data-field="primaryButton">{{primaryButton.label}}{{svgIcon "arrow-right"}}</a>
        {{#if showSecondary}}
        <a class="btn btn-{{secondaryButton.variant}}" href="{{href secondaryButton.link}}" {{linkAttrs secondaryButton.link}} data-field="secondaryButton">{{secondaryButton.label}}</a>
        {{/if}}
      </div>
    </div>
  </div>
</header>
