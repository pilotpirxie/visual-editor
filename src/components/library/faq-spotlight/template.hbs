<section class="b-faq-spotlight section">
  <div class="container b-inner">
    <header class="b-panel">
      <h2 data-field="title">{{title}}</h2>
      <div class="stack b-aside">
        {{#if intro}}<p data-field="intro">{{nl2br intro}}</p>{{/if}}
        {{#if button.label}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}{{svgIcon "arrow-right"}}</a>{{/if}}
      </div>
    </header>
    <div class="b-list">
      {{#each items}}
      <details class="b-item" name="{{../block.id}}" data-field="items.{{@index}}" {{#if @first}}open{{/if}}>
        <summary class="b-question"><span>{{question}}</span><span class="b-icon">{{svgIcon "chevron-down"}}</span></summary>
        <div class="prose b-answer">{{richText answer}}</div>
      </details>
      {{/each}}
    </div>
  </div>
</section>
