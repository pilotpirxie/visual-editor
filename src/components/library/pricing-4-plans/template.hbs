<section class="b-pricing-4-plans section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-plans" style="--count: {{plans.length}}">
      {{#each plans}}
      <article class="stack b-plan" {{#if featured}}data-featured{{/if}} data-field="plans.{{@index}}">
        <div class="cluster b-plan-head">
          <h3>{{name}}</h3>
          {{#if featured}}{{#if ../featuredLabel}}<p class="badge">{{../featuredLabel}}</p>{{/if}}{{/if}}
        </div>
        <p class="b-price"><span class="b-amount">{{price}}</span> <span class="b-muted">{{period}}</span></p>
        {{#if description}}<p class="b-muted">{{nl2br description}}</p>{{/if}}
        <ul class="b-features" role="list">
          {{#each features}}
          <li data-field="plans.{{@../index}}.features.{{@index}}">{{svgIcon "check"}}<span>{{text}}</span></li>
          {{/each}}
        </ul>
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
      </article>
      {{/each}}
    </div>
  </div>
</section>
