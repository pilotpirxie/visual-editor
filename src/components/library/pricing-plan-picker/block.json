{
  "name": "Pricing, plan picker",
  "category": "pricing",
  "description": "Plans as a list of radio rows beside a summary panel that shows the chosen plan's price, features and button.",
  "tags": ["pricing", "plans", "picker", "radio", "summary", "subscription", "interactive"],
  "fieldGroups": ["Heading", "Plans"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Coffee by post",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Choose how much coffee lands on your doormat",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Northbound roasts on Mondays and posts on Tuesdays. Skip a box or cancel from your account whenever you like.",
      "group": "Heading"
    },
    {
      "name": "legend",
      "label": "Label for screen readers",
      "type": "text",
      "default": "Choose a plan",
      "required": true,
      "group": "Plans"
    },
    {
      "name": "plans",
      "label": "Plans",
      "type": "list",
      "group": "Plans",
      "minItems": 2,
      "maxItems": 6,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "name",
          "label": "Plan name",
          "type": "text",
          "default": "The Decaf"
        },
        {
          "name": "tagline",
          "label": "Line under the name",
          "type": "text",
          "default": "One bag, every four weeks"
        },
        {
          "name": "price",
          "label": "Price",
          "type": "text",
          "default": "$15"
        },
        {
          "name": "period",
          "label": "Period",
          "type": "text",
          "default": "per delivery"
        },
        {
          "name": "features",
          "label": "Included",
          "type": "richtext",
          "default": "<ul><li>One 250 g bag of decaf</li><li>Free delivery</li></ul>"
        },
        {
          "name": "button",
          "label": "Button",
          "type": "button",
          "default": {
            "label": "Start The Decaf",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "primary"
          }
        }
      ],
      "default": [
        {
          "name": "The Single",
          "tagline": "One bag, every two weeks",
          "price": "$14",
          "period": "per delivery",
          "features": "<ul><li>One 250 g bag, whole bean or ground</li><li>A different origin every time</li><li>Free delivery</li></ul>",
          "button": {
            "label": "Start The Single",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "primary"
          }
        },
        {
          "name": "The Double",
          "tagline": "Two bags, every two weeks",
          "price": "$25",
          "period": "per delivery",
          "features": "<ul><li>Two 250 g bags</li><li>One house roast and one guest roaster</li><li>A brew guide in every box</li><li>Free delivery</li></ul>",
          "button": {
            "label": "Start The Double",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "primary"
          }
        },
        {
          "name": "The Office",
          "tagline": "A kilo, every week",
          "price": "$52",
          "period": "per week",
          "features": "<ul><li>1 kg ground for your machine</li><li>Weekly or every two weeks</li><li>One invoice a month</li><li>A grinder on loan for free</li></ul>",
          "button": {
            "label": "Start The Office",
            "link": {
              "type": "url",
              "url": "#",
              "newTab": false
            },
            "variant": "primary"
          }
        }
      ]
    }
  ]
}
