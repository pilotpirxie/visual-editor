{
  "name": "Navigation, masthead",
  "category": "navigations",
  "description": "A newspaper-style masthead with a date line and subscribe button, over a row of section links that scrolls sideways on phones.",
  "tags": [
    "menu",
    "navbar",
    "header",
    "magazine",
    "newsletter",
    "news",
    "blog",
    "masthead",
    "editorial",
    "categories"
  ],
  "fieldGroups": ["Masthead", "Sections", "Button"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "dateline",
      "label": "Date line",
      "type": "text",
      "default": "Issue 214 · Independent reporting on cities and climate",
      "maxLength": 80,
      "group": "Masthead"
    },
    {
      "name": "sections",
      "label": "Section links",
      "type": "list",
      "group": "Sections",
      "minItems": 1,
      "maxItems": 12,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Section"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Cities",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Climate",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Housing",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Transport",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Food",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Culture",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Opinion",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Podcast",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Subscribe",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    }
  ]
}
