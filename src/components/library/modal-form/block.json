{
  "name": "Modal, dialog with form",
  "category": "modals",
  "description": "A dialog with a short pitch and an email form. Opens from any link to its anchor.",
  "tags": ["modal", "dialog", "popup", "form", "email", "waitlist", "signup"],
  "fieldGroups": ["Content", "Form"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Get early access",
      "required": true,
      "group": "Content"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Join 2,400 research teams on the waitlist. We invite a new group every Monday.",
      "group": "Content"
    },
    {
      "name": "closeLabel",
      "label": "Close button label (for screen readers)",
      "type": "text",
      "default": "Close",
      "required": true,
      "group": "Content"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "required": true,
      "group": "Form"
    },
    {
      "name": "emailPlaceholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "you@company.com",
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Join the waitlist",
      "required": true,
      "group": "Form"
    },
    {
      "name": "note",
      "label": "Privacy note",
      "type": "text",
      "default": "No spam. One email when your invite is ready.",
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    }
  ]
}
