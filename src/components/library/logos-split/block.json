{
  "name": "Logo cloud, heading beside logos",
  "category": "logo-clouds",
  "description": "A heading, text and link beside a large grid of logos split by thin lines.",
  "tags": ["logos", "customers", "trusted by", "brands", "social proof", "split", "b2b"],
  "fieldGroups": ["Heading", "Logos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Customers",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "The research behind products you use every day",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "From two-person startups to public companies, teams use Fieldnote to turn customer calls into decisions.",
      "group": "Heading"
    },
    {
      "name": "linkLabel",
      "label": "Link text",
      "type": "text",
      "default": "Read customer stories",
      "group": "Heading"
    },
    {
      "name": "link",
      "label": "Link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Heading"
    },
    {
