<section class="b-logos-split section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
      {{#if linkLabel}}<a class="b-link" href="{{href link}}" {{linkAttrs link}} data-field="linkLabel">{{linkLabel}}{{svgIcon "arrow-right"}}</a>{{/if}}
    </header>
    <ul class="b-logos" role="list">
      {{#each logos}}
      <li class="b-logo" data-field="logos.{{@index}}">{{img image}}</li>
      {{/each}}
    </ul>
  </div>
</section>
