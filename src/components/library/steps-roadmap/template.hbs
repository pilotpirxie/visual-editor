<section class="b-steps-roadmap section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-phases" role="list">
      {{#each phases}}
      <li class="stack b-phase" data-field="phases.{{@index}}">
        {{#if duration}}<p><span class="badge">{{duration}}</span></p>{{/if}}
        <h3>{{title}}</h3>
        <p class="b-text">{{nl2br text}}</p>
      </li>
      {{/each}}
    </ol>
    <div class="cluster b-summary">
      {{#if total}}<p class="b-total" data-field="total">{{svgIcon "clock"}}{{total}}</p>{{/if}}
      <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
    </div>
  </div>
</section>
