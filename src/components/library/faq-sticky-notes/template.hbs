<section class="b-faq-sticky-notes section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-board" role="list">
      {{#each items}}
      <li class="b-slot" data-field="items.{{@index}}">
        <details class="b-note" {{#if @first}}open{{/if}}>
          <summary class="b-question"><span>{{question}}</span><span class="b-peel">{{svgIcon "plus"}}</span></summary>
          <p class="b-answer">{{nl2br answer}}</p>
        </details>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
