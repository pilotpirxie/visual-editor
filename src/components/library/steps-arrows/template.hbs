<section class="b-steps-arrows section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-steps" role="list">
      {{#each steps}}
      <li class="stack b-step" data-field="steps.{{@index}}">
        <span class="b-tile">{{svgIcon icon}}</span>
        <h3>{{title}}</h3>
        <p>{{nl2br text}}</p>
        {{#unless @last}}<span class="b-arrow">{{svgIcon "arrow-right"}}</span>{{/unless}}
      </li>
      {{/each}}
    </ol>
    {{#if showButton}}
    <div class="cluster b-actions">
      <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
    </div>
    {{/if}}
  </div>
</section>
