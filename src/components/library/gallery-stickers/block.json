{
  "name": "Gallery, stickers",
  "category": "gallery",
  "description": "Photos cut into round and blob shapes with a thick edge, like die-cut stickers, each with a small name label.",
  "tags": ["gallery", "photos", "stickers", "blobs", "round", "playful", "labels"],
  "fieldGroups": ["Heading", "Stickers"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "In the cabinet this week",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Six flavours, churned before you were awake",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Giro makes every tub in the back room on Leith Walk each morning. When one is empty, it is gone until next week.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Stickers",
      "type": "list",
      "group": "Stickers",
      "minItems": 2,
      "maxItems": 8,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
