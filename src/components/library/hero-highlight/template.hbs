<header class="b-hero-highlight section">
  <div class="container stack b-inner">
    {{#if eyebrow}}<p class="badge" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
    <h1 class="b-title"><span data-field="titleStart">{{titleStart}}</span>{{#if highlight}} <span class="b-mark" data-field="highlight">{{highlight}}</span>{{/if}}{{#if titleEnd}} <span data-field="titleEnd">{{titleEnd}}</span>{{/if}}</h1>
    {{#if text}}<p class="b-lead" data-field="text">{{nl2br text}}</p>{{/if}}
    <div class="cluster b-actions">
      <a class="btn btn-{{primaryButton.variant}} b-button" href="{{href primaryButton.link}}" {{linkAttrs primaryButton.link}} data-field="primaryButton">{{primaryButton.label}}{{svgIcon "arrow-right"}}</a>
      {{#if showSecondary}}
      <a class="btn btn-{{secondaryButton.variant}} b-button" href="{{href secondaryButton.link}}" {{linkAttrs secondaryButton.link}} data-field="secondaryButton">{{secondaryButton.label}}</a>
      {{/if}}
    </div>
    <div class="b-proof">
      {{#if avatars.length}}
      <ul class="b-avatars" role="list">
        {{#each avatars}}
        <li class="media b-avatar" data-field="avatars.{{@index}}">{{img photo}}</li>
        {{/each}}
      </ul>
      {{/if}}
      <div class="b-proof-copy">
        {{#if showStars}}
        <p class="b-rating" data-field="rating">
          <span class="b-stars" aria-hidden="true">{{svgIcon "star"}}{{svgIcon "star"}}{{svgIcon "star"}}{{svgIcon "star"}}{{svgIcon "star"}}</span>
          {{#if rating}}<span>{{rating}}</span>{{/if}}
        </p>
        {{/if}}
        {{#if proof}}<p class="b-proof-text" data-field="proof">{{proof}}</p>{{/if}}
      </div>
    </div>
  </div>
</header>
