<section class="b-gallery-polaroids section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-wall" role="list">
      {{#each items}}
      <li class="b-item" data-field="items.{{@index}}">
        <figure class="b-polaroid">
          <div class="media b-photo" style="--media-ratio: {{image.width}} / {{image.height}}">{{img image}}</div>
          {{#if (or caption date)}}
          <figcaption class="b-caption">
            {{#if caption}}<span>{{caption}}</span>{{/if}}
            {{#if date}}<span class="b-date">{{date}}</span>{{/if}}
          </figcaption>
          {{/if}}
        </figure>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
