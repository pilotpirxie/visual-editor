{
  "name": "Content, offset image pair",
  "category": "content",
  "description": "Text beside two staggered photos with numbered captions.",
  "tags": ["images", "photos", "pair", "staggered", "captions", "about", "editorial"],
  "fieldGroups": ["Content", "Photos", "Button"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Inside the studio",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Where the listening happens",
      "group": "Content",
      "required": true,
      "maxLength": 140
    },
    {
      "name": "body",
      "label": "Text",
      "type": "richtext",
      "default": "<p>Our Toronto studio has two soundproof rooms, one long table and a wall of sticky notes that never quite comes down.</p><p>Customers join us in person every Thursday. Everyone else joins on video, and the clips are tagged before the coffee goes cold.</p>",
      "group": "Content"
    },
    {
      "name": "first",
      "label": "First photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "A researcher taking notes during a customer interview",
        "decorative": false,
        "width": 900,
        "height": 1200,
        "placeholder": {
          "ratio": "3:4",
          "subject": "photo"
        }
      },
      "group": "Photos"
    },
    {
      "name": "firstCaption",
      "label": "First caption",
      "type": "text",
      "default": "Thursday interviews in the quiet room",
      "group": "Photos"
    },
    {
      "name": "second",
      "label": "Second photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "Sticky notes grouped into themes on a studio wall",
        "decorative": false,
        "width": 900,
        "height": 1200,
        "placeholder": {
          "ratio": "3:4",
          "subject": "photo"
        }
      },
      "group": "Photos"
    },
    {
      "name": "secondCaption",
      "label": "Second caption",
      "type": "text",
      "default": "The theme wall, week three",
      "group": "Photos"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Book a studio visit",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Button",
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      }
    }
  ]
}
