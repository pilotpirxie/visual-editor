<section class="b-stats-before-after section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <table class="b-table">
      <thead>
        <tr>
          <th scope="col" data-field="metricHeading">{{metricHeading}}</th>
          <th scope="col" data-field="beforeHeading">{{beforeHeading}}</th>
          <th scope="col" data-field="afterHeading">{{afterHeading}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr data-field="rows.{{@index}}">
          <th scope="row">{{label}}</th>
          <td class="b-before">{{before}}</td>
          <td class="b-after"><span class="b-change">{{svgIcon "arrow-right"}}{{after}}</span></td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
