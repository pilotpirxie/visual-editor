{
  "name": "Blog posts, with author avatars",
  "category": "blog",
  "description": "Post cards with an image, excerpt and a byline showing the author’s photo and reading time.",
  "tags": ["blog", "posts", "articles", "authors", "byline", "avatars", "cards"],
  "fieldGroups": ["Heading", "Button", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "From the team",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Written by people who run interviews every week",
      "group": "Heading",
      "required": true
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Meet our writers",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 1,
      "maxItems": 9,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Image",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Cover image",
            "decorative": false,
            "width": 1200,
            "height": 800,
            "placeholder": {
              "ratio": "3:2",
              "subject": "photo"
            }
          }
        },
        {
          "name": "category",
          "label": "Category",
          "type": "text",
          "default": "Research"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Post title"
        },
        {
          "name": "excerpt",
          "label": "Excerpt",
          "type": "textarea",
          "default": "One or two sentences that make readers want the rest."
        },
        {
          "name": "authorPhoto",
          "label": "Author photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Author portrait",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "name": "author",
          "label": "Author",
          "type": "text",
          "default": "Author name"
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
        },
        {
          "name": "readTime",
          "label": "Reading time",
          "type": "text",
          "default": "5 min read"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
