<header class="b-hero-calendar section">
  <div class="container b-inner">
    <div class="stack b-copy">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h1 data-field="title">{{title}}</h1>
      {{#if text}}<p class="b-lead" data-field="text">{{nl2br text}}</p>{{/if}}
      <div class="cluster">
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      </div>
    </div>
    <div class="card stack b-booking">
      <div class="b-host">
        <div class="media b-photo" data-field="photo">{{img photo}}</div>
        <p><strong data-field="name">{{name}}</strong><span data-field="session">{{svgIcon "video"}} {{session}}</span></p>
      </div>
      <p class="b-month" data-field="month">{{month}}</p>
      <ul class="b-days" role="list">
        {{#each days}}
        <li class="b-day" {{#if selected}}data-selected{{/if}} {{#unless available}}data-full{{/unless}} data-field="days.{{@index}}"><span>{{weekday}}</span><strong>{{date}}</strong></li>
        {{/each}}
      </ul>
      <p class="b-slots-title" data-field="slotsTitle">{{slotsTitle}}</p>
      <ul class="b-slots" role="list">
        {{#each slots}}
        <li data-field="slots.{{@index}}"><a class="b-slot" href="{{href link}}" {{linkAttrs link}}>{{label}}</a></li>
        {{/each}}
      </ul>
    </div>
  </div>
</header>
