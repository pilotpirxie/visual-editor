{
  "name": "Logo cloud, logo cards",
  "category": "logo-clouds",
  "description": "Customer logos in cards, each with a one-line result and a link to the full story.",
  "tags": ["logos", "customers", "case studies", "results", "stories", "cards", "social proof"],
  "fieldGroups": ["Heading", "Customers"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
