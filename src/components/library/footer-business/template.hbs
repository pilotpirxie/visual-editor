<footer class="b-footer-business section">
  <div class="container stack b-inner">
    <div class="b-top">
      <div class="stack b-brand">
        <a class="b-logo" href="index.html">{{site.title}}</a>
        {{#if tagline}}<p class="b-muted" data-field="tagline">{{nl2br tagline}}</p>{{/if}}
        {{#if socials.length}}
        <ul class="cluster b-socials" role="list">
          {{#each socials}}
          <li><a href="{{href link}}" {{linkAttrs link}} data-field="socials.{{@index}}">{{svgIcon icon}}<span class="visually-hidden">{{label}}</span></a></li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
      {{#if columns.length}}
      <nav class="b-columns" aria-label="Footer">
        {{#each columns}}
        <div class="stack b-column" data-field="columns.{{@index}}">
          <h2 class="b-heading">{{title}}</h2>
          <ul class="b-links" role="list">
            {{#each links}}
            <li><a href="{{href link}}" {{linkAttrs link}} data-field="columns.{{@../index}}.links.{{@index}}">{{label}}</a></li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </nav>
      {{/if}}
      <div class="stack b-column b-contact">
        <h2 class="b-heading" data-field="contactTitle">{{contactTitle}}</h2>
        <ul class="b-details" role="list">
          {{#each contacts}}
          <li><a href="{{href link}}" {{linkAttrs link}} data-field="contacts.{{@index}}">{{svgIcon icon}}<span>{{text}}</span></a></li>
          {{/each}}
        </ul>
        {{#if hours.length}}
        <dl class="b-hours">
          {{#each hours}}
          <div class="b-row" data-field="hours.{{@index}}"><dt>{{days}}</dt><dd>{{time}}</dd></div>
          {{/each}}
        </dl>
        {{/if}}
      </div>
    </div>
    <div class="b-bottom">
      <p class="b-muted" data-field="copyright">{{copyright}}</p>
      <ul class="cluster b-legal" role="list">
        {{#each legalLinks}}
        <li><a href="{{href link}}" {{linkAttrs link}} data-field="legalLinks.{{@index}}">{{label}}</a></li>
        {{/each}}
      </ul>
    </div>
  </div>
</footer>
