<section class="b-testimonials-featured section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <div class="b-layout">
      <figure class="card stack b-featured">
        <span class="b-mark">{{svgIcon "quote"}}</span>
        <blockquote class="b-quote" data-field="quote"><p>{{nl2br quote}}</p></blockquote>
        <figcaption class="b-person">
          <div class="media b-photo" data-field="photo">{{img photo}}</div>
          <div>
            <p class="b-name" data-field="name">{{name}}</p>
            {{#if role}}<p class="b-role" data-field="role">{{role}}</p>{{/if}}
          </div>
        </figcaption>
      </figure>
      <div class="stack b-side">
        {{#each items}}
        <figure class="card stack b-card" data-field="items.{{@index}}">
          <blockquote><p>{{nl2br quote}}</p></blockquote>
          <figcaption class="b-person">
            <div class="media b-photo">{{img photo}}</div>
            <div>
              <p class="b-name">{{name}}</p>
              {{#if role}}<p class="b-role">{{role}}</p>{{/if}}
            </div>
          </figcaption>
        </figure>
        {{/each}}
      </div>
    </div>
  </div>
</section>
