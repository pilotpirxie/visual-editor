<section class="b-blog-carousel section" data-behavior="carousel">
  <div class="container stack b-inner">
    <div class="b-head">
      <header class="stack b-heading">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
      </header>
      {{#if showButton}}
      <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      {{/if}}
    </div>
    <div class="b-track" data-carousel-track role="region" aria-label="{{title}}" tabindex="0">
      {{#each posts}}
      <article class="card stack b-slide" data-carousel-slide data-field="posts.{{@index}}">
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}">{{img image}}</div>
        <div class="stack b-body">
          {{#if category}}<p class="badge">{{category}}</p>{{/if}}
          <h3 class="b-title"><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{title}}</a></h3>
          {{#if (or author date)}}
          <p class="b-meta">
            {{#if author}}<span class="b-author">{{author}}</span>{{/if}}
            {{#if date}}<time datetime="{{date}}">{{formatDate date}}</time>{{/if}}
          </p>
          {{/if}}
        </div>
      </article>
      {{/each}}
    </div>
    <div class="b-controls" data-carousel-controls hidden>
      <button type="button" class="btn btn-secondary b-arrow" data-carousel-previous>{{svgIcon "arrow-left"}}<span class="visually-hidden">Previous post</span></button>
      <div class="b-dots" data-carousel-dots="Post"></div>
      <button type="button" class="btn btn-secondary b-arrow" data-carousel-next>{{svgIcon "arrow-right"}}<span class="visually-hidden">Next post</span></button>
    </div>
  </div>
</section>
