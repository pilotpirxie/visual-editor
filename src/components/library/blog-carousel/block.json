{
  "name": "Blog posts, carousel",
  "category": "blog",
  "description": "A row of post cards that scrolls sideways, with previous and next buttons.",
  "tags": ["blog", "posts", "articles", "carousel", "slider", "scroll", "cards"],
  "fieldGroups": ["Heading", "Button", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Keep reading",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "More from the Fieldnote blog",
      "group": "Heading",
      "required": true
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "All posts",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 2,
      "maxItems": 12,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Image",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Cover image",
            "decorative": false,
            "width": 1200,
            "height": 800,
            "placeholder": {
              "ratio": "3:2",
              "subject": "photo"
            }
          }
        },
        {
          "name": "category",
          "label": "Category",
          "type": "text",
          "default": "Research"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Post title"
        },
        {
          "name": "author",
