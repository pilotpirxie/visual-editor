<aside class="b-banner-referral" aria-label="Referral offer">
  <div class="container b-bar">
    <span class="b-stamp" data-field="icon">{{svgIcon icon}}</span>
    <p class="b-text"><strong data-field="title">{{title}}</strong> <span data-field="text">{{text}}</span></p>
    <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
  </div>
</aside>
