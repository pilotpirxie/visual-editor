{
  "name": "Logo cloud, scrolling row",
  "category": "logo-clouds",
  "description": "A long row of customer logos that scrolls sideways with previous and next buttons.",
  "tags": ["logos", "customers", "carousel", "slider", "scroll", "brands", "social proof"],
  "fieldGroups": ["Heading", "Logos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
