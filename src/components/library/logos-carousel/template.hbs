<section class="b-logos-carousel section" data-behavior="carousel">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-track" data-carousel-track role="region" aria-label="{{title}}" tabindex="0">
      <ul class="b-logos" role="list">
        {{#each logos}}
        <li class="b-logo" data-carousel-slide data-field="logos.{{@index}}">{{img image}}</li>
        {{/each}}
      </ul>
    </div>
    <div class="b-controls" data-carousel-controls hidden>
      <div class="b-dots" data-carousel-dots="Logo"></div>
      <button type="button" class="btn btn-secondary b-arrow" data-carousel-previous>{{svgIcon "arrow-left"}}<span class="visually-hidden">Previous logos</span></button>
      <button type="button" class="btn btn-secondary b-arrow" data-carousel-next>{{svgIcon "arrow-right"}}<span class="visually-hidden">Next logos</span></button>
    </div>
  </div>
</section>
