{
  "name": "Testimonials, grid of cards",
  "category": "testimonials",
  "description": "A heading and a grid of short customer quotes with photos.",
  "tags": ["testimonials", "quotes", "reviews", "customers", "grid"],
  "fieldGroups": ["Heading", "Quotes"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Customers",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Product teams hear their customers more clearly",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Quotes",
      "type": "list",
      "group": "Quotes",
      "minItems": 1,
      "maxItems": 9,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "textarea",
          "default": "What the customer said."
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Name"
        },
        {
          "name": "role",
          "label": "Role and company",
          "type": "text",
          "default": "Role, Company"
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        }
      ],
      "default": [
