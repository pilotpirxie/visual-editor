<section class="b-steps-pulse section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-steps" role="list">
      {{#each steps}}
      <li class="b-step" data-field="steps.{{@index}}">
        <div>
          <h3>{{title}}</h3>
          <p class="b-text">{{nl2br text}}</p>
        </div>
      </li>
      {{/each}}
    </ol>
    {{#if showButton}}<p class="cluster"><a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a></p>{{/if}}
  </div>
</section>
