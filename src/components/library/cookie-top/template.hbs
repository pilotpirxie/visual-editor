<aside class="b-cookie-top" data-behavior="consent" aria-label="Cookie consent">
  <dialog class="b-panel" data-theme="{{theme}}">
    <div class="container b-inner">
      <p class="b-text">{{#if icon}}<span class="b-icon" data-field="icon">{{svgIcon icon}}</span>{{/if}}<span data-field="text">{{text}}</span>{{#if showPolicyLink}} <a href="{{href policyLink}}" {{linkAttrs policyLink}} data-field="policyLink">{{policyLabel}}</a>{{/if}}</p>
      <div class="cluster b-actions">
        {{#if showDecline}}<button type="button" class="btn btn-ghost" data-consent="declined" data-field="declineLabel">{{declineLabel}}</button>{{/if}}
        <button type="button" class="btn btn-primary" data-consent="accepted" data-field="acceptLabel">{{acceptLabel}}</button>
      </div>
    </div>
  </dialog>
</aside>
