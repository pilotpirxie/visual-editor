<section class="b-cta-minimal section" data-align="{{align}}">
  <div class="container b-inner">
    <h2 class="b-title" data-field="title">{{title}}</h2>
    <a class="b-link" href="{{href link}}" {{linkAttrs link}} data-field="link"><span data-field="linkLabel">{{linkLabel}}</span>{{svgIcon "arrow-right"}}</a>
  </div>
</section>
