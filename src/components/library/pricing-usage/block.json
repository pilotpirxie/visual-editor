{
  "name": "Pricing, usage based",
  "category": "pricing",
  "description": "A table of volume tiers with a worked example of what a typical month costs.",
  "tags": ["pricing", "usage", "volume", "pay as you go", "metered", "api", "table", "tiers"],
  "fieldGroups": ["Heading", "Tiers", "Example"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
