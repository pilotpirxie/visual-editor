<section class="b-pricing-membership section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="grid b-tiers">
      {{#each tiers}}
      <article class="card b-tier" {{#if featured}}data-featured{{/if}} data-field="tiers.{{@index}}">
        <div class="media b-photo" style="--media-ratio: {{image.width}} / {{image.height}}">
          {{img image}}
          {{#if featured}}{{#if ../featuredLabel}}<p class="badge b-badge">{{../featuredLabel}}</p>{{/if}}{{/if}}
        </div>
        <div class="stack b-body">
          <h3>{{name}}</h3>
          <p><span class="b-amount">{{price}}</span> <span class="b-muted">{{period}}</span></p>
          {{#if description}}<p class="b-muted">{{nl2br description}}</p>{{/if}}
          <ul class="b-checks" role="list">
            {{#each features}}
            <li data-field="tiers.{{@../index}}.features.{{@index}}">{{svgIcon "check"}}<span>{{text}}</span></li>
            {{/each}}
          </ul>
          <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
