{
  "name": "Gallery, bento",
  "category": "gallery",
  "description": "Photos in a bento grid of large, wide, tall and small tiles, with titles over the images.",
  "tags": ["gallery", "photos", "images", "bento", "grid", "mosaic", "portfolio"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Research week",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Five customers, five days, one van",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Our product team visited customers across Ontario. Each tile is one stop.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 2,
      "maxItems": 16,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          }
        },
        {
          "name": "size",
          "label": "Tile size",
          "type": "select",
          "default": "small",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "wide",
              "label": "Wide"
            },
            {
              "value": "tall",
              "label": "Tall"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": ""
        },
        {
          "name": "text",
          "label": "Text",
