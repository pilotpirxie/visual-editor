<section class="b-gallery-bento section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-grid">
      {{#each items}}
      <figure class="b-tile" data-size="{{size}}" data-field="items.{{@index}}">
        <div class="media b-media">{{img image}}</div>
        {{#if (or title text)}}
        <figcaption class="b-caption">
          {{#if title}}<span class="b-title">{{title}}</span>{{/if}}
          {{#if text}}<span class="b-text">{{text}}</span>{{/if}}
        </figcaption>
        {{/if}}
      </figure>
      {{/each}}
    </div>
  </div>
</section>
