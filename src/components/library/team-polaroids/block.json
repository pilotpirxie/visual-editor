{
  "name": "Team, photo wall",
  "category": "team",
  "description": "Tilted instant photos of the team taped to a dotted wall, each with a name, role and a short note.",
  "tags": ["team", "people", "polaroid", "photos", "playful", "culture", "about"],
  "fieldGroups": ["Heading", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Around the office",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "The faces behind your transcripts",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Most of us work from our studio on King Street West in Toronto. The rest join from wherever the coffee is good.",
      "group": "Heading"
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 12,
      "itemLabel": "name",
      "itemFields": [
