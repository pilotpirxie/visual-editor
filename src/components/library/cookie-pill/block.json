{
  "name": "Cookies, compact pill",
  "category": "cookies",
  "description": "A small rounded consent pill at the bottom center of the screen, with one line of text and two buttons.",
  "tags": ["cookies", "consent", "privacy", "gdpr", "pill", "toast", "minimal"],
  "fieldGroups": ["Message", "Buttons"],
  "styleOverrides": ["--color-background", "--color-text", "--color-primary"],
  "fields": [
    {
      "name": "text",
      "label": "Text",
      "type": "text",
      "default": "We use cookies to improve Fieldnote.",
      "required": true,
      "maxLength": 120,
      "group": "Message"
    },
    {
      "name": "showPolicyLink",
      "label": "Show policy link",
      "type": "boolean",
      "default": true,
      "group": "Message"
    },
    {
      "name": "policyLabel",
      "label": "Policy link label",
      "type": "text",
      "default": "Details",
      "visibleWhen": {
        "field": "showPolicyLink",
        "equals": true
      },
      "group": "Message"
    },
    {
      "name": "policyLink",
      "label": "Policy link",
      "type": "link",
      "default": {
        "type": "page",
        "newTab": false
      },
      "visibleWhen": {
        "field": "showPolicyLink",
        "equals": true
      },
      "group": "Message"
    },
    {
      "name": "acceptLabel",
      "label": "Accept button",
      "type": "text",
      "default": "OK",
      "required": true,
      "group": "Buttons"
    },
    {
      "name": "showDecline",
      "label": "Show decline button",
      "type": "boolean",
      "default": true,
      "group": "Buttons"
    },
    {
      "name": "declineLabel",
      "label": "Decline button",
      "type": "text",
      "default": "No thanks",
      "visibleWhen": {
        "field": "showDecline",
        "equals": true
      },
      "group": "Buttons"
    }
  ]
}
