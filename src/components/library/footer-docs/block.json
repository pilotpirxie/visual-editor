{
  "name": "Footer, developer docs",
  "category": "footers",
  "description": "Docs and community links with the API version, a live status link and developer social links.",
  "tags": ["footer", "docs", "developer", "api", "status", "version", "github"],
  "fieldGroups": ["Brand", "Status", "Columns", "Social", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "version",
      "label": "Version",
      "type": "text",
      "default": "API v3.2",
      "group": "Brand"
    },
    {
      "name": "tagline",
      "label": "Tagline",
      "type": "textarea",
      "default": "Build on Fieldnote: import recordings, sync tags and pull highlights into your own tools.",
      "group": "Brand"
    },
    {
      "name": "statusLabel",
      "label": "Status label",
      "type": "text",
      "default": "All systems operational",
      "group": "Status"
    },
    {
      "name": "statusLink",
      "label": "Status link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Status"
    },
    {
      "name": "columns",
      "label": "Link columns",
      "type": "list",
      "group": "Columns",
      "minItems": 1,
      "maxItems": 4,
      "itemLabel": "title",
