{
  "name": "Contact, centered form",
  "category": "contacts",
  "description": "A centered heading over a form card with name, email, company and message.",
  "tags": ["contact", "form", "message", "centered", "sales", "support"],
  "fieldGroups": ["Heading", "Form"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Contact",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Tell us what you are trying to learn",
      "group": "Heading",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Share a little about your team and your research. A product specialist will reply within one business day.",
      "group": "Heading"
    },
    {
      "name": "nameLabel",
      "label": "Name field label",
      "type": "text",
      "default": "Your name",
      "group": "Form",
      "required": true
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "group": "Form",
      "required": true
    },
    {
      "name": "companyLabel",
      "label": "Company field label",
      "type": "text",
      "default": "Company (optional)",
      "group": "Form",
      "required": true
    },
    {
      "name": "messageLabel",
      "label": "Message field label",
      "type": "text",
      "default": "What would you like to know?",
      "group": "Form",
      "required": true
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Send message",
      "group": "Form",
      "required": true
    },
    {
      "name": "note",
      "label": "Note under the form",
      "type": "text",
      "default": "We only use your details to reply. No newsletters unless you ask.",
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "group": "Form",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ]
    }
  ]
}
