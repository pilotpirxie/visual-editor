{
  "name": "Testimonials, moving wall",
  "category": "testimonials",
  "description": "Two rows of quote cards that drift in opposite directions in an endless loop and pause under the pointer or keyboard focus. Visitors who prefer reduced motion get a still wall of cards.",
  "tags": [
    "testimonials",
    "quotes",
    "marquee",
    "animated",
    "moving",
    "scrolling",
    "loop",
    "wall",
    "social proof"
  ],
  "fieldGroups": ["Heading", "Quotes", "Motion"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Wall of love",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "What research teams say after their first month",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Unedited notes from people who run customer interviews every week.",
      "group": "Heading"
    },
    {
      "name": "topRow",
      "label": "Top row",
      "type": "list",
      "group": "Quotes",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "textarea",
          "default": "A short quote from a happy customer.",
          "required": true,
          "maxLength": 220
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Customer name"
        },
        {
          "name": "role",
          "label": "Role and company",
          "type": "text",
          "default": "Role, Company"
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
