{
  "name": "HTTP code, 500 or maintenance",
  "category": "http-codes",
  "description": "The main content of a server error or maintenance page, with an optional status link.",
  "tags": ["500", "error", "maintenance", "down", "outage", "status"],
  "fieldGroups": ["Content", "Button"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "icon",
      "label": "Icon",
      "type": "icon",
      "default": "hourglass",
      "group": "Content"
    },
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Scheduled maintenance",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "We’ll be back shortly",
      "required": true,
      "group": "Content"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "We’re upgrading our servers to make Fieldnote faster. Your projects and notes are safe, and we expect to be back by 14:00 UTC.",
      "group": "Content"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Check the status page",
        "link": {
          "type": "url",
          "url": "https://status.fieldnote.app",
          "newTab": true
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    }
  ]
}
