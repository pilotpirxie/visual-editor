{
  "name": "Team, cards with social links",
  "category": "team",
  "description": "A heading and cards with a photo, name, role, short bio and social links.",
  "tags": ["team", "people", "about", "leadership", "bio", "social"],
  "fieldGroups": ["Heading", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Leadership",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Meet the people building Fieldnote",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Fieldnote started in 2022 as a side project to search three years of interview recordings. It is now a team of 28.",
      "group": "Heading"
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 12,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Name"
        },
        {
          "name": "role",
          "label": "Role",
          "type": "text",
          "default": "Role"
        },
        {
          "name": "bio",
          "label": "Bio",
          "type": "textarea",
          "maxLength": 200,
          "default": "One or two sentences about what this person does."
        },
        {
          "name": "socials",
          "label": "Social links",
          "type": "list",
          "minItems": 0,
          "maxItems": 4,
          "itemLabel": "label",
          "itemFields": [
            {
              "name": "label",
              "label": "Name",
              "type": "text",
              "default": "LinkedIn"
            },
            {
              "name": "icon",
              "label": "Icon",
              "type": "icon",
              "default": "simple-icons:linkedin",
              "iconPurpose": "brand"
            },
            {
              "name": "link",
              "label": "Link",
              "type": "link",
              "default": {
                "type": "url",
                "url": "https://www.linkedin.com",
                "newTab": true
              }
            }
          ],
          "default": []
        }
      ],
      "default": [
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Leila Haddad",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          },
          "name": "Leila Haddad",
          "role": "Co-founder and CEO",
          "bio": "Led research teams for eight years and re-watched too many calls to find one quote. Started Fieldnote to fix that.",
          "socials": [
            {
              "label": "LinkedIn",
              "icon": "simple-icons:linkedin",
              "link": {
                "type": "url",
                "url": "https://www.linkedin.com",
                "newTab": true
              }
            },
            {
              "label": "X",
              "icon": "simple-icons:x",
              "link": {
                "type": "url",
                "url": "https://x.com",
                "newTab": true
              }
            }
          ]
        },
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Mateo Ruiz",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          },
          "name": "Mateo Ruiz",
          "role": "Co-founder and CTO",
          "bio": "Built speech recognition for call centers before Fieldnote. Makes sure transcripts arrive before the call notes do.",
          "socials": [
            {
              "label": "LinkedIn",
              "icon": "simple-icons:linkedin",
              "link": {
                "type": "url",
                "url": "https://www.linkedin.com",
                "newTab": true
              }
            },
            {
              "label": "GitHub",
              "icon": "simple-icons:github",
              "link": {
                "type": "url",
                "url": "https://github.com",
                "newTab": true
              }
            }
          ]
        },
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Ingrid Solberg",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          },
          "name": "Ingrid Solberg",
          "role": "Head of research",
          "bio": "Has run more than 900 customer interviews and writes the guides our customers use to run theirs.",
          "socials": [
            {
              "label": "LinkedIn",
              "icon": "simple-icons:linkedin",
              "link": {
                "type": "url",
                "url": "https://www.linkedin.com",
                "newTab": true
              }
            },
            {
              "label": "Bluesky",
              "icon": "simple-icons:bluesky",
              "link": {
                "type": "url",
                "url": "https://bsky.app",
                "newTab": true
              }
            }
          ]
        }
      ]
    }
  ]
}
