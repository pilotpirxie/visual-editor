<section class="b-careers-list section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    {{#if positions.length}}
    <ul class="stack b-positions" role="list">
      {{#each positions}}
      <li class="b-position" data-field="positions.{{@index}}">
        <div class="b-main">
          <h3 class="b-title"><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{title}}</a></h3>
          {{#if team}}<p class="b-team">{{team}}</p>{{/if}}
        </div>
        {{#if (or location type)}}
        <ul class="b-meta" role="list">
          {{#if location}}<li>{{svgIcon "map-pin"}}<span>{{location}}</span></li>{{/if}}
          {{#if type}}<li>{{svgIcon "clock"}}<span>{{type}}</span></li>{{/if}}
        </ul>
        {{/if}}
        <span class="b-arrow">{{svgIcon "arrow-right"}}</span>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="b-empty" data-field="emptyText">{{svgIcon "briefcase"}}<span>{{emptyText}}</span></p>
    {{/if}}
  </div>
</section>
