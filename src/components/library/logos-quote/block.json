            "source": "placeholder",
            "src": "",
            "alt": "Company logo",
            "decorative": false,
            "width": 1200,
            "height": 514,
            "placeholder": {
              "ratio": "21:9",
              "subject": "logo"
            }
          }
        },
        {
          "name": "featured",
          "label": "Highlight this logo",
          "type": "boolean",
          "default": false
        }
      ],
      "default": [
