{
  "name": "Newsletter, centered",
  "category": "newsletters",
  "description": "A centered icon, heading and pitch above an email field and button.",
  "tags": ["newsletter", "email", "subscribe", "signup", "form", "centered"],
  "fieldGroups": ["Heading", "Form"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "icon",
      "label": "Icon",
      "type": "icon",
      "default": "mail",
      "group": "Heading"
    },
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Newsletter",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "One good research tip, every Tuesday",
      "group": "Heading",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "A five-minute read on interviewing, recruiting or synthesis, written by the Fieldnote research team. Join 12,400 researchers.",
      "group": "Heading"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Email address",
      "group": "Form",
      "required": true
    },
    {
      "name": "emailPlaceholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "you@company.com",
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Subscribe",
      "group": "Form",
      "required": true
    },
    {
      "name": "note",
      "label": "Privacy note",
      "type": "text",
      "default": "No spam. Unsubscribe with one click.",
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    }
  ]
}
