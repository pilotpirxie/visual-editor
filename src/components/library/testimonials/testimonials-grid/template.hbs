<section class="b-testimonials-grid section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <div class="grid b-grid">
      {{#each items}}
      <figure class="card stack b-card" data-field="items.{{@index}}">
        <blockquote class="b-quote"><p>{{nl2br quote}}</p></blockquote>
        <figcaption class="b-person">
          <div class="media b-photo">{{img photo}}</div>
          <div>
            <p class="b-name">{{name}}</p>
            {{#if role}}<p class="b-role">{{role}}</p>{{/if}}
          </div>
        </figcaption>
      </figure>
      {{/each}}
    </div>
  </div>
</section>
