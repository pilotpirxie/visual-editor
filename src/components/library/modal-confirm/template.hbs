<div class="b-modal-confirm" data-behavior="modal">
  <dialog class="modal b-dialog" id="{{block.id}}-dialog" aria-labelledby="{{block.id}}-title" aria-describedby="{{block.id}}-text">
    <button type="button" class="modal-close" command="close" commandfor="{{block.id}}-dialog" data-field="closeLabel">{{svgIcon "x"}}<span class="visually-hidden">{{closeLabel}}</span></button>
    <div class="b-layout">
      <span class="b-badge" data-field="icon">{{svgIcon icon}}</span>
      <div class="stack b-body">
        <h2 id="{{block.id}}-title" data-field="title">{{title}}</h2>
        <p class="b-muted" id="{{block.id}}-text" data-field="text">{{nl2br text}}</p>
        {{#if items.length}}
        <ul class="b-items" role="list">
          {{#each items}}
          <li class="b-item" data-field="items.{{@index}}"><span class="b-count">{{count}}</span> {{label}}</li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
    </div>
    <div class="b-actions">
      <button type="button" class="btn btn-secondary" command="close" commandfor="{{block.id}}-dialog" data-field="cancelLabel">{{cancelLabel}}</button>
      <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
    </div>
  </dialog>
</div>
