{
  "name": "Hero, photo stack",
  "category": "headers",
  "description": "Heading and buttons beside a fanned stack of tilted instant photos with handwritten-style captions.",
  "tags": ["hero", "heading", "photos", "polaroid", "collage", "story", "playful"],
  "fieldGroups": ["Heading", "Buttons", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Field research, made easy",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Research that feels like being in the room",
      "group": "Heading",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Capture photos, clips and notes from every visit, and give the whole team the context behind each insight.",
      "group": "Heading"
    },
    {
      "name": "primaryButton",
      "label": "Primary button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Buttons"
    },
    {
      "name": "showSecondary",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Buttons"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "Read the stories",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Buttons",
      "visibleWhen": {
        "field": "showSecondary",
        "equals": true
      }
    },
    {
      "name": "photos",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 1,
      "maxItems": 3,
      "itemLabel": "caption",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          }
        },
        {
          "name": "caption",
          "label": "Caption",
          "type": "text",
          "default": "Caption"
        }
      ],
      "default": [
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A customer showing their kitchen-table setup",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          },
          "caption": "Kitchen-table interview, Hamilton"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A wall of sticky notes after a diary study",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          },
          "caption": "Diary study wall, week 3"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A researcher riding along with a bike courier",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          },
          "caption": "Ride-along with a courier"
        }
      ]
    }
  ]
}
