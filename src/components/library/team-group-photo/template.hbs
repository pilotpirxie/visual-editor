<section class="b-team-group-photo section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <figure class="stack b-figure">
      <div class="b-frame">
        <div class="media b-photo" data-field="photo">{{img photo}}</div>
        <div class="b-markers" aria-hidden="true">
          {{#each people}}<span class="b-marker" style="--x: {{x}}; --y: {{y}}" data-field="people.{{@index}}"></span>{{/each}}
        </div>
      </div>
      {{#if caption}}<figcaption class="b-caption" data-field="caption">{{caption}}</figcaption>{{/if}}
    </figure>
    <ol class="b-legend" role="list">
      {{#each people}}
      <li class="b-person" data-field="people.{{@index}}">
        <span class="b-name">{{name}}</span>
        {{#if role}}<span class="b-role">{{role}}</span>{{/if}}
      </li>
      {{/each}}
    </ol>
  </div>
</section>
