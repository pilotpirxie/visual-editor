{
  "name": "Team, group photo",
  "category": "team",
  "description": "One wide group photo with numbered markers on each face and a matching numbered list of names.",
  "tags": ["team", "group photo", "people", "offsite", "numbered", "about", "culture"],
  "fieldGroups": ["Heading", "Photo", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Offsite 2026",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "All of us, in one place",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Once a year the whole team meets in person. This June we rented a farmhouse in Prince Edward County and finally put faces to chat avatars.",
      "group": "Heading"
    },
    {
      "name": "photo",
      "label": "Group photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "The Fieldnote team standing in two rows in front of a red barn",
        "decorative": false,
        "width": 1600,
        "height": 900,
        "placeholder": {
          "ratio": "16:9",
          "subject": "photo"
        }
      },
      "group": "Photo"
    },
    {
      "name": "caption",
      "label": "Caption",
      "type": "text",
      "default": "Prince Edward County, Ontario, June 2026",
      "group": "Photo"
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 20,
      "itemLabel": "name",
      "help": "Numbers follow the order of this list. Move each marker onto the right face.",
      "itemFields": [
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Name"
        },
        {
          "name": "role",
          "label": "Role",
          "type": "text",
          "default": ""
        },
        {
          "name": "x",
          "label": "Marker across (%)",
          "type": "number",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "name": "y",
          "label": "Marker down (%)",
          "type": "number",
          "default": 50,
          "min": 0,
          "max": 100,
          "step": 1
        }
      ],
      "default": [
        {
