{
  "name": "Testimonials, avatar switcher",
  "category": "testimonials",
  "description": "A row of avatars works as a picker: choosing a person shows their quote in the panel below, without any script.",
  "tags": ["testimonials", "quotes", "avatars", "switcher", "picker", "interactive", "radio"],
  "fieldGroups": ["Heading", "Quotes"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Client stories",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Pick a face to hear how the job went",
      "group": "Heading",
      "required": true
    },
    {
      "name": "pickerLabel",
      "label": "Picker label for screen readers",
      "type": "text",
      "default": "Choose a client",
      "group": "Quotes"
    },
    {
      "name": "items",
      "label": "Quotes",
      "type": "list",
      "group": "Quotes",
      "minItems": 2,
      "maxItems": 5,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "textarea",
          "default": "They turned up when they said they would and left the house cleaner than they found it."
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Client name"
        },
        {
          "name": "role",
          "label": "Project",
          "type": "text",
          "default": "Street, type of job"
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        }
      ],
      "default": [
