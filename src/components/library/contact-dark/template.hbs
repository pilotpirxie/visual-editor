<section class="b-contact-dark section">
  <div class="container b-inner">
    <div class="stack b-copy">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
      {{#if points.length}}
      <ul class="stack b-points" role="list">
        {{#each points}}
        <li data-field="points.{{@index}}"><span class="b-check">{{svgIcon "check"}}</span><span>{{text}}</span></li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    <form class="card stack b-form" {{#if formAction}}action="{{safeUrl formAction}}" method="{{formMethod}}"{{else}}method="dialog"{{/if}} data-field="formAction">
      <div class="field">
        <label for="{{block.id}}-name" data-field="nameLabel">{{nameLabel}}</label>
        <input id="{{block.id}}-name" name="name" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="{{block.id}}-email" data-field="emailLabel">{{emailLabel}}</label>
        <input id="{{block.id}}-email" type="email" name="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="{{block.id}}-company" data-field="companyLabel">{{companyLabel}}</label>
        <input id="{{block.id}}-company" name="company" autocomplete="organization">
      </div>
      <div class="field">
        <label for="{{block.id}}-message" data-field="messageLabel">{{messageLabel}}</label>
        <textarea id="{{block.id}}-message" name="message" rows="4" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary" data-field="buttonLabel">{{buttonLabel}}</button>
      {{#if note}}<p class="b-note" data-field="note">{{note}}</p>{{/if}}
    </form>
  </div>
</section>
