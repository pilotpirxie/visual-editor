{
  "name": "Logo cloud, two moving rows",
  "category": "logo-clouds",
  "description": "Two rows of customer logos that drift in opposite directions in an endless loop and pause under the pointer or keyboard focus. Visitors who prefer reduced motion get a still, wrapped logo wall.",
  "tags": [
    "logos",
    "customers",
    "marquee",
    "animated",
    "moving",
    "scrolling",
    "loop",
    "brands",
    "social proof"
