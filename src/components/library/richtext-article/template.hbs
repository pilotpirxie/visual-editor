<section class="b-richtext-article section">
  <div class="container">
    <article class="stack b-article">
      <header class="stack b-head">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
        {{#if (or author date)}}
        <p class="b-meta">
          {{#if author}}<span class="b-author" data-field="author">{{author}}</span>{{/if}}
          {{#if (and author date)}}<span class="b-dot" aria-hidden="true">·</span>{{/if}}
          {{#if date}}<time datetime="{{date}}" data-field="date">{{formatDate date}}</time>{{/if}}
        </p>
        {{/if}}
        {{#if lead}}<p class="b-lead" data-field="lead">{{nl2br lead}}</p>{{/if}}
      </header>
      <div class="prose b-body" data-field="body">{{richText body headings=true}}</div>
    </article>
  </div>
</section>
