<section class="b-steps-board-game section">
  <div class="container stack">
    <header class="stack">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-track" role="list">
      <li class="b-end" data-field="startLabel">
        <span class="b-token" aria-hidden="true">{{svgIcon tokenIcon}}</span>
        <strong>{{startLabel}}</strong>
      </li>
      {{#each steps}}
      <li data-field="steps.{{@index}}">
        <h3>{{title}}</h3>
        <p>{{nl2br text}}</p>
      </li>
      {{/each}}
      <li class="b-end b-finish" data-field="finishLabel"><strong>{{finishLabel}}</strong></li>
    </ol>
  </div>
</section>
