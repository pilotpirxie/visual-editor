<section class="b-steps-flowchart section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-chart">
      <p class="b-node b-pill" data-field="startLabel">{{svgIcon startIcon}}<span>{{startLabel}}</span></p>
      <div class="b-node card stack b-box" data-field="stepTitle">
        <h3>{{stepTitle}}</h3>
        {{#if stepText}}<p class="b-muted">{{nl2br stepText}}</p>{{/if}}
      </div>
      <p class="b-node b-decision" data-field="question">{{question}}</p>
      <div class="b-branches">
        <div class="b-branch card stack b-box" data-field="yesTitle">
          <p class="badge b-answer">{{yesLabel}}</p>
          <h3>{{yesTitle}}</h3>
          {{#if yesText}}<p class="b-muted">{{nl2br yesText}}</p>{{/if}}
        </div>
        <div class="b-branch card stack b-box" data-field="noTitle">
          <p class="badge b-answer">{{noLabel}}</p>
          <h3>{{noTitle}}</h3>
          {{#if noText}}<p class="b-muted">{{nl2br noText}}</p>{{/if}}
        </div>
      </div>
      <p class="b-node b-pill b-end" data-field="endLabel">{{svgIcon endIcon}}<span>{{endLabel}}</span></p>
    </div>
  </div>
</section>
