{
  "name": "Blog posts, peek inside",
  "category": "blog",
  "description": "Rows of post titles that open one at a time: the small thumbnail grows into the image and the excerpt and link appear.",
  "tags": ["blog", "posts", "articles", "accordion", "expand", "preview", "peek", "smart"],
  "fieldGroups": ["Heading", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Studio diary",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Lately at the wheel",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Notes from Slipware Studio. Open a post to peek inside before you read the whole thing.",
      "group": "Heading"
    },
    {
      "name": "linkLabel",
      "label": "Link text",
      "type": "text",
      "default": "Read the post",
      "group": "Posts",
      "required": true
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Fresh out of the kiln"
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
        },
        {
          "name": "excerpt",
          "label": "Excerpt",
          "type": "textarea",
          "default": "Two sentences that tell the reader what they will find inside."
        },
        {
          "name": "image",
          "label": "Image",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo from the studio",
            "decorative": false,
            "width": 1200,
            "height": 800,
            "placeholder": {
              "ratio": "3:2",
              "subject": "photo"
            }
          }
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
