<section class="b-features-toolbox section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-tray">
      {{#if boxLabel}}<p class="b-tape b-lid" data-field="boxLabel">{{boxLabel}}</p>{{/if}}
      <ul class="b-slots" role="list">
        {{#each items}}
        <li class="b-slot stack" data-field="items.{{@index}}">
          <h3 class="b-tape">{{name}}</h3>
          {{svgIcon icon}}
          <p>{{nl2br text}}</p>
          {{#if amount}}<p class="b-amount">{{amount}}</p>{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
