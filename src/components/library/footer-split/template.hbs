<footer class="b-footer-split">
  <div class="stack b-brand">
    <a class="b-logo" href="index.html">{{site.title}}</a>
    {{#if tagline}}<p class="b-tagline" data-field="tagline">{{nl2br tagline}}</p>{{/if}}
    {{#if showButton}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
  </div>
  <div class="stack b-main">
    <nav class="b-columns" aria-label="Footer">
      {{#each columns}}
      <div class="stack b-column" data-field="columns.{{@index}}">
        <h2 class="b-heading">{{title}}</h2>
        <ul class="b-links" role="list">
          {{#each links}}
          <li><a href="{{href link}}" {{linkAttrs link}} data-field="columns.{{@../index}}.links.{{@index}}">{{label}}</a></li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </nav>
    <div class="b-bottom">
      <p data-field="copyright">{{copyright}}</p>
      <ul class="cluster b-socials" role="list">
        {{#each socials}}
        <li><a href="{{href link}}" {{linkAttrs link}} data-field="socials.{{@index}}">{{svgIcon icon}}<span class="visually-hidden">{{label}}</span></a></li>
        {{/each}}
      </ul>
    </div>
  </div>
</footer>
