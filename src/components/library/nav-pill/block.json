{
  "name": "Navigation, floating pill",
  "category": "navigations",
  "description": "A rounded bar that floats inside the page margins, with link badges and one button.",
  "tags": ["menu", "navbar", "header", "pill", "floating", "rounded", "startup", "ai"],
  "fieldGroups": ["Logo", "Links", "Button", "Menu"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "logoIcon",
      "label": "Logo icon",
      "type": "icon",
      "default": "lucide:sparkle",
      "iconPurpose": "logo",
      "group": "Logo"
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 6,
      "itemLabel": "label",
      "itemFields": [
        { "name": "label", "label": "Label", "type": "text", "default": "Link" },
        { "name": "badge", "label": "Badge", "type": "text", "default": "", "maxLength": 12 },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": { "type": "url", "url": "#", "newTab": false }
        }
      ],
      "default": [
        {
          "label": "Product",
          "badge": "",
          "link": { "type": "section", "anchor": "features", "newTab": false }
        },
        {
          "label": "Use cases",
          "badge": "",
          "link": { "type": "section", "anchor": "use-cases", "newTab": false }
        },
        {
          "label": "Pricing",
          "badge": "",
          "link": { "type": "section", "anchor": "pricing", "newTab": false }
        },
        {
          "label": "Changelog",
          "badge": "New",
          "link": { "type": "url", "url": "#", "newTab": false }
        }
      ]
    },
    {
      "name": "showCta",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "cta",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Try it free",
        "link": { "type": "url", "url": "#", "newTab": false },
        "variant": "primary"
      },
      "visibleWhen": { "field": "showCta", "equals": true },
      "group": "Button"
    },
    {
      "name": "menuIcon",
      "label": "Menu icon",
      "type": "icon",
      "default": "menu",
      "group": "Menu"
    }
  ]
}
