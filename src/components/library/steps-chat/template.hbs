<section class="b-steps-chat section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
      {{#if showButton}}<div><a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a></div>{{/if}}
    </header>
    <div class="b-window">
      <div class="b-bar">
        <span class="b-avatar">{{svgIcon botIcon}}</span>
        <p class="b-who"><strong data-field="botName">{{botName}}</strong><span class="b-muted" data-field="botStatus">{{botStatus}}</span></p>
      </div>
      <ol class="b-thread" role="list">
        {{#each steps}}
        <li class="b-step" data-field="steps.{{@index}}">
          <p class="b-step-label"><span>{{../stepLabel}}</span></p>
          <p class="b-bubble b-ask">{{question}}</p>
          <p class="b-bubble b-reply">{{nl2br answer}}</p>
        </li>
        {{/each}}
      </ol>
    </div>
  </div>
</section>
