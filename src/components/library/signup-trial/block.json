{
  "name": "Sign up, trial timeline",
  "category": "sign-up",
  "description": "A sign-up form beside a timeline that explains what happens during the free trial, from today to the first bill.",
  "tags": ["sign up", "trial", "free trial", "timeline", "billing", "transparency", "form"],
  "fieldGroups": ["Heading", "Form", "Timeline"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "14-day free trial",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Try Fieldnote with nothing to lose",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "No credit card to start. Cancel from settings in two clicks, any time before day 14.",
      "group": "Heading"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "required": true,
      "group": "Form"
    },
    {
      "name": "passwordLabel",
      "label": "Password field label",
      "type": "text",
      "default": "Password",
      "required": true,
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Start my free trial",
      "required": true,
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    },
    {
      "name": "note",
      "label": "Note",
      "type": "text",
      "default": "By signing up you agree to our terms and privacy policy.",
      "group": "Form"
    },
    {
      "name": "timelineTitle",
      "label": "Timeline title",
      "type": "text",
      "default": "How your trial works",
      "required": true,
      "group": "Timeline"
    },
    {
      "name": "events",
      "label": "Events",
      "type": "list",
      "group": "Timeline",
      "minItems": 2,
      "maxItems": 5,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "icon",
          "label": "Icon",
          "type": "icon",
          "default": "calendar"
        },
        {
          "name": "when",
          "label": "When",
          "type": "text",
          "default": "Day 1"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Event"
        },
        {
          "name": "text",
          "label": "Text",
          "type": "text",
          "default": ""
        }
      ],
      "default": [
        {
          "icon": "zap",
          "when": "Today",
          "title": "Full access, right away",
          "text": "Record, transcribe and share with every Team plan feature."
        },
        {
          "icon": "bell",
          "when": "Day 12",
          "title": "A reminder email",
          "text": "We tell you two days before the trial ends. No surprises."
        },
        {
          "icon": "credit-card",
          "when": "Day 14",
          "title": "Your plan starts",
          "text": "You’re billed only if you added a card and kept the plan."
        }
      ]
    },
    {
      "name": "cancelNote",
      "label": "Cancel note",
      "type": "text",
      "default": "Cancel any time. Your recordings stay yours.",
      "group": "Timeline"
    }
  ]
}
