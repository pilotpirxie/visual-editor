<aside class="b-banner-launch" aria-label="Launch">
  <div class="container b-bar">
    <span class="b-logo" data-field="logo">{{svgIcon logo}}</span>
    <p class="b-message">
      {{#if eyebrow}}<strong class="b-eyebrow" data-field="eyebrow">{{eyebrow}}</strong>{{/if}}
      <span data-field="text">{{text}}</span>
    </p>
    <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{svgIcon "arrow-up"}}<span>{{button.label}}</span></a>
  </div>
</aside>
