<section class="b-blog-essays section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-list" role="list">
      {{#each posts}}
      <li class="b-essay" data-field="posts.{{@index}}">
        <article class="stack">
          <h3 class="b-title"><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{title}}</a></h3>
          {{#if excerpt}}<p class="b-muted b-excerpt">{{nl2br excerpt}}</p>{{/if}}
          <p class="b-muted b-meta">
            {{#if author}}<span class="b-author">{{author}}</span>{{/if}}
            {{#if readingTime}}<span>{{readingTime}}</span>{{/if}}
            {{#if date}}<time datetime="{{date}}">{{formatDate date}}</time>{{/if}}
          </p>
        </article>
      </li>
      {{/each}}
    </ol>
  </div>
</section>
