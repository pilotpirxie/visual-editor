<section class="b-steps-countdown section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-count" role="list" reversed style="--count: {{steps.length}}">
      {{#each steps}}
      <li data-field="steps.{{@index}}">
        <h3>{{title}}</h3>
        <p>{{nl2br text}}</p>
      </li>
      {{/each}}
    </ol>
    {{#if finale}}<p class="b-finale" data-field="finale">{{finale}}</p>{{/if}}
  </div>
</section>
