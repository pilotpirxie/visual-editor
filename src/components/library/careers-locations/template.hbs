<section class="b-careers-locations section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-grid" role="list">
      {{#each offices}}
      <li class="b-tile b-office" data-field="offices.{{@index}}">
        <div class="b-photo">{{img photo}}</div>
        <div class="stack b-info">
          <p class="b-tag">{{svgIcon "clock"}}<span>{{timezone}}</span></p>
          <h3><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{city}}</a></h3>
          <p class="b-meta">{{country}} · <strong>{{roles}}</strong></p>
        </div>
      </li>
      {{/each}}
      {{#if showRemote}}
      <li class="b-tile b-remote" data-field="remoteTitle">
        <span class="b-globe">{{svgIcon remoteIcon}}</span>
        <h3><a class="b-link" href="{{href remoteLink}}" {{linkAttrs remoteLink}}>{{remoteTitle}}</a></h3>
        {{#if remoteText}}<p class="b-muted">{{nl2br remoteText}}</p>{{/if}}
        <p class="b-meta"><strong>{{remoteRoles}}</strong></p>
      </li>
      {{/if}}
    </ul>
  </div>
</section>
