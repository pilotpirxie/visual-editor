{
  "name": "Call to action, avatar stack",
  "category": "call-to-action",
  "description": "A row of overlapping customer photos and a line of social proof above a centered pitch.",
  "tags": ["cta", "avatars", "community", "social proof", "join"],
  "fieldGroups": ["Proof", "Content", "Buttons"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "avatars",
      "label": "Photos",
      "type": "list",
      "group": "Proof",
      "minItems": 0,
      "maxItems": 6,
      "itemFields": [
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Customer",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        }
      ],
      "default": [
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Ingrid Solberg",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Jonas Becker",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Priya Raman",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Leila Haddad",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Mateo Alvarez",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        }
      ]
    },
    {
      "name": "proof",
      "label": "Proof line",
      "type": "text",
      "default": "Join 4,200 research teams",
      "group": "Proof"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Your customers are already telling you what to build",
      "group": "Content",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Fieldnote helps you hear it. Record, transcribe and share interviews with the people who make product decisions.",
      "group": "Content"
    },
    {
      "name": "primaryButton",
      "label": "Primary button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Buttons"
    },
    {
      "name": "showSecondary",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Buttons"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "Book a demo",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Buttons",
      "visibleWhen": {
        "field": "showSecondary",
        "equals": true
      }
    }
  ]
}
