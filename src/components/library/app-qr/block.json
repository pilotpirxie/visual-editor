{
  "name": "Applications, scan to download",
  "category": "applications",
  "description": "A download card with a QR code for desktop visitors, store buttons and a phone screenshot.",
  "tags": ["app", "mobile", "download", "qr code", "scan", "app store", "google play", "badges"],
  "fieldGroups": ["Heading", "QR code", "Badges", "Screenshot"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Free for iPhone and Android",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Your running coach goes where you go",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Pace plans every session around your race date and adjusts the week when life gets in the way. Your history comes with you from the website.",
      "group": "Heading"
    },
    {
      "name": "qrCode",
      "label": "QR code",
      "type": "image",
      "help": "Shown on tablets and computers only.",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "QR code to download the Pace app",
        "decorative": false,
        "width": 600,
        "height": 600,
        "placeholder": {
          "ratio": "1:1",
          "subject": "logo"
        }
      },
      "group": "QR code"
    },
    {
      "name": "qrLabel",
      "label": "QR code label",
      "type": "text",
      "default": "Scan with your phone camera",
      "maxLength": 60,
      "group": "QR code"
    },
    {
      "name": "qrNote",
      "label": "QR code note",
      "type": "text",
      "default": "It opens the right store for your phone.",
      "maxLength": 80,
      "group": "QR code"
    },
    {
      "name": "badges",
      "label": "Download badges",
      "type": "list",
      "group": "Badges",
      "minItems": 1,
      "maxItems": 3,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "icon",
          "label": "Store logo",
          "type": "icon",
          "default": "simple-icons:apple",
          "iconPurpose": "brand"
        },
        {
          "name": "smallLabel",
          "label": "Small label",
          "type": "text",
          "default": "Download on the"
        },
        {
          "name": "label",
          "label": "Store name",
          "type": "text",
          "default": "App Store"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": true
          }
        }
      ],
      "default": [
        {
          "icon": "simple-icons:apple",
          "smallLabel": "Download on the",
          "label": "App Store",
          "link": {
            "type": "url",
            "url": "https://apps.apple.com",
            "newTab": true
          }
        },
        {
          "icon": "simple-icons:googleplay",
          "smallLabel": "Get it on",
          "label": "Google Play",
          "link": {
            "type": "url",
            "url": "https://play.google.com",
            "newTab": true
          }
        }
      ]
    },
    {
      "name": "screenshot",
      "label": "Screenshot",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "The Pace app showing this week’s training plan with a tempo run on Thursday",
        "decorative": false,
        "width": 900,
        "height": 1200,
        "placeholder": {
          "ratio": "3:4",
          "subject": "screenshot"
        }
      },
      "group": "Screenshot"
    }
  ]
}
