{
  "name": "Gallery, moving photo strip",
  "category": "gallery",
  "description": "A staggered strip of photos in mixed shapes that drifts sideways in an endless loop and pauses under the pointer or keyboard focus. Visitors who prefer reduced motion get a still, wrapped set of photos.",
  "tags": [
    "gallery",
    "photos",
    "marquee",
    "animated",
    "moving",
    "scrolling",
    "loop",
    "strip",
    "captions"
  ],
  "fieldGroups": ["Heading", "Photos", "Motion"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Team offsite",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Four days above Lake Como",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Once a year the whole company closes its laptops for a week. This is what that looked like in June.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 2,
      "maxItems": 10,
      "itemLabel": "caption",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          }
        },
        {
          "name": "caption",
          "label": "Caption",
          "type": "text",
          "default": "",
          "maxLength": 40
        }
      ],
      "default": [
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "The team walking a ridge path above the lake",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "caption": "Day one hike"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Yuki Tanaka sketching a roadmap on a window with a marker",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "photo"
            }
          },
          "caption": "Roadmap on glass"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Long table set for dinner on a terrace at dusk",
            "decorative": false,
            "width": 1200,
            "height": 800,
            "placeholder": {
              "ratio": "3:2",
              "subject": "photo"
            }
          },
          "caption": "Dinner for forty"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Two engineers pairing on a laptop on the dock",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          },
          "caption": "Dockside pairing"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A ferry crossing the lake under morning fog",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "caption": "The 7:40 ferry"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Ingrid Solberg presenting customer clips in a stone barn",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "photo"
            }
          },
          "caption": "Show and tell"
        }
      ]
    },
    {
      "name": "speed",
      "label": "Speed",
      "type": "select",
      "default": "normal",
      "group": "Motion",
      "help": "The strip stands still for visitors who ask their device for less motion.",
      "options": [
        {
          "value": "slow",
          "label": "Slow"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "fast",
          "label": "Fast"
        }
      ]
    }
  ]
}
