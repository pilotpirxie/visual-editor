<footer class="b-footer-shop section">
  <div class="container stack b-inner">
    <div class="b-top">
      <div class="stack b-brand">
        <a class="b-logo" href="index.html">{{site.title}}</a>
        {{#if tagline}}<p class="b-muted" data-field="tagline">{{nl2br tagline}}</p>{{/if}}
      </div>
      <nav class="b-columns" aria-label="Footer">
        {{#each columns}}
        <div class="stack b-column" data-field="columns.{{@index}}">
          <h2 class="b-heading">{{title}}</h2>
          <ul class="b-links" role="list">
            {{#each links}}
            <li><a href="{{href link}}" {{linkAttrs link}} data-field="columns.{{@../index}}.links.{{@index}}">{{label}}</a></li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
      </nav>
    </div>
    <div class="b-bottom">
      <p class="b-muted" data-field="copyright">{{copyright}}</p>
      <div class="b-payments">
        <p class="b-muted" data-field="paymentsLabel">{{paymentsLabel}}</p>
        <ul class="cluster b-cards" role="list">
          {{#each payments}}
          <li class="b-card" data-field="payments.{{@index}}">{{svgIcon icon}}<span class="visually-hidden">{{label}}</span></li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</footer>
