{
  "name": "Footer, store with payment logos",
  "category": "footers",
  "description": "Shop and help link columns with the payment methods you accept.",
  "tags": ["footer", "shop", "store", "ecommerce", "payments", "cards", "links"],
  "fieldGroups": ["Brand", "Columns", "Payments", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
