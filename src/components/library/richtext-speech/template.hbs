<section class="b-richtext-speech section">
  <div class="container">
    <figure class="b-talk">
      <blockquote class="b-bubble">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
        <div class="prose b-body" data-field="body">{{richText body headings=true}}</div>
      </blockquote>
      <figcaption class="b-speaker">
        <div class="media b-photo" data-field="photo">{{img photo}}</div>
        <div>
          <p class="b-name" data-field="name">{{name}}</p>
          {{#if role}}<p class="b-role" data-field="role">{{role}}</p>{{/if}}
        </div>
      </figcaption>
    </figure>
  </div>
</section>
