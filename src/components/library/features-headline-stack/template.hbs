<section class="b-features-headline-stack section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-text" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-rows" role="list">
      {{#each items}}
      <li class="b-row" data-field="items.{{@index}}">
        <h3 class="b-line"><a href="{{href link}}" {{linkAttrs link}}>{{name}}</a></h3>
        <p class="b-text">{{nl2br text}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
