<section class="b-gallery-hexagons section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
      {{#if showButton}}<p><a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a></p>{{/if}}
    </header>
    <ul class="b-comb" role="list">
      {{#each items}}
      <li class="b-hex" data-field="items.{{@index}}">{{img image}}</li>
      {{/each}}
    </ul>
  </div>
</section>
