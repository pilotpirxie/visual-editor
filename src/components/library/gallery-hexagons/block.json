{
  "name": "Gallery, hexagon grid",
  "category": "gallery",
  "description": "Photos cut into hexagons and fitted together as a honeycomb beside a heading and button.",
  "tags": ["gallery", "photos", "hexagon", "honeycomb", "community", "events", "shapes"],
  "fieldGroups": ["Heading", "Button", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Community",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Research Club, in pictures",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Every month, sixty researchers meet in Toronto to swap interview guides and war stories. Here is the past year.",
      "group": "Heading"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Join the next meetup",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Button",
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      }
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 1,
      "maxItems": 13,
      "help": "Eight photos fill the honeycomb evenly.",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          }
        }
      ],
