<section class="b-signin-split section">
  <div class="container b-inner">
    <div class="stack b-panel">
      <header class="stack b-head">
        <h2 data-field="title">{{title}}</h2>
        {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
      </header>
      <form class="stack b-form" {{#if formAction}}action="{{safeUrl formAction}}" method="{{formMethod}}"{{else}}method="dialog"{{/if}} data-field="formAction">
        <div class="field">
          <label for="{{block.id}}-email" data-field="emailLabel">{{emailLabel}}</label>
          <input id="{{block.id}}-email" type="email" name="email" autocomplete="username" required>
        </div>
        <div class="field">
          <label for="{{block.id}}-password" data-field="passwordLabel">{{passwordLabel}}</label>
          <input id="{{block.id}}-password" type="password" name="password" autocomplete="current-password" required>
        </div>
        <div class="b-options">
          <div class="field-check b-check">
            <input id="{{block.id}}-remember" type="checkbox" name="remember" value="yes">
            <label for="{{block.id}}-remember" data-field="rememberLabel">{{rememberLabel}}</label>
          </div>
          {{#if forgotLabel}}<a class="b-forgot" href="{{href forgotLink}}" {{linkAttrs forgotLink}} data-field="forgotLink">{{forgotLabel}}</a>{{/if}}
        </div>
        <button type="submit" class="btn btn-primary b-submit" data-field="buttonLabel">{{buttonLabel}}</button>
      </form>
      {{#if signUpLabel}}<p class="b-switch" data-field="signUpLink">{{signUpText}} <a href="{{href signUpLink}}" {{linkAttrs signUpLink}}>{{signUpLabel}}</a></p>{{/if}}
    </div>
    <div class="b-visual">
      <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}" data-field="image">
        {{img image}}
      </div>
      {{#if showQuote}}
      <figure class="stack b-quote" data-field="quote">
        <blockquote><p>{{nl2br quote}}</p></blockquote>
        <figcaption class="b-person">
          <span class="b-name">{{quoteName}}</span>
          {{#if quoteRole}}<span class="b-role">{{quoteRole}}</span>{{/if}}
        </figcaption>
      </figure>
      {{/if}}
    </div>
  </div>
</section>
