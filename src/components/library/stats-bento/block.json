{
  "name": "Numbers, bento tiles",
  "category": "numbers",
  "description": "Mixed-size number tiles: a large photo tile, a dark tile and small tiles.",
  "tags": ["numbers", "stats", "bento", "tiles", "impact", "annual report", "nonprofit", "image"],
  "fieldGroups": ["Heading", "Photo tile", "Dark tile", "Small tiles"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "2025 impact report",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "A year of full plates across the valley",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Thanks to 1,850 volunteers and every donor who gave, Riverbend Food Bank reached more families than ever before.",
      "group": "Heading"
    },
    {
      "name": "image",
      "label": "Photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "Volunteers packing boxes of fresh vegetables in the Riverbend warehouse",
        "decorative": false,
        "width": 1200,
        "height": 900,
        "placeholder": {
          "ratio": "4:3",
          "subject": "photo"
        }
      },
      "group": "Photo tile"
    },
    {
      "name": "heroValue",
      "label": "Number",
      "type": "text",
      "default": "2.4 million",
      "group": "Photo tile"
    },
    {
      "name": "heroLabel",
      "label": "Label",
      "type": "text",
      "default": "Meals delivered across 14 counties",
      "group": "Photo tile"
    },
    {
      "name": "darkValue",
      "label": "Number",
      "type": "text",
      "default": "92¢",
      "group": "Dark tile"
    },
    {
      "name": "darkLabel",
      "label": "Label",
      "type": "text",
      "default": "Of every dollar goes straight to programs",
      "group": "Dark tile"
    },
    {
      "name": "darkText",
      "label": "Note",
      "type": "text",
      "default": "Independently audited by Hartley & Rowe.",
      "group": "Dark tile"
    },
    {
      "name": "stats",
      "label": "Small tiles",
      "type": "list",
      "group": "Small tiles",
      "minItems": 0,
      "maxItems": 4,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "value",
          "label": "Number",
          "type": "text",
          "default": "100"
        },
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Label"
        }
      ],
      "default": [
        {
          "value": "1,850",
          "label": "Volunteers"
        },
        {
          "value": "312",
          "label": "Partner pantries"
        }
      ]
    },
    {
      "name": "countUp",
      "label": "Count up when visible",
      "type": "boolean",
      "default": true,
      "group": "Small tiles"
    }
  ]
}
