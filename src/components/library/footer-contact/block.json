{
  "name": "Footer, contact columns",
  "category": "footers",
  "description": "Separate sales, support and press contacts, each with an icon, email and phone.",
  "tags": ["footer", "contact", "sales", "support", "press", "email", "phone"],
  "fieldGroups": ["Brand", "Contacts", "Links", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "tagline",
      "label": "Tagline",
      "type": "textarea",
      "default": "Real people answer every message, usually within a business day.",
      "group": "Brand"
    },
    {
      "name": "teams",
      "label": "Contacts",
      "type": "list",
      "group": "Contacts",
      "minItems": 1,
      "maxItems": 4,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "icon",
          "label": "Icon",
          "type": "icon",
          "default": "mail"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Team"
        },
        {
          "name": "text",
          "label": "Text",
          "type": "text",
          "default": ""
        },
        {
          "name": "email",
          "label": "Email",
          "type": "text",
          "default": ""
        },
        {
          "name": "phone",
          "label": "Phone",
          "type": "text",
          "default": ""
        }
      ],
      "default": [
        {
          "icon": "briefcase",
          "title": "Sales",
          "text": "Plans, pilots and security reviews.",
          "email": "sales@fieldnote.example",
          "phone": "+1 416 555 0142"
        },
        {
          "icon": "support",
          "title": "Support",
          "text": "Help with your account and recordings.",
          "email": "support@fieldnote.example",
          "phone": "+1 416 555 0199"
        },
        {
          "icon": "mic",
          "title": "Press",
          "text": "Interviews, logos and company facts.",
          "email": "press@fieldnote.example",
          "phone": ""
        }
      ]
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 8,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Help center",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Status",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Privacy",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Terms",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "copyright",
      "label": "Legal line",
      "type": "text",
      "default": "© 2026 Fieldnote Inc. All rights reserved.",
      "group": "Legal"
    }
  ]
}
