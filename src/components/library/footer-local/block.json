{
  "name": "Footer, address and opening hours",
  "category": "footers",
  "description": "Address with directions, phone and email, and opening hours, for places people visit.",
  "tags": ["footer", "address", "hours", "opening hours", "location", "local", "contact"],
  "fieldGroups": ["Brand", "Visit", "Contact", "Hours", "Links", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "tagline",
      "label": "Tagline",
      "type": "textarea",
      "default": "Our Toronto research studio has two quiet rooms for in-person interviews and usability sessions.",
      "group": "Brand"
    },
    {
      "name": "visitTitle",
      "label": "Address title",
      "type": "text",
      "default": "Visit us",
      "group": "Visit"
    },
    {
      "name": "address",
      "label": "Address",
      "type": "textarea",
      "default": "220 King Street West, 4th floor\nToronto, ON M5H 1K4",
      "group": "Visit"
    },
    {
      "name": "directionsLabel",
      "label": "Directions link label",
      "type": "text",
      "default": "Get directions",
      "group": "Visit"
    },
    {
      "name": "directionsLink",
      "label": "Directions link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "https://www.openstreetmap.org",
        "newTab": true
      },
      "group": "Visit"
    },
    {
      "name": "contactTitle",
      "label": "Contact title",
      "type": "text",
      "default": "Call or write",
      "group": "Contact"
    },
    {
      "name": "phone",
      "label": "Phone",
      "type": "text",
      "default": "+1 416 555 0142",
      "group": "Contact"
    },
    {
      "name": "email",
      "label": "Email",
      "type": "text",
      "default": "studio@fieldnote.example",
      "group": "Contact"
    },
    {
      "name": "hoursTitle",
      "label": "Hours title",
      "type": "text",
      "default": "Opening hours",
      "group": "Hours"
    },
    {
      "name": "hours",
      "label": "Opening hours",
      "type": "list",
      "group": "Hours",
      "minItems": 1,
      "maxItems": 7,
      "itemLabel": "days",
      "itemFields": [
        {
          "name": "days",
          "label": "Days",
          "type": "text",
          "default": "Monday"
        },
        {
          "name": "time",
          "label": "Hours",
          "type": "text",
          "default": "9:00–17:00"
        }
      ],
      "default": [
        {
          "days": "Monday to Thursday",
          "time": "8:30–18:00"
        },
        {
          "days": "Friday",
          "time": "8:30–16:00"
        },
        {
          "days": "Saturday",
          "time": "By appointment"
        },
        {
          "days": "Sunday",
          "time": "Closed"
        }
      ]
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 6,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Book a room",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Accessibility",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Privacy",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "copyright",
      "label": "Legal line",
      "type": "text",
      "default": "© 2026 Fieldnote Inc. All rights reserved.",
      "group": "Legal"
    }
  ]
}
