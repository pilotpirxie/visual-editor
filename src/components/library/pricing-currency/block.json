{
  "name": "Pricing, currency switch",
  "category": "pricing",
  "description": "Plan cards with a small three-way currency switch that swaps every price between three currencies.",
  "tags": ["pricing", "plans", "currency", "switch", "international", "radio", "interactive"],
  "fieldGroups": ["Heading", "Currencies", "Plans"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Stays for 2027",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Board, bed and breakfast in Ericeira",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Tidewater Surf House sleeps twelve, a five-minute walk from the break. Every stay includes boards, wetsuits and breakfast.",
      "group": "Heading"
    },
    {
      "name": "note",
      "label": "Note",
      "type": "textarea",
      "default": "You pay in the currency you choose here. A 20% deposit holds your bed.",
      "group": "Heading"
    },
    {
      "name": "legend",
      "label": "Switch label for screen readers",
      "type": "text",
      "default": "Show prices in",
      "required": true,
      "group": "Currencies"
    },
    {
      "name": "currency1",
      "label": "First currency",
      "type": "text",
      "default": "USD",
      "required": true,
      "maxLength": 6,
      "group": "Currencies"
    },
    {
      "name": "currency2",
      "label": "Second currency",
      "type": "text",
      "default": "EUR",
      "required": true,
      "maxLength": 6,
      "group": "Currencies"
    },
    {
      "name": "currency3",
      "label": "Third currency",
      "type": "text",
      "default": "GBP",
      "required": true,
      "maxLength": 6,
      "group": "Currencies"
    },
    {
      "name": "featuredLabel",
      "label": "Label on the featured plan",
      "type": "text",
      "default": "Most booked",
      "group": "Plans"
    },
    {
