<section class="b-steps-staircase section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-stairs" role="list">
      {{#each steps}}
      <li class="b-step" style="--i: {{@index}}" data-field="steps.{{@index}}">
        <div class="stack b-text">
          <span class="b-icon">{{svgIcon icon}}</span>
          <h3>{{title}}</h3>
          <p class="b-muted">{{nl2br text}}</p>
        </div>
        <span class="b-riser" aria-hidden="true"></span>
      </li>
      {{/each}}
    </ol>
  </div>
</section>
