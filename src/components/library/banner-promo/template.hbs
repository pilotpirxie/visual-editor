<aside class="b-banner-promo" aria-label="Promotion">
  <dialog open id="{{block.id}}-promo" class="b-bar">
    <div class="container b-inner">
      <div class="b-content">
        <p class="b-message">
          {{#if label}}<span class="badge b-label" data-field="label">{{label}}</span>{{/if}}
          <span data-field="text">{{text}}</span>
        </p>
        {{#if showButton}}
        <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
        {{/if}}
      </div>
      <button type="button" command="close" commandfor="{{block.id}}-promo" class="b-close">{{svgIcon "x"}}<span class="visually-hidden">Dismiss</span></button>
    </div>
  </dialog>
</aside>
