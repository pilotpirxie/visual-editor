<section class="b-pricing-price-tags section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-rail" role="list">
      {{#each tags}}
      <li class="b-slot" data-field="tags.{{@index}}">
        <article class="stack b-tag">
          <h3 class="b-name">{{name}}</h3>
          <p class="b-price">{{price}}</p>
          {{#if period}}<p class="b-muted">{{period}}</p>{{/if}}
          <p class="b-text">{{nl2br description}}</p>
          <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
        </article>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
