{
  "name": "Hero, with key numbers",
  "category": "headers",
  "description": "A large page heading with a pitch and buttons beside it, and a row of key numbers underneath.",
  "tags": [
    "hero",
    "heading",
    "numbers",
    "stats",
    "metrics",
    "impact",
    "results",
    "nonprofit",
    "agency"
  ],
  "fieldGroups": ["Heading", "Buttons", "Numbers"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Working in Kenya since 2011",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Clean water for every school in the Rift Valley",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "We drill wells, train local technicians and stay to keep them running. Every donation is tracked to a well you can find on the map.",
      "group": "Heading"
    },
    {
      "name": "primaryButton",
      "label": "Primary button",
      "type": "button",
      "default": {
        "label": "Donate monthly",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Buttons"
    },
    {
      "name": "showSecondary",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Buttons"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "See our projects",
        "link": {
          "type": "section",
          "anchor": "projects",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showSecondary",
        "equals": true
      },
      "group": "Buttons"
    },
    {
      "name": "stats",
      "label": "Numbers",
      "type": "list",
      "group": "Numbers",
      "minItems": 1,
      "maxItems": 4,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "value",
          "label": "Number",
          "type": "text",
          "default": "100"
        },
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Label"
        }
      ],
      "default": [
        {
          "value": "412",
          "label": "Wells built"
        },
        {
          "value": "1.2M",
          "label": "People with safe water"
        },
        {
          "value": "96%",
          "label": "Wells still working today"
        },
        {
          "value": "38",
          "label": "Local technicians trained"
        }
      ]
    },
    {
      "name": "countUp",
      "label": "Count up when visible",
      "type": "boolean",
      "default": true,
      "group": "Numbers"
    }
  ]
}
