<section class="b-steps-swimlanes section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-board">
      <p class="b-lane" data-field="youLabel">{{svgIcon youIcon}}<span>{{youLabel}}</span></p>
      <p class="b-lane b-us" data-field="usLabel">{{svgIcon usIcon}}<span>{{usLabel}}</span></p>
      <ol class="b-steps" role="list">
        {{#each steps}}
        <li class="b-step" data-owner="{{owner}}" data-field="steps.{{@index}}">
          <div class="stack b-card">
            <p class="eyebrow b-who">{{#if (eq owner "us")}}{{../usLabel}}{{else}}{{../youLabel}}{{/if}}</p>
            <h3>{{title}}</h3>
            <p class="b-muted">{{nl2br text}}</p>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>
  </div>
</section>
