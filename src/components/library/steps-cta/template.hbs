<section class="b-steps-cta section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-row">
      <ol class="b-steps" role="list">
        {{#each steps}}
        <li class="b-step" data-field="steps.{{@index}}">
          <span class="b-icon">{{svgIcon icon}}</span>
          <div class="stack b-body">
            <h3>{{title}}</h3>
            <p class="b-muted">{{nl2br text}}</p>
          </div>
        </li>
        {{/each}}
      </ol>
      <div class="stack b-card">
        <h3 data-field="cardTitle">{{cardTitle}}</h3>
        {{#if cardText}}<p class="b-muted" data-field="cardText">{{nl2br cardText}}</p>{{/if}}
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      </div>
    </div>
  </div>
</section>
