<section class="b-cta-guarantee section">
  <div class="container b-inner">
    <p class="b-seal" data-field="sealNumber">
      <span class="b-seal-face"><span class="b-number">{{sealNumber}}</span> <span class="b-unit">{{sealUnit}}</span> <span class="b-seal-text">{{sealText}}</span></span>
    </p>
    <div class="stack b-copy">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-muted" data-field="text">{{nl2br text}}</p>{{/if}}
      {{#if points.length}}
      <ul class="b-points" role="list">
        {{#each points}}
        <li data-field="points.{{@index}}">{{svgIcon "check-circle"}}{{text}}</li>
        {{/each}}
      </ul>
      {{/if}}
      <div class="cluster">
        <a class="btn btn-{{primaryButton.variant}}" href="{{href primaryButton.link}}" {{linkAttrs primaryButton.link}} data-field="primaryButton">{{primaryButton.label}}</a>
        {{#if showSecondary}}
        <a class="btn btn-{{secondaryButton.variant}}" href="{{href secondaryButton.link}}" {{linkAttrs secondaryButton.link}} data-field="secondaryButton">{{secondaryButton.label}}</a>
        {{/if}}
      </div>
      {{#if note}}<p class="b-muted b-note" data-field="note">{{note}}</p>{{/if}}
    </div>
  </div>
</section>
