<section class="b-pricing-list section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-groups">
      {{#each groups}}
      <div class="b-group" data-field="groups.{{@index}}">
        <div class="b-group-head">
          <h3>{{name}}</h3>
          {{#if note}}<p class="b-note">{{note}}</p>{{/if}}
        </div>
        <ul class="b-items" role="list">
          {{#each items}}
          <li class="b-item" data-field="groups.{{@../index}}.items.{{@index}}">
            <div class="b-line">
              <p class="b-name">{{name}}{{#if tag}} <span class="badge b-tag">{{tag}}</span>{{/if}}</p>
              <span class="b-leader"></span>
              <p class="b-price">{{price}}</p>
            </div>
            {{#if description}}<p class="b-description">{{nl2br description}}</p>{{/if}}
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
    {{#if footnote}}<p class="b-footnote" data-field="footnote">{{nl2br footnote}}</p>{{/if}}
  </div>
</section>
