<section class="b-pricing-3-plans section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="grid b-plans">
      {{#each plans}}
      <article class="card stack b-plan" {{#if featured}}data-featured{{/if}} data-field="plans.{{@index}}">
        <div class="b-plan-head">
          <h3>{{name}}</h3>
          {{#if featured}}<p class="badge">{{../featuredLabel}}</p>{{/if}}
        </div>
        <p class="b-price"><span class="b-amount">{{price}}</span> <span class="b-period">{{period}}</span></p>
        {{#if description}}<p class="b-description">{{nl2br description}}</p>{{/if}}
        <div class="prose b-features">{{richText features}}</div>
        <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
      </article>
      {{/each}}
    </div>
  </div>
</section>
