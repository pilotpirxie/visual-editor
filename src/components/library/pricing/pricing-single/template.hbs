<section class="b-pricing-single section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <article class="card stack b-plan">
      <p class="b-price"><span class="b-amount" data-field="price">{{price}}</span> <span class="b-period" data-field="period">{{period}}</span></p>
      <div class="prose b-features" data-field="features">{{richText features}}</div>
      <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      {{#if note}}<p class="b-note" data-field="note">{{note}}</p>{{/if}}
    </article>
  </div>
</section>
