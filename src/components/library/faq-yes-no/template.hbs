<section class="b-faq-yes-no section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-list">
      {{#each items}}
      <details class="b-item" name="{{../block.id}}" data-field="items.{{@index}}" {{#if @first}}open{{/if}}>
        <summary class="b-question">
          <span>{{question}}</span>
          <span class="b-pill" data-verdict="{{verdict}}">{{#if (eq verdict "yes")}}{{svgIcon "check"}}{{../yesLabel}}{{/if}}{{#if (eq verdict "no")}}{{svgIcon "x"}}{{../noLabel}}{{/if}}{{#if (eq verdict "depends")}}{{svgIcon "help"}}{{../dependsLabel}}{{/if}}</span>
          <span class="b-icon">{{svgIcon "chevron-down"}}</span>
        </summary>
        <div class="prose b-answer">{{richText answer}}</div>
      </details>
      {{/each}}
    </div>
  </div>
</section>
