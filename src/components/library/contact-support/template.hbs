<section class="b-contact-support section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-body">
      <ul class="b-options" role="list">
        {{#each options}}
        <li data-field="options.{{@index}}">
          <a class="b-option" href="{{href link}}" {{linkAttrs link}}>
            <span class="b-icon">{{svgIcon icon}}</span>
            <span class="stack b-option-copy"><strong>{{title}}</strong>{{#if text}}<span class="b-muted">{{text}}</span>{{/if}}</span>
            <span class="b-arrow">{{svgIcon "arrow-right"}}</span>
          </a>
        </li>
        {{/each}}
      </ul>
      <form class="card stack b-form" {{#if formAction}}action="{{safeUrl formAction}}" method="{{formMethod}}"{{else}}method="dialog"{{/if}} data-field="formAction">
        <h3 data-field="formTitle">{{formTitle}}</h3>
        <div class="field">
          <label for="{{block.id}}-email" data-field="emailLabel">{{emailLabel}}</label>
          <input id="{{block.id}}-email" type="email" name="email" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="{{block.id}}-topic" data-field="topicLabel">{{topicLabel}}</label>
          <select id="{{block.id}}-topic" name="topic" data-field="topics">
            {{#each topics}}<option>{{label}}</option>{{/each}}
          </select>
        </div>
        <div class="field">
          <label for="{{block.id}}-message" data-field="messageLabel">{{messageLabel}}</label>
          <textarea id="{{block.id}}-message" name="message" rows="4" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" data-field="buttonLabel">{{buttonLabel}}</button>
      </form>
    </div>
  </div>
</section>
