<section class="b-content-lead section" data-align="{{align}}">
  <div class="container">
    <figure class="stack b-figure">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <p class="b-statement" data-field="statement">{{nl2br statement}}</p>
      {{#if attribution}}<figcaption class="b-attribution" data-field="attribution">{{attribution}}</figcaption>{{/if}}
    </figure>
  </div>
</section>
