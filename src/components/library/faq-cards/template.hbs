<section class="b-faq-cards section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="grid b-grid">
      {{#each items}}
      <article class="card stack b-card" data-field="items.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <h3 class="b-question">{{question}}</h3>
        <div class="prose b-answer">{{richText answer}}</div>
      </article>
      {{/each}}
    </div>
    {{#if showButton}}
    <p class="b-more">{{#if moreText}}<span data-field="moreText">{{moreText}}</span> {{/if}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a></p>
    {{/if}}
  </div>
</section>
