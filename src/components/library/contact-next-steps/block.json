{
  "name": "Contact, what happens next",
  "category": "contacts",
  "description": "A message form beside a numbered timeline that shows what happens after someone gets in touch.",
  "tags": ["contact", "form", "steps", "timeline", "sales", "process"],
  "fieldGroups": ["Heading", "Next steps", "Form"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Contact sales",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Tell us what you’re working on",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "No sales scripts and no pressure. A researcher on our team reads every message.",
      "group": "Heading"
    },
    {
      "name": "stepsTitle",
      "label": "Steps title",
      "type": "text",
      "default": "What happens next",
      "group": "Next steps"
    },
    {
      "name": "steps",
      "label": "Steps",
      "type": "list",
      "group": "Next steps",
      "minItems": 0,
      "maxItems": 5,
      "itemLabel": "title",
      "itemFields": [
        { "name": "title", "label": "Title", "type": "text", "default": "Step" },
        { "name": "time", "label": "When", "type": "text", "default": "" },
        { "name": "text", "label": "Text", "type": "text", "default": "" }
      ],
      "default": [
        {
          "title": "We read your message",
          "time": "Within 1 day",
          "text": "A research lead replies with a few questions about your team."
        },
        {
          "title": "A 30-minute call",
          "time": "This week",
          "text": "We look at your current process and show Fieldnote on your kind of interviews."
        },
        {
          "title": "A pilot on real work",
          "time": "Two weeks",
          "text": "Run your next study in Fieldnote, free, with us on hand to help."
        }
      ]
    },
    {
      "name": "nameLabel",
      "label": "Name field label",
      "type": "text",
      "default": "Your name",
      "required": true,
      "group": "Form"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "required": true,
      "group": "Form"
    },
    {
      "name": "messageLabel",
      "label": "Message field label",
      "type": "text",
      "default": "What are you researching?",
      "required": true,
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Send message",
      "required": true,
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        { "value": "post", "label": "POST" },
        { "value": "get", "label": "GET" }
      ],
      "group": "Form"
    }
  ]
}
