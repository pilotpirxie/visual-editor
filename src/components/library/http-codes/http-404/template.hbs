<section class="b-http-404 section">
  <div class="container stack b-inner">
    {{#if eyebrow}}<p class="b-code" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
    <h1 data-field="title">{{title}}</h1>
    {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
    <div class="cluster b-actions">
      <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      {{#if showSecondaryButton}}<a class="btn btn-{{secondaryButton.variant}}" href="{{href secondaryButton.link}}" {{linkAttrs secondaryButton.link}} data-field="secondaryButton">{{secondaryButton.label}}</a>{{/if}}
    </div>
  </div>
</section>
