<section class="b-gallery-products section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="grid b-grid" role="list" style="--cols: {{columns}}">
      {{#each items}}
      <li class="stack b-card" data-field="items.{{@index}}">
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}">
          {{img image}}
          {{#if badge}}<p class="badge b-badge">{{badge}}</p>{{/if}}
        </div>
        <div class="b-body">
          <h3 class="b-name">{{name}}</h3>
          {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
        </div>
        <div class="cluster b-foot">
          <p><span class="b-price">{{price}}</span>{{#if comparePrice}} <s class="b-compare"><span class="visually-hidden">was </span>{{comparePrice}}</s>{{/if}}</p>
          {{#if linkLabel}}<a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{linkLabel}}<span class="visually-hidden">: {{name}}</span>{{svgIcon "arrow-right"}}</a>{{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{#if showButton}}<a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
  </div>
</section>
