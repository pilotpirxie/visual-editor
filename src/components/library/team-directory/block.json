            "alt": "Portrait",
            "decorative": false,
            "width": 800,
            "height": 800,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Name"
        },
        {
          "name": "role",
          "label": "Role",
          "type": "text",
          "default": "Role"
        },
        {
          "name": "city",
          "label": "City",
