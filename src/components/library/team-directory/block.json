{
  "name": "Team, directory",
  "category": "team",
  "description": "A searchable-looking staff table with avatars, roles, cities, time zones and email links.",
  "tags": ["team", "directory", "table", "people", "contacts", "time zones", "remote"],
  "fieldGroups": ["Heading", "Columns", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Directory",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Who to ask about what",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Everyone at Fieldnote, where they work and when they are online. Say hello, we answer email.",
      "group": "Heading"
    },
    {
      "name": "summary",
      "label": "Summary badge",
      "type": "text",
      "default": "28 people in 6 cities",
      "group": "Heading"
    },
    {
      "name": "nameLabel",
      "label": "Name column",
      "type": "text",
      "default": "Name",
      "group": "Columns"
    },
    {
      "name": "roleLabel",
      "label": "Role column",
      "type": "text",
      "default": "Role",
      "group": "Columns"
    },
    {
      "name": "cityLabel",
      "label": "City column",
      "type": "text",
      "default": "City",
      "group": "Columns"
    },
    {
      "name": "zoneLabel",
      "label": "Time zone column",
      "type": "text",
      "default": "Time zone",
      "group": "Columns"
    },
    {
      "name": "emailLabel",
      "label": "Email label",
      "type": "text",
      "default": "Email",
      "group": "Columns",
      "help": "Read by screen readers for the email links."
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 40,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
