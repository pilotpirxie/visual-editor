<section class="b-team-departments section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-departments">
      {{#each departments}}
      <div class="b-department" data-field="departments.{{@index}}">
        <div class="stack b-about">
          <h3 class="b-department-name">{{name}}</h3>
          {{#if description}}<p class="b-description">{{nl2br description}}</p>{{/if}}
        </div>
        <ul class="b-people" role="list">
          {{#each people}}
          <li class="b-person">
            <div class="media b-photo">{{img photo}}</div>
            <div class="b-identity">
              <h4 class="b-name">{{name}}</h4>
              {{#if role}}<p class="b-role">{{role}}</p>{{/if}}
            </div>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </div>
</section>
