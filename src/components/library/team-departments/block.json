{
  "name": "Team, by department",
  "category": "team",
  "description": "People grouped under department headings, each with a short description.",
  "tags": ["team", "people", "departments", "groups", "organization", "about"],
  "fieldGroups": ["Heading", "Departments"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "How we are organized",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Three small teams, one shared backlog",
      "group": "Heading",
      "required": true
