{
  "name": "Testimonials, speech bubbles",
  "category": "testimonials",
  "description": "Customer quotes in comic speech bubbles with thick outlines and tails that point at each speaker, alternating sides.",
  "tags": [
    "testimonials",
    "quotes",
    "speech bubbles",
    "comic",
    "conversation",
    "avatars",
    "playful"
  ],
  "fieldGroups": ["Heading", "Quotes"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Overheard at the counter",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "What riders say when they pick up their bikes",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Ines writes the good ones on the workshop whiteboard. These four have been up there the longest.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Speech bubbles",
      "type": "list",
      "group": "Quotes",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "textarea",
          "default": "Fixed while I waited, and it rides like new."
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Customer name"
        },
        {
          "name": "role",
          "label": "About them",
          "type": "text",
          "default": "City bike, daily rider"
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        }
      ],
      "default": [
        {
