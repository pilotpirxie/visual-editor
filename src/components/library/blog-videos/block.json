{
  "name": "Blog posts, video posts",
  "category": "blog",
  "description": "A featured video with a play button beside a playlist of thumbnails with durations.",
  "tags": ["blog", "posts", "articles", "news", "video", "playlist", "webinar", "thumbnails"],
  "fieldGroups": ["Heading", "Button", "Featured video", "Playlist"],
  "styleOverrides": [
    "--color-background",
    "--color-text",
    "--section-padding-y",
    "--color-surface"
  ],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Watch",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Research skills in under ten minutes",
      "group": "Heading",
      "required": true
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "All videos",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "featuredImage",
      "label": "Thumbnail",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "Yuki Tanaka at a whiteboard covered in sticky notes",
        "decorative": false,
        "width": 1280,
        "height": 720,
        "placeholder": {
          "ratio": "16:9",
          "subject": "photo"
        }
      },
      "group": "Featured video"
    },
    {
      "name": "featuredDuration",
      "label": "Duration",
      "type": "text",
      "default": "8:42",
      "group": "Featured video"
    },
    {
      "name": "featuredCategory",
      "label": "Category",
      "type": "text",
      "default": "Synthesis",
      "group": "Featured video"
    },
    {
      "name": "featuredTitle",
      "label": "Title",
      "type": "text",
      "default": "Affinity mapping 40 interviews in one afternoon",
      "group": "Featured video",
      "required": true
    },
    {
      "name": "featuredText",
      "label": "Text",
      "type": "textarea",
      "default": "Yuki walks through the exact board her team used to go from raw highlights to three roadmap decisions, with the Fieldnote tags that made it fast.",
      "group": "Featured video"
    },
    {
      "name": "featuredLink",
      "label": "Link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Featured video"
    },
    {
      "name": "playlistLabel",
      "label": "Playlist label",
      "type": "text",
      "default": "Up next",
      "group": "Playlist"
    },
    {
      "name": "videos",
      "label": "Videos",
      "type": "list",
      "group": "Playlist",
      "minItems": 1,
      "maxItems": 6,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Thumbnail",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Video thumbnail",
            "decorative": false,
            "width": 1280,
            "height": 720,
            "placeholder": {
              "ratio": "16:9",
              "subject": "photo"
            }
          }
        },
        {
          "name": "duration",
          "label": "Duration",
          "type": "text",
          "default": "5:00"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Video title"
        },
        {
          "name": "meta",
          "label": "Details",
          "type": "text",
          "default": "Speaker name"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Daniel Novak reviewing a printed interview guide",
            "decorative": false,
            "width": 1280,
            "height": 720,
            "placeholder": {
              "ratio": "16:9",
              "subject": "photo"
            }
          },
          "title": "Writing an interview guide that avoids leading questions",
          "meta": "Daniel Novak · Interviewing",
          "duration": "6:15",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A laptop showing a call transcript with colored tags",
            "decorative": false,
            "width": 1280,
            "height": 720,
            "placeholder": {
              "ratio": "16:9",
              "subject": "photo"
            }
          },
          "title": "Tagging a call while you listen",
          "meta": "Ingrid Solberg · Fieldnote tips",
          "duration": "4:08",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A product team watching a short clip on a meeting room screen",
            "decorative": false,
            "width": 1280,
            "height": 720,
            "placeholder": {
              "ratio": "16:9",
              "subject": "photo"
            }
          },
          "title": "Sharing a highlight reel with your exec team",
          "meta": "Leila Haddad · Sharing",
          "duration": "7:30",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    }
  ]
}
