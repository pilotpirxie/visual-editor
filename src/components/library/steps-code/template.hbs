<section class="b-steps-code section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-steps" role="list">
      {{#each steps}}
      <li class="b-step" data-field="steps.{{@index}}">
        <div class="stack b-copy">
          <h3>{{title}}</h3>
          {{#if text}}<p class="b-muted">{{nl2br text}}</p>{{/if}}
        </div>
        <pre class="b-code" tabindex="0"><code>{{code}}</code></pre>
      </li>
      {{/each}}
    </ol>
    {{#if showGuide}}
    <a class="btn btn-{{guideButton.variant}} b-guide" href="{{href guideButton.link}}" {{linkAttrs guideButton.link}} data-field="guideButton">{{guideButton.label}}{{svgIcon "arrow-right"}}</a>
    {{/if}}
  </div>
</section>
