{
  "name": "Utilities, divider with icon",
  "category": "utilities",
  "description": "A horizontal rule broken by an icon in a circle, to mark a change of topic on a long page.",
  "tags": ["divider", "separator", "rule", "line", "icon", "circle", "utility"],
  "fieldGroups": ["Icon", "Layout"],
  "styleOverrides": ["--color-background", "--color-text", "--color-primary"],
  "fields": [
    {
      "name": "icon",
      "label": "Icon",
      "type": "icon",
      "default": "sparkles",
      "group": "Icon"
    },
    {
      "name": "style",
      "label": "Circle style",
      "type": "select",
      "default": "outline",
      "group": "Icon",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "soft",
          "label": "Soft tint"
        },
        {
          "value": "filled",
          "label": "Filled"
        }
      ]
    },
    {
      "name": "spacing",
      "label": "Space around",
      "type": "select",
      "default": "medium",
      "group": "Layout",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    }
  ]
}
