<section class="b-stats-image section"{{#if countUp}} data-behavior="counter"{{/if}}>
  <div class="b-backdrop" data-field="image">{{img image}}</div>
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="badge b-eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <dl class="b-stats">
      {{#each stats}}
      <div class="b-stat" data-field="stats.{{@index}}">
        <dt class="b-label">{{label}}</dt>
        <dd class="b-value"{{#if ../countUp}} data-count{{/if}}>{{value}}</dd>
      </div>
      {{/each}}
    </dl>
  </div>
</section>
