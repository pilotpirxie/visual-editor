<section class="b-stats-row section"{{#if countUp}} data-behavior="counter"{{/if}}>
  <div class="container">
    <dl class="b-stats">
      {{#each stats}}
      <div class="b-stat" data-field="stats.{{@index}}">
        <dt class="b-label">{{label}}</dt>
        <dd class="b-value"{{#if ../countUp}} data-count{{/if}}>{{value}}</dd>
      </div>
      {{/each}}
    </dl>
  </div>
</section>
