<section class="b-logos-stat section">
  <div class="container b-inner">
    <div class="stack b-head">
      <h2 class="b-title">{{#if value}}<span class="b-value" data-field="value">{{value}}</span> {{/if}}<span data-field="title">{{title}}</span></h2>
      {{#if ratingText}}
      <p class="b-rating" data-field="rating">
        <span class="b-stars" style="--rating: {{rating}}" aria-hidden="true">★★★★★</span>
        <span><strong>{{rating}}</strong> <span data-field="ratingText">{{ratingText}}</span></span>
      </p>
      {{/if}}
    </div>
    <ul class="b-logos" role="list">
      {{#each logos}}
      <li class="b-logo" data-field="logos.{{@index}}">{{img image}}</li>
      {{/each}}
    </ul>
  </div>
</section>
