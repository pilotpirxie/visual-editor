<section class="b-content-events section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="stack b-list" role="list">
      {{#each events}}
      <li class="card b-event" data-field="events.{{@index}}">
        {{#if date}}<time class="b-date" datetime="{{date}}">{{formatDate date}}</time>{{/if}}
        <div class="stack b-body">
          <div class="b-title-row">
            <h3>{{title}}</h3>
            {{#if tag}}<span class="badge">{{tag}}</span>{{/if}}
          </div>
          {{#if (or time location)}}
          <ul class="cluster b-meta" role="list">
            {{#if time}}<li>{{svgIcon "clock"}}<span>{{time}}</span></li>{{/if}}
            {{#if location}}<li>{{svgIcon "map-pin"}}<span>{{location}}</span></li>{{/if}}
          </ul>
          {{/if}}
          {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
        </div>
        {{#if linkLabel}}<a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{linkLabel}}<span class="visually-hidden">, {{title}}</span>{{svgIcon "arrow-right"}}</a>{{/if}}
      </li>
      {{/each}}
    </ol>
    {{#if showButton}}<a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{svgIcon "calendar"}}{{button.label}}</a>{{/if}}
  </div>
</section>
