{
  "name": "Team, centered circles",
  "category": "team",
  "description": "A centered heading and round photos with names, roles and social links.",
  "tags": ["team", "people", "about", "avatars", "social", "centered"],
  "fieldGroups": ["Heading", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
