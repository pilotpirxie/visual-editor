{
  "name": "Gallery, clothesline",
  "category": "gallery",
  "description": "Photos pegged to a washing line, tilted alternately, with a short caption under each.",
  "tags": ["gallery", "photos", "clothesline", "pegs", "hanging", "playful", "captions"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "This week at Muddy Paws",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Hung out to dry after the sprinkler",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Every Friday we print the week’s best daycare photos and peg them up in reception. Owners take theirs home at pick-up.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 2,
      "maxItems": 8,
      "itemLabel": "caption",
