<section class="b-contact-offices section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="grid b-grid">
      {{#each offices}}
      <article class="card b-office" data-field="offices.{{@index}}">
        <div class="media b-photo">{{img image}}</div>
        <div class="stack b-body">
          <h3>{{city}}{{#if label}} <span class="badge">{{label}}</span>{{/if}}</h3>
          {{#if address}}<address class="b-address">{{nl2br address}}</address>{{/if}}
          <ul class="stack b-links" role="list">
            {{#if phone}}<li>{{svgIcon "phone"}}<a href="tel:{{phone}}">{{phone}}</a></li>{{/if}}
            {{#if email}}<li>{{svgIcon "mail"}}<a href="mailto:{{email}}">{{email}}</a></li>{{/if}}
          </ul>
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
