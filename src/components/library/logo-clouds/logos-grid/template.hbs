<section class="b-logos-grid section">
  <div class="container b-inner">
    <header class="stack b-head">
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
    </header>
    <ul class="b-logos" role="list">
      {{#each logos}}
      <li class="b-tile" data-field="logos.{{@index}}">{{img image}}</li>
      {{/each}}
    </ul>
  </div>
</section>
