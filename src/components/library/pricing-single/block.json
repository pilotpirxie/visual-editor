{
  "name": "Pricing, single plan",
  "category": "pricing",
  "description": "One plan in a centered card with its price, what is included and a button.",
  "tags": ["pricing", "plan", "single", "simple", "card"],
  "fieldGroups": ["Heading", "Plan"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "One plan, everything included",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Pay for editors, invite viewers for free",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "price",
      "label": "Price",
      "type": "text",
      "default": "$29",
      "group": "Plan"
    },
    {
      "name": "period",
      "label": "Period",
      "type": "text",
      "default": "per editor, per month",
      "group": "Plan"
    },
    {
      "name": "features",
      "label": "Included",
      "type": "richtext",
      "default": "<ul><li>Unlimited interviews and transcripts</li><li>Themes, highlights and clips</li><li>Unlimited viewers</li><li>Exports to Notion, Jira and Slack</li></ul>",
      "group": "Plan"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Plan"
    },
    {
      "name": "note",
      "label": "Note",
      "type": "text",
      "default": "Billed monthly. Cancel any time.",
      "group": "Plan"
    }
  ]
}
