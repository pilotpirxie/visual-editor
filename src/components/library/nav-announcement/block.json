{
  "name": "Navigation, with announcement",
  "category": "navigations",
  "description": "A striped announcement line that links to your news, above a navbar with links and a button; a menu button below 1024 px.",
  "tags": ["menu", "navbar", "header", "announcement", "news", "launch", "promo", "banner"],
  "fieldGroups": ["Announcement", "Links", "Button", "Menu"],
  "styleOverrides": [
    "--color-background",
    "--color-text",
    "--color-primary",
    "--color-primary-contrast"
  ],
  "fields": [
    {
      "name": "badge",
      "label": "Badge",
      "type": "text",
      "default": "New",
      "maxLength": 12,
      "group": "Announcement"
    },
    {
      "name": "announcement",
      "label": "Announcement",
      "type": "text",
      "default": "Fieldnote AI now drafts your interview summaries in 14 languages",
      "required": true,
      "maxLength": 100,
      "help": "Stays on one line; long text is cut off on phones.",
      "group": "Announcement"
    },
    {
      "name": "announcementLink",
      "label": "Announcement link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Announcement"
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 6,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Features",
          "link": {
            "type": "section",
            "anchor": "features",
            "newTab": false
          }
        },
        {
          "label": "Pricing",
          "link": {
            "type": "section",
            "anchor": "pricing",
            "newTab": false
          }
        },
        {
          "label": "Customers",
          "link": {
            "type": "section",
            "anchor": "customers",
            "newTab": false
          }
        },
        {
          "label": "Blog",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "showCta",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "cta",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "visibleWhen": {
        "field": "showCta",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "menuIcon",
      "label": "Menu icon",
      "type": "icon",
      "default": "menu",
      "group": "Menu"
    }
  ]
}
