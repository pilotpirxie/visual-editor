<section class="b-gallery-collage section">
  <div class="container b-inner">
    <div class="stack b-copy">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
      {{#if showButton}}
      <div class="cluster b-actions">
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
      </div>
      {{/if}}
    </div>
    <div class="b-collage">
      <div class="media b-photo" data-field="firstPhoto">{{img firstPhoto}}</div>
      <div class="media b-photo" data-field="secondPhoto">{{img secondPhoto}}</div>
      <div class="media b-photo" data-field="thirdPhoto">{{img thirdPhoto}}</div>
    </div>
  </div>
</section>
