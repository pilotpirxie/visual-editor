{
  "name": "Gallery, text and collage",
  "category": "gallery",
  "description": "Text and a button beside a collage of three overlapping photos.",
  "tags": ["gallery", "photos", "images", "collage", "about", "story", "split"],
  "fieldGroups": ["Content", "Button", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Our office",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "A studio built for listening",
      "group": "Content",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Our King Street office has two soundproof booths, a long table for affinity mapping and a wall of customer quotes. Customers and candidates are always welcome to visit.",
      "group": "Content"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Plan a visit",
        "link": {
          "type": "email",
          "url": "hello@fieldnote.example",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "firstPhoto",
      "label": "First photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "Two soundproof interview booths with glass doors",
        "decorative": false,
        "width": 1200,
        "height": 900,
        "placeholder": {
          "ratio": "4:3",
          "subject": "photo"
        }
      }
    },
    {
      "name": "secondPhoto",
      "label": "Second photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "A wall covered in printed customer quotes",
        "decorative": false,
        "width": 900,
        "height": 1200,
        "placeholder": {
          "ratio": "3:4",
          "subject": "photo"
        }
      }
    },
    {
      "name": "thirdPhoto",
      "label": "Third photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "A long wooden table with laptops and sticky notes",
        "decorative": false,
        "width": 1200,
        "height": 900,
        "placeholder": {
          "ratio": "4:3",
          "subject": "photo"
        }
      }
    }
  ]
}
