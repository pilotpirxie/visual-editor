{
  "name": "Gallery, fanned cards",
  "category": "gallery",
  "description": "Three to five numbered photo cards spread like a hand of playing cards, and a two-column grid on phones.",
  "tags": ["gallery", "photos", "fan", "cards", "hand", "playful", "rotated"],
  "fieldGroups": ["Heading", "Cards"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "The winter five",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Pick a card, any card",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Only five drinks make the list each season at Low Tide. Point at one and Inès will have it in front of you in four minutes.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Cards",
      "type": "list",
      "group": "Cards",
      "minItems": 3,
      "maxItems": 5,
      "itemLabel": "caption",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
