<section class="b-content-values section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
    </header>
    <ul class="b-values" role="list">
      {{#each values}}
      <li class="stack b-value" data-field="values.{{@index}}">
        {{#if icon}}<span class="b-icon">{{svgIcon icon}}</span>{{/if}}
        <h3>{{title}}</h3>
        <p class="b-text">{{nl2br text}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
