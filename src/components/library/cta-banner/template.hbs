<section class="b-cta-banner section">
  <div class="container b-inner">
    <div class="stack b-copy">
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{text}}</p>{{/if}}
    </div>
    <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
  </div>
</section>
