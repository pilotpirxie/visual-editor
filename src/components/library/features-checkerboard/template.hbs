<section class="b-features-checkerboard section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-board">
      {{#each items}}
      <article class="b-row" data-field="items.{{@index}}">
        <div class="b-media">{{img image}}</div>
        <div class="stack b-copy">
          {{#if label}}<p class="b-label">{{label}}</p>{{/if}}
          <h3>{{title}}</h3>
          <p class="b-text">{{nl2br text}}</p>
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
