<section class="b-testimonial-billboard section">
  <div class="b-band">
    <figure class="container stack b-figure">
      <blockquote class="b-quote">
        <p><span data-field="before">{{before}}</span> <mark class="b-mark" data-field="highlight">{{highlight}}</mark> <span data-field="after">{{after}}</span></p>
      </blockquote>
      <figcaption class="b-credit">
        <span class="b-name" data-field="name">{{name}}</span>
        {{#if role}}<span data-field="role">{{role}}</span>{{/if}}
      </figcaption>
    </figure>
  </div>
</section>
