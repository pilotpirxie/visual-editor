<section class="b-features-links section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-grid" role="list" style="--cols: {{columns}}">
      {{#each items}}
      <li data-field="items.{{@index}}">
        <a class="stack b-card" href="{{href link}}" {{linkAttrs link}}>
          <h3>{{title}}</h3>
          <p class="b-muted">{{nl2br text}}</p>
          <span class="b-arrow">{{svgIcon "arrow-right"}}</span>
        </a>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
