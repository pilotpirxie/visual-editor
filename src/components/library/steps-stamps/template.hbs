<section class="b-steps-stamps section">
  <div class="container stack">
    <header class="stack">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-card">
      <p class="b-top">
        <strong data-field="cardTitle">{{cardTitle}}</strong>
        {{#if cardNote}}<span data-field="cardNote">{{cardNote}}</span>{{/if}}
      </p>
      <ol class="b-stamps" role="list">
        {{#each steps}}
        <li data-field="steps.{{@index}}">
          <span class="b-stamp" aria-hidden="true">{{stamp}}</span>
          <h3>{{title}}</h3>
          <p>{{nl2br text}}</p>
        </li>
        {{/each}}
      </ol>
    </div>
  </div>
</section>
