      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Customer stories",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Where Fieldnote gets used",
      "group": "Heading",
      "required": true
