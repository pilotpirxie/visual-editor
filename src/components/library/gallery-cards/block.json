{
  "name": "Gallery, captioned cards",
  "category": "gallery",
  "description": "Photos in cards with a small tag, a title and a short description under each.",
  "tags": ["gallery", "photos", "images", "cards", "captions", "portfolio", "grid"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
