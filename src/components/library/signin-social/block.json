{
  "name": "Sign in, with social accounts",
  "category": "sign-in",
  "description": "A card with buttons to continue with Google, Microsoft or Apple, then email and password.",
  "tags": ["sign in", "login", "log in", "account", "social", "google", "single sign-on", "form"],
  "fieldGroups": ["Heading", "Accounts", "Form", "Links"],
  "styleOverrides": [
    "--color-background",
    "--color-surface",
    "--color-text",
    "--section-padding-y"
  ],
  "fields": [
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Welcome back",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Sign in to pick up your interviews, tags and highlight reels where you left them.",
      "group": "Heading"
    },
    {
      "name": "providers",
      "label": "Account buttons",
      "type": "list",
      "group": "Accounts",
      "minItems": 0,
      "maxItems": 4,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Continue with your account"
        },
        {
          "name": "icon",
          "label": "Logo",
          "type": "icon",
          "default": "key",
          "iconPurpose": "brand"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Continue with Google",
          "icon": "simple-icons:google",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Continue with Microsoft",
          "icon": "simple-icons:microsoft",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Continue with Apple",
          "icon": "simple-icons:apple",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "dividerLabel",
      "label": "Divider label",
      "type": "text",
      "default": "or sign in with email",
      "group": "Accounts"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "required": true,
      "group": "Form"
    },
    {
      "name": "passwordLabel",
      "label": "Password field label",
      "type": "text",
      "default": "Password",
      "required": true,
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Sign in",
      "required": true,
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    },
    {
      "name": "forgotLabel",
      "label": "Forgot password label",
      "type": "text",
      "default": "Forgot your password?",
      "group": "Links"
    },
    {
      "name": "forgotLink",
      "label": "Forgot password link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Links"
    },
    {
      "name": "signUpText",
      "label": "Sign up text",
      "type": "text",
      "default": "New to Fieldnote?",
      "group": "Links"
    },
    {
      "name": "signUpLabel",
      "label": "Sign up link label",
      "type": "text",
      "default": "Start a free trial",
      "group": "Links"
    },
    {
      "name": "signUpLink",
      "label": "Sign up link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Links"
    }
  ]
}
