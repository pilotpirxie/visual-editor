<section class="b-app-platforms section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="grid b-grid" role="list">
      {{#each items}}
      <li data-field="items.{{@index}}">
        <a class="card stack b-card" href="{{href link}}" {{linkAttrs link}}>
          <span class="b-icon">{{svgIcon icon}}</span>
          <h3>{{name}}</h3>
          {{#if note}}<p class="b-note">{{note}}</p>{{/if}}
          <span class="b-link">{{linkLabel}}{{svgIcon "arrow-right"}}</span>
        </a>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
