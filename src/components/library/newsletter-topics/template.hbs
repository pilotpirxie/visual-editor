<section class="b-newsletter-topics section">
  <div class="container b-inner">
    <header class="stack b-copy">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
    </header>
    <form class="card stack b-form" {{#if formAction}}action="{{safeUrl formAction}}" method="{{formMethod}}"{{else}}method="dialog"{{/if}} data-field="formAction">
      <div class="field">
        <label for="{{block.id}}-email" data-field="emailLabel">{{emailLabel}}</label>
        <input id="{{block.id}}-email" type="email" name="email" autocomplete="email" required placeholder="{{emailPlaceholder}}">
      </div>
      {{#if topics.length}}
      <fieldset class="b-topics">
        <legend class="b-legend" data-field="topicsLabel">{{topicsLabel}}</legend>
        <div class="b-options">
          {{#each topics}}
          <div class="field-check" data-field="topics.{{@index}}">
            <input id="{{../block.id}}-topic-{{@index}}" type="checkbox" name="topics" value="{{label}}">
            <label for="{{../block.id}}-topic-{{@index}}">{{label}}</label>
          </div>
          {{/each}}
        </div>
      </fieldset>
      {{/if}}
      <button type="submit" class="btn btn-primary" data-field="buttonLabel">{{buttonLabel}}</button>
      {{#if note}}<p class="b-note" data-field="note">{{note}}</p>{{/if}}
    </form>
  </div>
</section>
