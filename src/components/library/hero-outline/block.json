{
  "name": "Hero, outlined type",
  "category": "headers",
  "description": "Oversized two-line heading with one solid and one outlined line, a short intro, buttons and key facts.",
  "tags": ["hero", "heading", "big type", "outline", "typography", "bold", "statement"],
  "fieldGroups": ["Heading", "Buttons", "Facts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Customer research platform",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Listen closer.",
      "group": "Heading",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "outlineTitle",
      "label": "Outlined line",
      "type": "text",
      "default": "Build better.",
      "group": "Heading",
      "maxLength": 80
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Fieldnote gives product teams one place to record interviews, find the patterns and share what customers actually said.",
      "group": "Heading"
    },
    {
      "name": "primaryButton",
      "label": "Primary button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Buttons"
    },
    {
      "name": "showSecondary",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Buttons"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "Book a demo",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Buttons",
      "visibleWhen": {
        "field": "showSecondary",
        "equals": true
      }
    },
    {
      "name": "facts",
      "label": "Facts",
      "type": "list",
      "group": "Facts",
      "minItems": 0,
      "maxItems": 4,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "value",
          "label": "Number",
          "type": "text",
          "default": "100"
        },
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "things"
        }
      ],
      "default": [
        {
          "value": "4,200",
          "label": "research teams"
        },
        {
          "value": "38",
          "label": "languages transcribed"
        },
        {
          "value": "SOC 2",
          "label": "Type II certified"
        }
      ]
    }
  ]
}
