{
  "name": "Content, topic links",
  "category": "content",
  "description": "A centered cloud of linked topic chips in three sizes, each with an optional count.",
  "tags": ["topics", "tags", "chips", "categories", "cloud", "links", "explore"],
  "fieldGroups": ["Heading", "Topics"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Explore",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "What customers talk to us about",
      "group": "Heading",
      "required": true,
      "maxLength": 140
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "The themes that came up most across 310,000 recorded interviews. Pick one to hear the clips.",
      "group": "Heading"
    },
    {
      "name": "topics",
      "label": "Topics",
      "type": "list",
      "group": "Topics",
      "minItems": 1,
      "maxItems": 24,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Topic"
        },
        {
          "name": "count",
          "label": "Count",
          "type": "text",
          "default": ""
        },
        {
          "name": "size",
          "label": "Size",
          "type": "select",
          "default": "small",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
