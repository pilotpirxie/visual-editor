<section class="b-content-topics section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-cloud" role="list">
      {{#each topics}}
      <li data-field="topics.{{@index}}">
        <a class="b-topic" href="{{href link}}" {{linkAttrs link}} data-size="{{size}}">
          <span>{{label}}</span>
          {{#if count}}<span class="b-count">{{count}}</span>{{/if}}
        </a>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
