{
  "name": "Newsletter, card with image",
  "category": "newsletters",
  "description": "A card with an image on one side and a newsletter pitch and email form on the other.",
  "tags": ["newsletter", "email", "subscribe", "signup", "form", "card", "image"],
  "fieldGroups": ["Heading", "Form", "Image"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "The Fieldnote letter",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Better customer interviews, one issue at a time",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Each month we take apart one real research project: the questions the team asked, what surprised them and what they shipped next.",
      "group": "Heading"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Email address",
      "required": true,
      "group": "Form"
    },
    {
      "name": "emailPlaceholder",
      "label": "Email placeholder",
      "type": "text",
      "default": "you@company.com",
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Subscribe",
      "required": true,
      "group": "Form"
    },
    {
      "name": "note",
      "label": "Privacy note",
      "type": "text",
      "default": "One email a month. Unsubscribe any time.",
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    },
    {
      "name": "image",
      "label": "Image",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "A researcher taking notes during a video interview with a customer",
        "decorative": false,
        "width": 1200,
        "height": 900,
        "placeholder": {
          "ratio": "4:3",
          "subject": "photo"
        }
      },
      "group": "Image"
    },
    {
      "name": "imageSide",
      "label": "Image side",
      "type": "segmented",
      "default": "left",
      "group": "Image",
      "options": [
        {
          "value": "left",
          "label": "Left",
          "icon": "panel-left"
        },
        {
          "value": "right",
          "label": "Right",
          "icon": "panel-right"
        }
      ]
    }
  ]
}
