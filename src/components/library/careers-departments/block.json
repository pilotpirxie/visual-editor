            {
              "name": "title",
              "label": "Job title",
              "type": "text",
              "default": "Job title"
            },
            {
              "name": "location",
              "label": "Location",
              "type": "text",
              "default": "Remote"
            },
            {
              "name": "type",
              "label": "Type",
              "type": "text",
              "default": "Full-time"
            },
            {
              "name": "link",
              "label": "Link",
              "type": "link",
              "default": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            }
          ],
          "default": []
        }
      ],
      "default": [
