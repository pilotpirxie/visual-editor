<section class="b-app-reviews section">
  <div class="container stack b-inner">
    <div class="b-top">
      <header class="stack b-head">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
        {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
        {{#if stores.length}}
        <ul class="cluster b-stores" role="list">
          {{#each stores}}
          <li><a class="btn btn-secondary" href="{{href link}}" {{linkAttrs link}} data-field="stores.{{@index}}">{{svgIcon icon}}<span>{{label}}</span></a></li>
          {{/each}}
        </ul>
        {{/if}}
      </header>
      <div class="card stack b-score">
        <p class="b-value" data-field="rating">{{rating}}<span class="visually-hidden"> {{starsLabel}}</span></p>
        <span class="b-stars" style="--rating: {{rating}}" aria-hidden="true">★★★★★</span>
        {{#if ratingNote}}<p class="b-muted" data-field="ratingNote">{{ratingNote}}</p>{{/if}}
        {{#if award}}<p class="b-award" data-field="award">{{svgIcon "award"}}<span>{{award}}</span></p>{{/if}}
      </div>
    </div>
    <ul class="grid b-reviews" role="list">
      {{#each reviews}}
      <li class="card stack b-review" data-field="reviews.{{@index}}">
        <p><span class="b-stars" style="--rating: {{rating}}" aria-hidden="true">★★★★★</span><span class="visually-hidden">{{rating}} {{../starsLabel}}</span></p>
        <h3>{{title}}</h3>
        <p class="b-text">{{nl2br text}}</p>
        <p class="b-muted"><strong class="b-author">{{author}}</strong>{{#if meta}} · {{meta}}{{/if}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
