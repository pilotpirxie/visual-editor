<section class="b-features-playing-cards section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-text" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-hand" role="list" style="--n: {{items.length}}">
      {{#each items}}
      <li class="b-card" data-field="items.{{@index}}" style="--i: {{@index}}">
        <span class="b-pip" aria-hidden="true">{{rank}}{{svgIcon icon}}</span>
        <div class="b-face">
          <h3>{{name}}</h3>
          <p class="b-text">{{text}}</p>
        </div>
        <span class="b-pip" aria-hidden="true">{{rank}}{{svgIcon icon}}</span>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
