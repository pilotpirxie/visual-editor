{
  "name": "Contact, live map and hours",
  "category": "contacts",
  "description": "A live map from Google Maps or OpenStreetMap beside the address, phone, email and a table of opening hours, with a directions button.",
  "tags": [
    "contact",
    "map",
    "google maps",
    "openstreetmap",
    "location",
    "address",
    "opening hours",
    "hours",
    "directions",
    "find us",
    "visit",
    "local business"
  ],
  "fieldGroups": ["Heading", "Details", "Hours", "Map"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Visit us",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Come by the studio",
      "group": "Heading",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Walk in during opening hours or book a session ahead. Street parking is free after six.",
      "group": "Heading"
    },
    {
      "name": "address",
      "label": "Address",
      "type": "textarea",
      "default": "220 King Street West, Suite 400\nToronto, ON M5H 1K4",
      "group": "Details",
      "help": "Google Maps shows this address."
    },
    {
      "name": "phone",
      "label": "Phone",
      "type": "text",
      "default": "+1 416 555 0142",
      "group": "Details"
    },
    {
      "name": "email",
      "label": "Email",
      "type": "text",
      "default": "studio@fieldnote.example",
      "group": "Details"
    },
    {
      "name": "hoursTitle",
      "label": "Hours title",
      "type": "text",
      "default": "Opening hours",
      "group": "Hours",
      "required": true
    },
    {
      "name": "hours",
      "label": "Opening hours",
      "type": "list",
      "group": "Hours",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "days",
      "default": [
        {
          "days": "Monday to Thursday",
          "time": "9:00 to 18:00"
        },
        {
          "days": "Friday",
          "time": "9:00 to 16:00"
        },
        {
          "days": "Saturday",
          "time": "By appointment"
        },
        {
          "days": "Sunday",
          "time": "Closed"
        }
      ],
      "itemFields": [
        {
          "name": "days",
          "label": "Days",
          "type": "text",
          "default": "Monday"
        },
        {
          "name": "time",
          "label": "Hours",
          "type": "text",
          "default": "9:00 to 17:00"
        }
      ]
    },
    {
      "name": "note",
      "label": "Note",
      "type": "text",
      "default": "Closed on public holidays.",
      "group": "Hours"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Map"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Get directions",
        "link": {
          "type": "url",
          "url": "https://www.openstreetmap.org",
          "newTab": true
        },
        "variant": "secondary"
      },
      "group": "Map",
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      }
    },
    {
      "name": "mapService",
      "label": "Map service",
      "type": "select",
      "default": "google",
      "group": "Map",
      "options": [
        {
          "value": "google",
          "label": "Google Maps"
        },
        {
          "value": "osm",
          "label": "OpenStreetMap"
        }
      ],
      "help": "Google Maps finds the address. OpenStreetMap needs the position below."
    },
    {
      "name": "mapLatitude",
      "label": "Latitude",
      "type": "number",
      "default": 43.6465,
      "min": -85,
      "max": 85,
      "step": 0.0001,
      "group": "Map",
      "visibleWhen": {
        "field": "mapService",
        "equals": "osm"
      }
    },
    {
      "name": "mapLongitude",
      "label": "Longitude",
      "type": "number",
      "default": -79.3871,
      "min": -180,
      "max": 180,
      "step": 0.0001,
      "group": "Map",
      "visibleWhen": {
        "field": "mapService",
        "equals": "osm"
      }
    },
    {
      "name": "mapZoom",
      "label": "Zoom",
      "type": "range",
      "default": 15,
      "min": 3,
      "max": 19,
      "step": 1,
      "group": "Map"
    },
    {
      "name": "mapKey",
      "label": "Google Maps API key",
      "type": "text",
      "default": "",
      "group": "Map",
      "help": "Optional. Without a key the free Google Maps embed is used.",
      "visibleWhen": {
        "field": "mapService",
        "equals": "google"
      }
    }
  ]
}
