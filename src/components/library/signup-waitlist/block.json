{
  "name": "Sign up, waitlist",
  "category": "sign-up",
  "description": "A waitlist email form beside a ticket that previews the visitor’s place in line and how to move up by inviting friends.",
  "tags": ["sign up", "waitlist", "early access", "beta", "referral", "ticket", "form"],
  "fieldGroups": ["Heading", "Form", "Ticket"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Early access",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Fieldnote Live is invite-only, for now",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Live transcription and tagging during the call. We let in a new group of teams every Monday.",
      "group": "Heading"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Work email",
      "required": true,
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Join the waitlist",
      "required": true,
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        {
          "value": "post",
          "label": "POST"
        },
        {
          "value": "get",
          "label": "GET"
        }
      ],
      "group": "Form"
    },
    {
      "name": "note",
      "label": "Note",
      "type": "text",
      "default": "One email when your spot opens. Nothing else.",
      "group": "Form"
    },
    {
      "name": "ticketLabel",
      "label": "Ticket label",
      "type": "text",
      "default": "Your place in line",
      "group": "Ticket"
    },
    {
      "name": "position",
      "label": "Position",
      "type": "text",
      "default": "#2,481",
      "required": true,
      "group": "Ticket"
    },
    {
      "name": "facts",
      "label": "Ticket details",
      "type": "list",
      "group": "Ticket",
      "minItems": 0,
      "maxItems": 3,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Label"
        },
        {
          "name": "value",
          "label": "Value",
          "type": "text",
          "default": "Value"
        }
      ],
      "default": [
        {
          "label": "Joined",
          "value": "Today"
        },
        {
          "label": "Access",
          "value": "Spring 2027"
        }
      ]
    },
    {
      "name": "skipIcon",
      "label": "Referral icon",
      "type": "icon",
      "default": "gift",
      "group": "Ticket"
    },
    {
      "name": "skipTitle",
      "label": "Referral title",
      "type": "text",
      "default": "Skip the line.",
      "group": "Ticket"
    },
    {
      "name": "skipText",
      "label": "Referral text",
      "type": "text",
      "default": "Every teammate who joins with your link moves you up 50 spots.",
      "group": "Ticket"
    }
  ]
}
