{
  "name": "Gallery, one large and four small",
  "category": "gallery",
  "description": "A heading, one large photo and four smaller ones in a tidy grid, with short captions.",
  "tags": ["gallery", "photos", "images", "featured", "grid", "mosaic"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Field visits",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "A day with the Ledgerly finance team",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "We spent a day watching month-end close at Ledgerly. These moments changed our roadmap.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 3,
      "maxItems": 9,
      "itemLabel": "caption",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
