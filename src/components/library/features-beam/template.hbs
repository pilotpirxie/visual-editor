<section class="b-features-beam section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="grid b-grid" role="list">
      {{#each items}}
      <li class="b-card" {{#if featured}}data-featured{{/if}} data-field="items.{{@index}}">
        <div class="stack b-body">
          <p class="b-top"><span class="icon b-icon">{{svgIcon icon}}</span>{{#if badge}}<span class="badge">{{badge}}</span>{{/if}}</p>
          <h3>{{title}}</h3>
          <p class="b-text">{{nl2br text}}</p>
        </div>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
