<section class="b-gallery-arches section">
  <div class="container stack b-inner">
    <header class="b-head">
      <div class="stack b-heading">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
      </div>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-row" role="list">
      {{#each items}}
      <li class="b-item" data-field="items.{{@index}}">
        <figure class="stack b-figure">
          <div class="media b-arch">{{img image}}</div>
          <figcaption class="b-caption">
            <span class="b-title">{{title}}</span>
            {{#if text}}<span class="b-text">{{text}}</span>{{/if}}
          </figcaption>
        </figure>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
