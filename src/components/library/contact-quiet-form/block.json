{
  "name": "Contact, quiet form",
  "category": "contacts",
  "description": "A narrow single-column message form with underline-only inputs, small labels and generous whitespace.",
  "tags": ["contact", "form", "minimal", "calm", "underline", "whitespace", "message"],
  "fieldGroups": ["Heading", "Form"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Write whenever you are ready",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "A first class, an old injury, the Sunday retreat in March. Leave a few lines and Mira will write back, usually the next morning.",
      "group": "Heading"
    },
    {
      "name": "nameLabel",
      "label": "Name field label",
      "type": "text",
      "default": "Your name",
      "required": true,
      "group": "Form"
    },
    {
      "name": "emailLabel",
      "label": "Email field label",
      "type": "text",
      "default": "Email address",
      "required": true,
      "group": "Form"
    },
    {
      "name": "messageLabel",
      "label": "Message field label",
      "type": "text",
      "default": "What would you like to ask?",
      "required": true,
      "group": "Form"
    },
    {
      "name": "buttonLabel",
      "label": "Button label",
      "type": "text",
      "default": "Send",
      "required": true,
      "group": "Form"
    },
    {
      "name": "note",
      "label": "Note beside the button",
      "type": "textarea",
      "default": "No mailing list. Stillwater Yoga uses your address for this reply only.",
      "group": "Form"
    },
    {
      "name": "formAction",
      "label": "Form action URL",
      "type": "text",
      "default": "",
      "group": "Form"
    },
    {
      "name": "formMethod",
      "label": "Method",
      "type": "select",
      "default": "post",
      "options": [
        { "value": "post", "label": "POST" },
        { "value": "get", "label": "GET" }
      ],
      "group": "Form"
    }
  ]
}
