{
  "name": "Blog posts, topic filter",
  "category": "blog",
  "description": "A grid of posts under a row of topic chips: picking a chip shows only the posts of that topic, with no script.",
  "tags": ["blog", "posts", "articles", "filter", "topics", "chips", "categories", "smart"],
  "fieldGroups": ["Heading", "Topics", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Garden notes",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "What to do in the garden this month",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Advice from the potting bench at Fernhill Nursery. Pick a topic or read the lot.",
      "group": "Heading"
    },
    {
      "name": "filterLabel",
      "label": "Filter label for screen readers",
      "type": "text",
      "default": "Show posts about",
      "group": "Topics",
      "required": true
    },
    {
      "name": "allLabel",
      "label": "Label for all posts",
      "type": "text",
      "default": "All",
      "group": "Topics",
      "required": true
    },
    {
      "name": "topic1",
      "label": "Topic 1",
      "type": "text",
      "default": "Planting",
      "group": "Topics",
      "required": true
    },
    {
      "name": "topic2",
      "label": "Topic 2",
      "type": "text",
      "default": "Care",
      "group": "Topics",
      "required": true
    },
    {
      "name": "topic3",
      "label": "Topic 3",
      "type": "text",
      "default": "Harvest",
      "group": "Topics",
      "required": true
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "topic",
          "label": "Topic",
          "type": "select",
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": "Topic 1"
            },
            {
              "value": "2",
              "label": "Topic 2"
            },
            {
              "value": "3",
              "label": "Topic 3"
            }
          ]
        },
        {
          "name": "image",
          "label": "Image",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Cover image",
            "decorative": false,
            "width": 1200,
            "height": 800,
            "placeholder": {
              "ratio": "3:2",
              "subject": "photo"
            }
          }
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "One job for the garden this week"
        },
        {
          "name": "excerpt",
          "label": "Excerpt",
          "type": "textarea",
          "default": "Two sentences on what to do and when to do it."
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
