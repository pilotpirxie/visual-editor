<section class="b-pricing-2-plans section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-plans">
      {{#each plans}}
      <article class="card stack b-plan" {{#if featured}}data-featured{{/if}} data-field="plans.{{@index}}">
        <div class="cluster b-plan-head">
          <h3>{{name}}</h3>
          {{#if featured}}{{#if ../featuredLabel}}<p class="badge">{{../featuredLabel}}</p>{{/if}}{{/if}}
        </div>
        <p><span class="b-amount">{{price}}</span> <span class="b-muted">{{period}}</span></p>
        {{#if description}}<p class="b-muted">{{nl2br description}}</p>{{/if}}
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}}>{{button.label}}</a>
        <div class="stack b-included">
          {{#if lead}}<p><strong>{{lead}}</strong></p>{{/if}}
          <ul class="b-features" role="list">
            {{#each features}}
            <li data-field="plans.{{@../index}}.features.{{@index}}">{{svgIcon "check"}}<span>{{text}}</span></li>
            {{/each}}
          </ul>
        </div>
      </article>
      {{/each}}
    </div>
    {{#if note}}<p class="b-muted b-note" data-field="note">{{note}}</p>{{/if}}
  </div>
</section>
