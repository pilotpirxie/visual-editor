<section class="b-testimonials-stack section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="stack b-deck">
      <div class="b-cards">
        {{#each items}}
        <figure class="card stack b-card" data-field="items.{{@index}}">
          <span class="b-mark">{{svgIcon "quote"}}</span>
          <blockquote class="b-quote"><p>{{nl2br quote}}</p></blockquote>
          <figcaption>
            <p class="b-name">{{name}}</p>
            {{#if role}}<p class="b-role">{{role}}</p>{{/if}}
          </figcaption>
        </figure>
        {{/each}}
      </div>
      <fieldset class="b-picker">
        <legend class="visually-hidden">{{pickerLabel}}</legend>
        {{#each items}}
        <label class="b-pick">
          <input class="visually-hidden" type="radio" name="{{../block.id}}-quote" value="{{@index}}" {{#if @first}}checked{{/if}}>
          <span class="media b-photo">{{img photo}}</span>
          <span class="visually-hidden">{{name}}</span>
        </label>
        {{/each}}
      </fieldset>
    </div>
  </div>
</section>
