<nav class="b-nav-search" data-behavior="menu" aria-label="Main">
  <div class="container b-bar">
    <a class="b-logo" href="index.html">{{site.title}}</a>
    <button type="button" class="btn btn-ghost b-toggle" popovertarget="{{block.id}}-menu" aria-controls="{{block.id}}-menu" aria-expanded="false" data-field="menuIcon">
      {{svgIcon menuIcon}}<span class="visually-hidden">Menu</span>
    </button>
    <div id="{{block.id}}-menu" class="b-menu" popover>
      <form class="b-search" role="search" {{#if searchAction}}action="{{safeUrl searchAction}}" method="get"{{else}}method="dialog"{{/if}} data-field="searchAction">
        <label class="visually-hidden" for="{{block.id}}-q" data-field="searchLabel">{{searchLabel}}</label>
        <button type="submit" class="b-submit" data-field="submitLabel">{{svgIcon "search"}}<span class="visually-hidden">{{submitLabel}}</span></button>
        <input id="{{block.id}}-q" type="search" name="q" placeholder="{{searchPlaceholder}}" data-field="searchPlaceholder">
      </form>
      <ul class="b-links" role="list">
        {{#each links}}
        <li><a href="{{href link}}" {{linkAttrs link}} data-field="links.{{@index}}">{{label}}</a></li>
        {{/each}}
      </ul>
      {{#if showCta}}
      <a class="btn btn-{{cta.variant}}" href="{{href cta.link}}" {{linkAttrs cta.link}} data-field="cta">{{cta.label}}</a>
      {{/if}}
    </div>
  </div>
</nav>
