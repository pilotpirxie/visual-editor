<section class="b-content-agenda section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="stack b-days">
      {{#each days}}
      <div class="b-day" data-field="days.{{@index}}">
        <div class="b-day-head">
          <h3>{{label}}</h3>
          {{#if note}}<p class="b-day-note">{{svgIcon "map-pin"}}<span>{{note}}</span></p>{{/if}}
        </div>
        <ol class="b-sessions" role="list">
          {{#each sessions}}
          <li class="b-session" data-field="days.{{@../index}}.sessions.{{@index}}">
            <p class="b-time">{{time}}</p>
            <div class="stack b-details">
              <div class="b-title-row">
                <h4>{{title}}</h4>
                {{#if tag}}<span class="badge">{{tag}}</span>{{/if}}
              </div>
              {{#if speaker}}<p class="b-speaker">{{speaker}}</p>{{/if}}
              {{#if description}}<p class="b-description">{{nl2br description}}</p>{{/if}}
            </div>
          </li>
          {{/each}}
        </ol>
      </div>
      {{/each}}
    </div>
  </div>
</section>
