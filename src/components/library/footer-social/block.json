{
  "name": "Footer, social icons centered",
  "category": "footers",
  "description": "Centered logo and tagline with large social buttons, a row of links and a legal line.",
  "tags": ["footer", "social", "centered", "icons", "community"],
  "fieldGroups": ["Brand", "Social", "Links", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "tagline",
      "label": "Tagline",
      "type": "textarea",
      "default": "Interview tips, product news and the occasional behind-the-scenes clip. Come say hi.",
      "group": "Brand"
    },
    {
      "name": "socials",
      "label": "Social links",
      "type": "list",
      "group": "Social",
      "minItems": 0,
      "maxItems": 8,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Name",
          "type": "text",
          "default": "Social network"
        },
        {
          "name": "icon",
          "label": "Icon",
          "type": "icon",
          "default": "globe",
          "iconPurpose": "brand"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": true
          }
        }
      ],
      "default": [
        {
          "label": "LinkedIn",
          "icon": "simple-icons:linkedin",
          "link": {
            "type": "url",
            "url": "https://www.linkedin.com",
            "newTab": true
          }
        },
        {
          "label": "YouTube",
          "icon": "simple-icons:youtube",
          "link": {
            "type": "url",
            "url": "https://www.youtube.com",
            "newTab": true
          }
        },
        {
          "label": "Instagram",
          "icon": "simple-icons:instagram",
          "link": {
            "type": "url",
            "url": "https://www.instagram.com",
            "newTab": true
          }
        },
        {
          "label": "Bluesky",
          "icon": "simple-icons:bluesky",
          "link": {
            "type": "url",
            "url": "https://bsky.app",
            "newTab": true
          }
        },
        {
          "label": "GitHub",
          "icon": "simple-icons:github",
          "link": {
            "type": "url",
            "url": "https://github.com",
            "newTab": true
          }
        }
      ]
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 8,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "About",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Blog",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Privacy",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Terms",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "copyright",
      "label": "Legal line",
      "type": "text",
      "default": "© 2026 Fieldnote Inc. All rights reserved.",
      "group": "Legal"
    }
  ]
}
