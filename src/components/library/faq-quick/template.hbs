<section class="b-faq-quick section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="grid b-grid" role="list">
      {{#each items}}
      <li class="stack b-card" data-tone="{{tone}}" data-field="items.{{@index}}">
        <h3 class="b-question">{{question}}</h3>
        <p class="b-answer"><span class="b-mark">{{#if (eq tone "yes")}}{{svgIcon "check"}}{{else if (eq tone "no")}}{{svgIcon "x"}}{{else}}{{svgIcon "clock"}}{{/if}}</span>{{answer}}</p>
        {{#if detail}}<p class="b-detail">{{detail}}</p>{{/if}}
      </li>
      {{/each}}
    </ul>
  </div>
</section>
