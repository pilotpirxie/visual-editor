{
  "name": "Team, carousel",
  "category": "team",
  "description": "A heading and a swipeable row of people with portraits, roles and short bios.",
  "tags": ["team", "people", "carousel", "slider", "about", "bio"],
  "fieldGroups": ["Heading", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Meet the team",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Twenty-eight people, eleven countries, one research habit",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Every one of us joins at least two customer interviews a month. Swipe to meet a few of us.",
      "group": "Heading"
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 16,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "person"
            }
          }
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "Name"
        },
        {
          "name": "role",
          "label": "Role",
          "type": "text",
          "default": "Role"
        },
        {
          "name": "bio",
          "label": "Bio",
          "type": "textarea",
          "default": "One sentence about what this person does.",
          "maxLength": 160
        }
      ],
      "default": [
