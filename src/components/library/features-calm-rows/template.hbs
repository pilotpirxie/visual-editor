<section class="b-features-calm-rows section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-rows" role="list">
      {{#each items}}
      <li class="b-row" data-field="items.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <p><strong>{{name}}</strong> {{text}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
