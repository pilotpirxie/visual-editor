{
  "name": "Modal, side panel",
  "category": "modals",
  "description": "A panel that slides in from the side with a list of dated updates. Opens from any link to its anchor.",
  "tags": ["modal", "dialog", "drawer", "side panel", "sheet", "changelog", "updates", "whats new"],
  "fieldGroups": ["Content", "Updates", "Button"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "What’s new",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Fresh in Fieldnote this month",
      "required": true,
      "group": "Content"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Small improvements, shipped every week. Here are the ones teams asked for most.",
      "group": "Content"
    },
    {
      "name": "closeLabel",
      "label": "Close button label (for screen readers)",
      "type": "text",
      "default": "Close",
      "required": true,
      "group": "Content"
    },
    {
      "name": "items",
      "label": "Updates",
      "type": "list",
      "group": "Updates",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-10-01"
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Update title"
        },
        {
          "name": "text",
          "label": "Text",
          "type": "textarea",
          "default": "One or two sentences about what changed."
        }
      ],
      "default": [
        {
          "date": "2026-10-06",
          "title": "Highlight reels with captions",
          "text": "Every reel now gets burned-in captions, so it plays well in Slack with the sound off."
        },
        {
          "date": "2026-09-29",
          "title": "Tag suggestions while you listen",
          "text": "Fieldnote suggests tags from your team’s tag set as the interview plays."
        },
        {
          "date": "2026-09-18",
          "title": "Data residency in Canada",
          "text": "New workspaces can keep recordings and transcripts in our Montréal region."
        }
      ]
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Read the full changelog",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    }
  ]
}
