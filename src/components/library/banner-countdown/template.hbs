<aside class="b-banner-countdown" aria-label="Offer countdown">
  <div class="container b-bar">
    <p class="b-text" data-field="text">{{text}}</p>
    <p class="b-time" data-field="units">
      {{#each units}}
      <span class="b-unit"><span class="b-num">{{value}}</span> <span class="b-label">{{label}}</span></span>
      {{/each}}
    </p>
    {{#if showButton}}
    <a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
    {{/if}}
  </div>
</aside>
