<section class="b-app-feature-phone section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-device" data-field="screenshot">
      <div class="device b-phone">
        <div class="media device-screen">{{img screenshot}}</div>
      </div>
    </div>
    <ul class="b-list b-start" role="list">
      {{#each startItems}}
      <li class="b-item" data-field="startItems.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <div class="b-copy">
          <h3>{{title}}</h3>
          {{#if text}}<p>{{nl2br text}}</p>{{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    <ul class="b-list b-end" role="list">
      {{#each endItems}}
      <li class="b-item" data-field="endItems.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <div class="b-copy">
          <h3>{{title}}</h3>
          {{#if text}}<p>{{nl2br text}}</p>{{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
