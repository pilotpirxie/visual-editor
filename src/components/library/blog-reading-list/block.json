{
  "name": "Blog posts, reading list",
  "category": "blog",
  "description": "A quiet list of posts on soft rows, each with a small round thumbnail, the title, a reading time and an arrow.",
  "tags": [
    "blog",
    "posts",
    "articles",
    "reading list",
    "reading time",
    "thumbnails",
    "rows",
    "calm"
  ],
  "fieldGroups": ["Heading", "Posts", "Summary"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "The reading list",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Short reads for sore backs and stiff mornings",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "The physiotherapists at Stillwater write one plain-language article a month. Take your time.",
      "group": "Heading"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Thumbnail",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Article thumbnail",
            "decorative": false,
            "width": 400,
            "height": 400,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          }
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "A gentle habit worth five minutes"
        },
        {
          "name": "readingTime",
          "label": "Reading time",
          "type": "text",
          "default": "5 min read"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
