{
  "name": "Blog posts, stacked covers",
  "category": "blog",
  "description": "Numbered post covers that overlap in a tilted diagonal stack on wider screens and sit in a plain column on phones.",
  "tags": ["blog", "posts", "articles", "covers", "stack", "overlap", "numbers", "expressive"],
  "fieldGroups": ["Heading", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "From the bakehouse",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Fresh off the cooling rack",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Recipes, flour notes and the odd confession from the bakers at Hearth & Rye, posted most Fridays.",
      "group": "Heading"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 2,
      "maxItems": 4,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "image",
          "label": "Cover image",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Cover image",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          }
        },
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "What went in the oven this week"
        },
        {
          "name": "category",
          "label": "Category",
          "type": "text",
          "default": "Recipe"
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
