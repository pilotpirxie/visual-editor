<section class="b-testimonials-strip section">
  <div class="container stack b-inner">
    <header class="b-head">
      <h2 class="b-title" data-field="title">{{title}}</h2>
      {{#if rating}}<p class="b-rating" data-field="rating">{{svgIcon "star"}}<span>{{rating}}</span></p>{{/if}}
    </header>
    <ul class="b-row" role="list" aria-label="{{title}}" tabindex="0">
      {{#each items}}
      <li class="b-item" data-field="items.{{@index}}">
        <figure class="b-figure">
          <div class="media b-photo">{{img photo}}</div>
          <blockquote class="b-quote"><p>{{quote}}</p></blockquote>
          <figcaption class="b-name">{{name}}</figcaption>
        </figure>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
