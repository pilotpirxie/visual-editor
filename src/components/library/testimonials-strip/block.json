{
  "name": "Testimonials, short quotes row",
  "category": "testimonials",
  "description": "A compact band of one-line quotes with tiny avatars that swipes on phones.",
  "tags": ["testimonials", "quotes", "short", "band", "row", "compact", "social proof"],
  "fieldGroups": ["Heading", "Quotes"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Loved by research teams in 40 countries",
      "group": "Heading",
      "required": true
    },
    {
      "name": "rating",
      "label": "Rating line",
      "type": "text",
      "default": "4.9 average from 1,200 reviews",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Quotes",
      "type": "list",
      "group": "Quotes",
      "minItems": 1,
      "maxItems": 9,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "text",
          "default": "Short quote",
          "maxLength": 90
        },
        {
          "name": "name",
          "label": "Name and company",
          "type": "text",
          "default": "Name, Company"
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        }
