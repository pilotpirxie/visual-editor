<section class="b-features-notebook section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
      {{#if showButton}}<div class="cluster"><a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a></div>{{/if}}
    </header>
    <div class="b-paper">
      {{#if paperTitle}}<h3 class="b-paper-title" data-field="paperTitle">{{paperTitle}}</h3>{{/if}}
      <ul class="b-list" role="list">
        {{#each items}}
        <li class="b-item" data-field="items.{{@index}}">
          <span class="b-check">{{svgIcon "check"}}</span>
          <span><s class="b-task">{{task}}</s>{{#if result}} <span class="b-result">{{result}}</span>{{/if}}</span>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
