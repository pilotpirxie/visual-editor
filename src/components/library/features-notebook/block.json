{
  "name": "Features, notebook page",
  "category": "features",
  "description": "A taped-down page of lined paper with research chores crossed off and a handwritten-style note beside each.",
  "tags": ["features", "notebook", "paper", "to-do", "checklist", "handwritten", "playful"],
  "fieldGroups": ["Heading", "Page", "Button"],
  "styleOverrides": [
    "--color-background",
    "--color-text",
    "--color-primary",
    "--section-padding-y"
  ],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Your week, shorter",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Cross off the research chores before Monday ends",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "We asked 40 researchers for their weekly to-do list. Most of it is now something Fieldnote does for them.",
      "group": "Heading"
    },
    {
      "name": "paperTitle",
      "label": "Page title",
      "type": "text",
      "default": "Research to-do, week 42",
      "group": "Page"
    },
    {
      "name": "items",
      "label": "Crossed-off tasks",
      "type": "list",
      "group": "Page",
      "minItems": 1,
      "maxItems": 10,
      "itemLabel": "task",
      "itemFields": [
        {
          "name": "task",
          "label": "Task",
          "type": "text",
          "default": "Task",
          "required": true
        },
        {
          "name": "result",
          "label": "Note",
          "type": "text",
          "default": "done"
        }
      ],
      "default": [
        { "task": "Transcribe Tuesday’s six calls", "result": "done by lunch" },
        { "task": "Find the quote about exports", "result": "4 seconds" },
        { "task": "Blur names before sharing", "result": "automatic" },
        { "task": "Make a clip for the roadmap review", "result": "sent to Slack" },
        { "task": "Write up the study", "result": "draft ready" }
      ]
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start your free month",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    }
  ]
}
