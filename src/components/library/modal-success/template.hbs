<div class="b-modal-success" data-behavior="modal">
  <dialog class="modal b-dialog" id="{{block.id}}-dialog" aria-labelledby="{{block.id}}-title">
    <button type="button" class="modal-close" command="close" commandfor="{{block.id}}-dialog" data-field="closeLabel">{{svgIcon "x"}}<span class="visually-hidden">{{closeLabel}}</span></button>
    <div class="stack b-body">
      <div class="b-hero">
        <span class="b-confetti" aria-hidden="true"></span>
        <span class="b-badge" data-field="icon">{{svgIcon icon}}</span>
      </div>
      <h2 id="{{block.id}}-title" data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-muted" data-field="text">{{nl2br text}}</p>{{/if}}
      {{#if details.length}}
      <dl class="b-details">
        {{#each details}}
        <div class="b-detail" data-field="details.{{@index}}"><dt>{{label}}</dt><dd>{{value}}</dd></div>
        {{/each}}
      </dl>
      {{/if}}
      {{#if links.length}}
      <div class="stack b-next">
        {{#if linksTitle}}<p class="eyebrow" data-field="linksTitle">{{linksTitle}}</p>{{/if}}
        <ul class="b-links" role="list">
          {{#each links}}
          <li data-field="links.{{@index}}"><a class="b-link" href="{{href link}}" {{linkAttrs link}}><span class="b-icon">{{svgIcon icon}}</span><span>{{label}}</span>{{svgIcon "arrow-right"}}</a></li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
      <button type="button" class="btn btn-primary" command="close" commandfor="{{block.id}}-dialog" data-field="doneLabel">{{doneLabel}}</button>
    </div>
  </dialog>
</div>
