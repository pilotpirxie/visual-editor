<aside class="b-banner-pill" aria-label="Announcement">
  <div class="container b-inner">
    <a class="b-pill" href="{{href link}}" {{linkAttrs link}} data-field="link">
      {{#if chip}}<span class="b-chip" data-field="chip">{{chip}}</span>{{/if}}
      <span class="b-text" data-field="text">{{text}}</span>
      <span class="b-arrow">{{svgIcon "arrow-right"}}</span>
    </a>
  </div>
</aside>
