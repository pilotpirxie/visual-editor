<section class="b-faq-big-question section">
  <div class="container stack b-inner">
    <p class="b-glyph" aria-hidden="true"><span>?</span></p>
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-list">
      {{#each items}}
      <details class="b-item" name="{{../block.id}}" data-field="items.{{@index}}" {{#if @first}}open{{/if}}>
        <summary class="b-question"><span>{{question}}</span><span class="b-plus">{{svgIcon "plus"}}</span></summary>
        <p class="b-answer">{{nl2br answer}}</p>
      </details>
      {{/each}}
    </div>
  </div>
</section>
