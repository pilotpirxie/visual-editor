<section class="b-blog-featured section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <div class="b-layout">
      <article class="b-featured">
        <div class="media b-media" style="--media-ratio: {{featuredImage.width}} / {{featuredImage.height}}" data-field="featuredImage">{{img featuredImage}}</div>
        <div class="stack b-featured-body">
          {{#if featuredCategory}}<p class="badge" data-field="featuredCategory">{{featuredCategory}}</p>{{/if}}
          <h3 class="b-featured-title" data-field="featuredTitle">{{featuredTitle}}</h3>
          {{#if featuredExcerpt}}<p class="b-excerpt" data-field="featuredExcerpt">{{nl2br featuredExcerpt}}</p>{{/if}}
          {{#if (or featuredAuthor featuredDate)}}
          <p class="b-meta">
            {{#if featuredAuthor}}<span class="b-author" data-field="featuredAuthor">{{featuredAuthor}}</span>{{/if}}
            {{#if featuredDate}}<time datetime="{{featuredDate}}" data-field="featuredDate">{{formatDate featuredDate}}</time>{{/if}}
          </p>
          {{/if}}
          <a class="b-read" href="{{href featuredLink}}" {{linkAttrs featuredLink}} data-field="featuredLinkLabel">{{featuredLinkLabel}}<span class="visually-hidden">: {{featuredTitle}}</span>{{svgIcon "arrow-right"}}</a>
        </div>
      </article>
      <div class="b-more">
        {{#if listTitle}}<h3 class="b-more-title" data-field="listTitle">{{listTitle}}</h3>{{/if}}
        <ul class="b-posts" role="list">
          {{#each posts}}
          <li class="b-post" data-field="posts.{{@index}}">
            {{#if date}}<time class="b-date" datetime="{{date}}">{{formatDate date}}</time>{{/if}}
            <h4 class="b-post-title"><a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{title}}</a></h4>
          </li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>
