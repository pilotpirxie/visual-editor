{
  "name": "Blog posts, featured post and list",
  "category": "blog",
  "description": "One large featured post next to a short list of recent posts.",
  "tags": ["blog", "posts", "articles", "news", "featured", "list"],
  "fieldGroups": ["Heading", "Featured post", "More posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Blog",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "What research teams are learning right now",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "featuredImage",
      "label": "Image",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "A research lead presenting customer clips to a room of product managers",
        "decorative": false,
        "width": 1200,
        "height": 675,
        "placeholder": {
          "ratio": "16:9",
          "subject": "photo"
        }
      },
      "group": "Featured post"
    },
    {
      "name": "featuredCategory",
      "label": "Category",
      "type": "text",
      "default": "Research operations",
      "group": "Featured post"
    },
    {
      "name": "featuredTitle",
      "label": "Title",
      "type": "text",
      "default": "Why your research repository turned into a graveyard, and how to bring it back",
      "required": true,
      "group": "Featured post"
    },
    {
      "name": "featuredExcerpt",
      "label": "Excerpt",
      "type": "textarea",
      "default": "Most teams stop opening their research library within six months. We asked 60 research leads what changed when they replaced long reports with two-minute clips.",
      "group": "Featured post"
    },
    {
      "name": "featuredAuthor",
      "label": "Author",
      "type": "text",
      "default": "Ingrid Solberg",
      "group": "Featured post"
    },
    {
      "name": "featuredDate",
      "label": "Date",
      "type": "date",
      "default": "2026-10-02",
      "group": "Featured post"
    },
    {
      "name": "featuredLinkLabel",
      "label": "Link label",
      "type": "text",
      "default": "Read the article",
      "required": true,
      "group": "Featured post"
    },
    {
      "name": "featuredLink",
      "label": "Link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Featured post"
    },
    {
      "name": "listTitle",
      "label": "List title",
      "type": "text",
      "default": "More from the blog",
      "group": "More posts"
    },
    {
      "name": "posts",
      "label": "Posts",
      "type": "list",
      "group": "More posts",
      "minItems": 1,
      "maxItems": 5,
      "itemLabel": "title",
      "itemFields": [
        {
          "name": "title",
          "label": "Title",
          "type": "text",
          "default": "Post title"
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "title": "How Brightpath cut synthesis from two weeks to three days",
          "date": "2026-09-24",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "title": "A field guide to the jobs-to-be-done interview",
          "date": "2026-09-17",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "title": "Highlight reels now export straight to Jira",
          "date": "2026-09-09",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    }
  ]
}
