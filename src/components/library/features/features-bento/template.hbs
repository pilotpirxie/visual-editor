<section class="b-features-bento section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-tiles" role="list">
      {{#each items}}
      <li class="card b-tile" data-size="{{size}}" data-visual="{{visual}}" data-field="items.{{@index}}">
        <div class="stack b-copy">
          {{#if (eq visual "icon")}}<span class="b-icon">{{svgIcon icon}}</span>{{/if}}
          <h3>{{title}}</h3>
          <p>{{nl2br text}}</p>
        </div>
        {{#if (eq visual "image")}}<div class="media b-media">{{img image}}</div>{{/if}}
      </li>
      {{/each}}
    </ul>
  </div>
</section>
