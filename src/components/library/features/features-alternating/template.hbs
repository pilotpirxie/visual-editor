<section class="b-features-alternating section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="stack b-rows">
      {{#each rows}}
      <article class="b-row" data-field="rows.{{@index}}">
        <div class="stack b-copy">
          <h3>{{title}}</h3>
          <p>{{nl2br text}}</p>
        </div>
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}">
          {{img image}}
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
