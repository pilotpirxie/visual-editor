{
  "name": "Testimonial, quote with logo",
  "category": "testimonials",
  "description": "One large customer quote under the company logo, with a result and the person.",
  "tags": ["testimonial", "quote", "logo", "case study", "customer", "result", "social proof"],
  "fieldGroups": ["Company", "Quote", "Person"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "logo",
      "label": "Company logo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "Northwind",
        "decorative": false,
        "width": 1200,
        "height": 514,
        "placeholder": {
          "ratio": "21:9",
          "subject": "logo"
        }
      },
      "group": "Company"
    },
    {
      "name": "quote",
      "label": "Quote",
      "type": "textarea",
      "default": "Twelve interviews used to mean a week of rewinding recordings. Now the themes are waiting the morning after the last call, and the whole product team reads them.",
      "required": true,
      "group": "Quote"
    },
    {
      "name": "result",
      "label": "Result",
      "type": "text",
      "default": "Cut synthesis time from five days to one",
      "group": "Quote"
    },
    {
      "name": "resultIcon",
      "label": "Result icon",
      "type": "icon",
      "default": "trending-up",
      "group": "Quote"
    },
    {
      "name": "name",
      "label": "Name",
      "type": "text",
      "default": "Jonas Becker",
      "group": "Person"
    },
    {
      "name": "role",
      "label": "Role and company",
      "type": "text",
      "default": "Head of Research, Northwind",
      "group": "Person"
    },
    {
      "name": "photo",
      "label": "Photo",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "Jonas Becker",
        "decorative": false,
        "width": 1200,
        "height": 1200,
        "placeholder": {
          "ratio": "1:1",
          "subject": "person"
        }
      },
      "group": "Person"
    }
  ]
