<section class="b-faq-picker section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-list" role="radiogroup" aria-label="{{title}}">
      {{#each items}}
      <div class="b-item" data-field="items.{{@index}}">
        <label class="b-pick">
          <input type="radio" name="{{../block.id}}-question" {{#if @first}}checked{{/if}}>
          <span>{{question}}</span>
          <span class="b-arrow">{{svgIcon "chevron-right"}}</span>
        </label>
        <div class="prose b-answer">{{richText answer}}</div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
