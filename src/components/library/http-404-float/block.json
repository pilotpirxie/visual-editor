{
  "name": "HTTP code, floating 404",
  "category": "http-codes",
  "description": "A large 404 with a few shapes floating gently around it, above the heading, text and buttons. Still for visitors who prefer reduced motion. Name the page 404 so it exports as 404.html.",
  "tags": ["404", "not found", "error", "animated", "animation", "floating", "shapes", "page"],
  "fieldGroups": ["Content"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "code",
      "label": "Big number",
      "type": "text",
      "default": "404",
      "group": "Content",
      "maxLength": 4
    },
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Page not found",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "This page drifted off",
      "group": "Content",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "The link may be old, or the page may have moved. Head back home, or tell us what you were looking for.",
      "group": "Content"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Back to home",
        "link": {
          "type": "url",
          "url": "index.html",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Content"
    },
    {
      "name": "showSecondaryButton",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Content"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "Contact support",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Content",
      "visibleWhen": {
        "field": "showSecondaryButton",
        "equals": true
      }
    }
  ]
}
