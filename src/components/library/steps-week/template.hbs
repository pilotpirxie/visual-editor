<section class="b-steps-week section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-week" role="list">
      {{#each days}}
      <li class="b-day" data-slot="{{slot}}" data-field="days.{{@index}}">
        <p class="b-date"><span class="eyebrow">{{day}}</span><strong>{{date}}</strong></p>
        <div class="stack b-event">
          {{#if time}}<p class="eyebrow">{{time}}</p>{{/if}}
          <h3>{{title}}</h3>
          {{#if text}}<p class="b-muted">{{nl2br text}}</p>{{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
    {{#if note}}<p class="b-muted" data-field="note">{{note}}</p>{{/if}}
  </div>
</section>
