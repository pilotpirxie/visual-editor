<section class="b-features-quote section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-body">
      <ul class="b-grid" role="list">
        {{#each items}}
        <li class="stack b-item" data-field="items.{{@index}}">
          <span class="b-icon">{{svgIcon icon}}</span>
          <h3>{{title}}</h3>
          <p class="b-muted">{{nl2br text}}</p>
        </li>
        {{/each}}
      </ul>
      <figure class="stack b-quote">
        <span class="b-mark">{{svgIcon "quote"}}</span>
        <blockquote data-field="quote"><p>{{nl2br quote}}</p></blockquote>
        <figcaption class="b-person">
          <div class="media b-photo" data-field="photo">{{img photo}}</div>
          <div>
            <p class="b-name" data-field="name">{{name}}</p>
            {{#if role}}<p class="b-muted" data-field="role">{{role}}</p>{{/if}}
          </div>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
