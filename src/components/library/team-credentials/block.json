            "newTab": false
          }
        },
        {
          "photo": {
            "source": "placeholder",
            "src": "",
            "alt": "Sian Roberts holding a model of a jaw",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          },
          "name": "Sian Roberts",
          "role": "Dental hygienist",
          "qualifications": "Diploma in Dental Hygiene",
