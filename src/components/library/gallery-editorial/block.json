{
  "name": "Gallery, editorial spread",
  "category": "gallery",
  "description": "A magazine-style spread of three photos: one tall, two smaller and offset, with a large italic caption and numbered credits.",
  "tags": ["gallery", "photos", "editorial", "magazine", "spread", "asymmetric", "elegant"],
  "fieldGroups": ["Heading", "Spread"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Project 12 / Loch Awe",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "A boathouse rebuilt around its north light",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "caption",
      "label": "Large caption",
      "type": "textarea",
      "default": "We kept the slipway, the swallows and the smell of creosote. Everything else is new.",
      "maxLength": 160,
      "group": "Spread"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Spread",
      "minItems": 3,
      "maxItems": 3,
      "itemLabel": "credit",
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "photo"
            }
          }
        },
        {
          "name": "credit",
          "label": "Credit",
          "type": "text",
          "default": "Detail of the east wall",
          "maxLength": 60
        }
      ],
      "default": [
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A tall timber door open onto a stone slipway and still water at dawn",
            "decorative": false,
            "width": 900,
            "height": 1200,
            "placeholder": {
              "ratio": "3:4",
              "subject": "photo"
            }
          },
          "credit": "The slipway door at dawn"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Silvered larch boards on the boathouse gable against dark pines",
            "decorative": false,
            "width": 1200,
            "height": 900,
            "placeholder": {
              "ratio": "4:3",
              "subject": "photo"
            }
          },
          "credit": "Larch cladding, year one"
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "A workbench with hand planes under a long north-facing window",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          },
          "credit": "Workbench, north window"
        }
      ]
    }
  ]
}
