<section class="b-gallery-editorial section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <div class="b-spread">
      {{#each items}}
      <figure class="b-shot" data-field="items.{{@index}}">
        <div class="media b-photo">{{img image}}</div>
        <figcaption class="b-credit">{{credit}}</figcaption>
      </figure>
      {{/each}}
      {{#if caption}}<p class="b-caption" data-field="caption">{{nl2br caption}}</p>{{/if}}
    </div>
  </div>
</section>
