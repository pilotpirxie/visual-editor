<section class="b-contact-service-area section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
    </header>
    <div class="b-body">
      <div class="b-map" data-field="mapLabel">
        <span class="b-pin" aria-hidden="true">{{svgIcon "map-pin"}}</span>
        {{#if mapLabel}}<p class="b-label">{{mapLabel}}</p>{{/if}}
      </div>
      <div>
        <ul class="b-areas" role="list">
          {{#each areas}}
          <li class="b-area" data-field="areas.{{@index}}">{{svgIcon "check"}}<span class="b-name">{{name}}</span>{{#if detail}}<span class="b-detail">{{detail}}</span>{{/if}}</li>
          {{/each}}
        </ul>
        {{#if (or (or note phone) showButton)}}
        <div class="cluster">
          {{#if note}}<p data-field="note">{{note}}</p>{{/if}}
          {{#if phone}}<a class="b-phone" href="tel:{{phone}}" data-field="phone">{{svgIcon "phone"}}{{phone}}</a>{{/if}}
          {{#if showButton}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
        </div>
        {{/if}}
      </div>
    </div>
  </div>
</section>
