<section class="b-content-ticket section">
  <div class="container">
    <div class="b-ticket">
      <div class="stack b-main">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
        {{#if text}}<p data-field="text">{{nl2br text}}</p>{{/if}}
        {{#if showButton}}<a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
      </div>
      <div class="b-stub">
        <div>
          {{#if stubLabel}}<p class="b-label" data-field="stubLabel">{{stubLabel}}</p>{{/if}}
          {{#if date}}<time class="b-date" datetime="{{date}}" data-field="date">{{formatDate date}}</time>{{/if}}
        </div>
        <div>
          <p class="b-label" data-field="seatLabel">{{seatLabel}}</p>
          <p class="b-number" data-field="seat">{{seat}}</p>
        </div>
      </div>
    </div>
  </div>
</section>
