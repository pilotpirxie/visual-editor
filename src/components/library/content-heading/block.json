{
  "name": "Content, section heading",
  "category": "content",
  "description": "An eyebrow, a section title and an intro, with an optional button. Left or centered.",
  "tags": ["heading", "title", "intro", "section", "headline"],
  "fieldGroups": ["Heading", "Button", "Layout"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Why teams switch",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Research that reaches the people who build the product",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Fieldnote turns hours of customer calls into short, searchable highlights, so designers, engineers and leaders hear customers in their own words.",
      "group": "Heading"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "See how it works",
        "link": {
          "type": "section",
          "anchor": "features",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "align",
      "label": "Alignment",
      "type": "segmented",
      "default": "center",
      "group": "Layout",
      "options": [
        {
          "value": "left",
          "label": "Left",
          "icon": "align-left"
        },
        {
          "value": "center",
          "label": "Center",
          "icon": "align-center"
        }
      ]
    }
  ]
}
