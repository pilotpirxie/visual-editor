<section class="b-steps-path section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-path" role="list">
      {{#each steps}}
      <li class="b-step" data-field="steps.{{@index}}">
        <div class="stack b-card">
          {{#if label}}<p class="eyebrow">{{label}}</p>{{/if}}
          <h3>{{title}}</h3>
          <p class="b-muted">{{nl2br text}}</p>
        </div>
      </li>
      {{/each}}
    </ol>
    {{#if showButton}}<a class="btn btn-{{button.variant}} b-button" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>{{/if}}
  </div>
</section>
