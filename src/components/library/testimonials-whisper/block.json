{
  "name": "Testimonials, whispers",
  "category": "testimonials",
  "description": "Small muted quotes scattered in a sparse grid with wide spacing, no cards and tiny avatars.",
  "tags": ["testimonials", "quotes", "minimal", "quiet", "calm", "sparse", "avatars"],
  "fieldGroups": ["Heading", "Quotes"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Stillwater Physio",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Quietly said, after the last session",
      "group": "Heading",
      "required": true
    },
    {
      "name": "items",
      "label": "Quotes",
      "type": "list",
      "group": "Quotes",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "textarea",
          "default": "I walked to the station this morning and did not think about my hip once."
        },
        {
          "name": "name",
          "label": "Name",
          "type": "text",
          "default": "First name"
        },
        {
          "name": "role",
          "label": "About them",
          "type": "text",
          "default": "after six sessions"
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Portrait",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        }
      ],
