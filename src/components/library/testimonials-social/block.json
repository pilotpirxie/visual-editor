{
  "name": "Testimonials, social posts",
  "category": "testimonials",
  "description": "Customer posts shown as social media cards with handle, platform and date.",
  "tags": ["testimonials", "social", "posts", "tweets", "mentions", "creators", "app"],
  "fieldGroups": ["Heading", "Posts"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Spotted online",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "People keep posting about their streaks",
      "group": "Heading",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "A few of our favourite posts from people building habits with Brightloop.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Posts",
      "type": "list",
      "group": "Posts",
      "minItems": 1,
      "maxItems": 9,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "icon",
          "label": "Platform icon",
          "type": "icon",
          "default": "simple-icons:x",
          "iconPurpose": "brand"
        },
        {
          "name": "platform",
          "label": "Platform name",
          "type": "text",
          "default": "X"
        },
        {
          "name": "photo",
          "label": "Avatar",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Avatar",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "person"
            }
          }
        },
        {
          "name": "name",
          "label": "Display name",
          "type": "text",
          "default": "Name"
        },
        {
          "name": "handle",
          "label": "Handle",
          "type": "text",
          "default": "@handle"
        },
        {
          "name": "post",
          "label": "Post",
          "type": "textarea",
          "default": "What they posted."
        },
        {
          "name": "date",
          "label": "Date",
          "type": "date",
          "default": "2026-09-01"
        },
        {
          "name": "link",
          "label": "Link to the post",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": true
          }
        }
      ],
      "default": [
        {
