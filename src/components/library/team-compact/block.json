{
  "name": "Team, compact avatars",
  "category": "team",
  "description": "A heading and a dense grid of small round photos with names and roles, for larger teams.",
  "tags": ["team", "people", "avatars", "staff", "directory", "about"],
  "fieldGroups": ["Heading", "People"],
