{
  "name": "Navigation, availability",
  "category": "navigations",
  "description": "A freelancer or studio navbar: name with an availability line under it, links and an email button; a rounded Menu button below 1024 px.",
  "tags": [
    "menu",
    "navbar",
    "header",
    "portfolio",
    "freelance",
    "availability",
    "studio",
    "email",
    "personal"
  ],
  "fieldGroups": ["Availability", "Links", "Email", "Menu"],
  "styleOverrides": ["--color-background", "--color-text", "--color-primary"],
  "fields": [
    {
      "name": "availability",
      "label": "Availability",
      "type": "text",
      "default": "Booking research projects for January",
      "maxLength": 60,
      "help": "Leave empty to hide the line and its dot.",
      "group": "Availability"
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 5,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link",
          "maxLength": 20
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Work",
          "link": {
            "type": "section",
            "anchor": "work",
            "newTab": false
          }
        },
        {
          "label": "Services",
          "link": {
            "type": "section",
            "anchor": "services",
            "newTab": false
          }
        },
        {
          "label": "About",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "email",
      "label": "Email address",
      "type": "text",
      "default": "studio@fieldnote.app",
      "maxLength": 80,
      "help": "Shown as a button that opens the visitor’s email app.",
      "group": "Email"
    },
    {
      "name": "menuIcon",
      "label": "Menu icon",
      "type": "icon",
      "default": "menu",
      "group": "Menu"
    }
  ]
}
