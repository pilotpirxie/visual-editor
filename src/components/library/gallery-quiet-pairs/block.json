{
  "name": "Gallery, quiet pairs",
  "category": "gallery",
  "description": "Rows of two photos, one wide and one narrow, swapping sides on each row, with small captions.",
  "tags": ["gallery", "photos", "pairs", "two columns", "captions", "calm", "minimal"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "An ordinary Tuesday",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Four rooms, a kitchen garden and no television",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Fernhill House sits at the end of a lane above Porthallow cove. Nothing much happens here, which is why people come back.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
