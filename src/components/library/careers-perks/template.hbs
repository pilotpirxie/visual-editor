<section class="b-careers-perks section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="grid b-perks" role="list">
      {{#each perks}}
      <li class="stack b-perk" data-field="perks.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <h3 class="b-perk-title">{{title}}</h3>
        {{#if text}}<p class="b-text">{{nl2br text}}</p>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{#if showCta}}
    <div class="b-cta">
      <p class="b-cta-text" data-field="ctaText">{{ctaText}}</p>
      <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a>
    </div>
    {{/if}}
  </div>
</section>
