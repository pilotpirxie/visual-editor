<section class="b-testimonials-one-line section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <ul class="b-lines" role="list">
      {{#each items}}
      <li data-field="items.{{@index}}">
        <figure class="b-figure">
          <blockquote class="b-quote"><p>{{quote}}</p></blockquote>
          <figcaption class="b-person">
            <span class="b-name">{{name}}</span>
            {{#if role}}<span class="b-role">{{role}}</span>{{/if}}
          </figcaption>
        </figure>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
