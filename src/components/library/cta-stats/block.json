{
  "name": "Call to action, with numbers",
  "category": "call-to-action",
  "description": "A pitch and a button next to three numbers that back it up.",
  "tags": ["cta", "stats", "numbers", "proof", "results"],
  "fieldGroups": ["Content", "Numbers"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Why teams switch",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Spend your week with customers, not with transcripts",
      "group": "Content",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Fieldnote customers cut the time from interview to shared insight from days to hours.",
      "group": "Content"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Content"
    },
    {
      "name": "stats",
      "label": "Numbers",
      "type": "list",
      "group": "Numbers",
      "minItems": 1,
      "maxItems": 3,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "value",
          "label": "Number",
          "type": "text",
          "default": "100"
        },
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "What it counts"
        }
      ],
      "default": [
        {
          "value": "4,200",
          "label": "research teams"
        },
        {
          "value": "6 hrs",
          "label": "saved per study"
        },
        {
          "value": "92%",
          "label": "renew every year"
        }
      ]
    },
    {
      "name": "countUp",
      "label": "Count up when visible",
      "type": "boolean",
      "default": true,
      "group": "Numbers"
    }
  ]
}
