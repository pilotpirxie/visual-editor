<section class="b-testimonials-polaroids section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-wall" role="list">
      {{#each items}}
      <li class="b-slot" data-field="items.{{@index}}">
        <figure class="b-polaroid">
          <div class="media b-photo">{{img photo}}</div>
          <blockquote class="b-quote"><p>{{nl2br quote}}</p></blockquote>
          <figcaption class="b-person">{{name}}{{#if role}}, <span class="b-role">{{role}}</span>{{/if}}</figcaption>
        </figure>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
