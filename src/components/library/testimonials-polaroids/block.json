{
  "name": "Testimonials, photo cards",
  "category": "testimonials",
  "description": "Customer photos as tilted instant prints with a short quote written underneath.",
  "tags": ["testimonials", "quotes", "photos", "polaroid", "playful", "community"],
  "fieldGroups": ["Heading", "Quotes"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Customer snapshots",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Faces behind the feedback",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "A few of the researchers, designers and product managers who use Fieldnote every week.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Photo cards",
      "type": "list",
