{
  "name": "Footer, closing statement",
  "category": "footers",
  "description": "A large closing line with a highlighted phrase and a round button, over a compact row of links.",
  "tags": ["footer", "statement", "big type", "call to action", "round button", "agency"],
  "fieldGroups": ["Statement", "Links", "Legal"],
  "styleOverrides": [
    "--color-background",
    "--color-text",
    "--color-primary",
    "--section-padding-y"
  ],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Before you go",
      "group": "Statement"
    },
    {
      "name": "statement",
      "label": "Statement",
      "type": "text",
      "default": "Every product decision deserves",
      "group": "Statement",
      "required": true,
      "maxLength": 80
    },
    {
      "name": "highlight",
      "label": "Highlighted ending",
      "type": "text",
      "default": "a customer in the room.",
      "group": "Statement",
      "maxLength": 60
    },
    {
      "name": "ctaLabel",
      "label": "Button label",
      "type": "text",
      "default": "Start a study",
      "group": "Statement",
      "maxLength": 24,
      "help": "Leave empty to hide the round button."
    },
    {
      "name": "ctaLink",
      "label": "Button link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "#",
        "newTab": false
      },
      "group": "Statement"
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 8,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Product",
          "link": {
            "type": "section",
            "anchor": "features",
            "newTab": false
          }
        },
        {
          "label": "Pricing",
          "link": {
            "type": "section",
            "anchor": "pricing",
            "newTab": false
          }
        },
        {
          "label": "Journal",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Careers",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Privacy",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "copyright",
      "label": "Legal line",
      "type": "text",
      "default": "© 2026 Fieldnote Inc.",
      "group": "Legal"
    }
  ]
}
