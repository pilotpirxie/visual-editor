<section class="b-features-callouts section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <div class="b-body">
      <div class="b-shot">
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}" data-field="image">{{img image}}</div>
        {{#each items}}
        <span class="b-num b-marker" style="--x: {{x}}; --y: {{y}}" aria-hidden="true" data-field="items.{{@index}}"></span>
        {{/each}}
      </div>
      <ol class="b-list" role="list">
        {{#each items}}
        <li class="b-item" data-field="items.{{@index}}">
          <span class="b-num" aria-hidden="true"></span>
          <div class="stack b-copy">
            <h3>{{title}}</h3>
            <p>{{nl2br text}}</p>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>
  </div>
</section>
