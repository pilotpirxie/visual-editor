{
  "name": "Navigation, icon links",
  "category": "navigations",
  "description": "A navbar whose links each sit under a small icon tile, with a button on the right; on phones the menu opens as a grid of icon tiles.",
  "tags": ["menu", "navbar", "header", "icons", "tiles", "app launcher", "grid", "product"],
  "fieldGroups": ["Links", "Button", "Menu"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 1,
      "maxItems": 6,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "icon",
          "label": "Icon",
          "type": "icon",
          "default": "sparkles"
        },
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link",
          "maxLength": 20
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "icon": "mic",
          "label": "Interviews",
          "link": {
            "type": "section",
            "anchor": "features",
            "newTab": false
          }
        },
        {
          "icon": "transcript",
          "label": "Transcripts",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "icon": "lightbulb",
          "label": "Insights",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "icon": "chart",
          "label": "Reports",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "icon": "puzzle",
          "label": "Integrations",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "showCta",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "cta",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "visibleWhen": {
        "field": "showCta",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "menuIcon",
      "label": "Menu icon",
      "type": "icon",
      "default": "menu",
      "group": "Menu"
    }
  ]
}
