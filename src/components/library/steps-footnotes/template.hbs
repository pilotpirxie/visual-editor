<section class="b-steps-footnotes section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <div class="b-sentence" data-field="sentence">{{richText sentence}}</div>
    <ol class="b-notes" role="list">
      {{#each steps}}
      <li data-field="steps.{{@index}}">
        <h3>{{title}}</h3>
        <p>{{nl2br text}}</p>
      </li>
      {{/each}}
    </ol>
  </div>
</section>
