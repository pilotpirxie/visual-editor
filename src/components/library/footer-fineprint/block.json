          "minItems": 0,
          "maxItems": 8,
          "itemLabel": "label",
          "itemFields": [
            {
              "name": "label",
              "label": "Label",
              "type": "text",
              "default": "Link"
            },
            {
              "name": "link",
              "label": "Link",
              "type": "link",
              "default": {
                "type": "url",
                "url": "#",
                "newTab": false
              }
            }
          ],
          "default": []
        }
      ],
      "default": [
