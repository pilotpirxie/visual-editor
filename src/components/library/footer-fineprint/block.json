{
  "name": "Footer, legal fine print",
  "category": "footers",
  "description": "Link columns over a boxed block of small print in two newspaper columns, for pricing, trademark and regulatory notes.",
  "tags": [
    "footer",
    "legal",
    "fine print",
    "disclosure",
    "disclaimer",
    "terms",
    "finance",
    "regulated",
    "columns"
  ],
  "fieldGroups": ["Columns", "Fine print", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
