<section class="b-steps-carousel section" data-behavior="carousel">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-muted" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-track" data-carousel-track role="list" aria-label="{{title}}" tabindex="0">
      {{#each steps}}
      <li class="b-slide" data-carousel-slide data-field="steps.{{@index}}">
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}">{{img image}}</div>
        <div class="stack b-body">
          <h3>{{title}}</h3>
          <p class="b-muted">{{nl2br text}}</p>
        </div>
      </li>
      {{/each}}
    </ol>
    <div class="b-controls" data-carousel-controls hidden>
      <button type="button" class="btn btn-secondary b-arrow" data-carousel-previous>{{svgIcon "arrow-left"}}<span class="visually-hidden">Previous step</span></button>
      <div class="b-dots" data-carousel-dots="Step"></div>
      <button type="button" class="btn btn-secondary b-arrow" data-carousel-next>{{svgIcon "arrow-right"}}<span class="visually-hidden">Next step</span></button>
    </div>
  </div>
</section>
