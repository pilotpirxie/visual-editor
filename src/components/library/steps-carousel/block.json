{
  "name": "How it works, swipeable steps",
  "category": "how-it-works",
  "description": "Step cards with screenshots that scroll sideways, with buttons and dots.",
  "tags": ["steps", "process", "carousel", "slider", "swipe", "app", "onboarding", "screenshots"],
  "fieldGroups": ["Heading", "Steps"],
