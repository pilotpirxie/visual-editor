{
  "name": "Content, image with list",
  "category": "content",
  "description": "An image beside a heading, short text, a checklist and an optional button.",
  "tags": ["content", "image", "list", "checklist", "benefits", "split"],
  "fieldGroups": ["Content", "List", "Button", "Image"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "For research operations",
      "group": "Content"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "One home for every interview your company runs",
      "required": true,
      "group": "Content"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Fieldnote replaces the shared drive of recordings nobody can find. Every team records, tags and shares in one place, under the same rules.",
      "group": "Content"
    },
    {
      "name": "checkIcon",
      "label": "Check icon",
      "type": "icon",
      "default": "check",
      "group": "List"
    },
    {
      "name": "items",
      "label": "Items",
      "type": "list",
      "group": "List",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "text",
      "itemFields": [
        {
          "name": "text",
          "label": "Text",
          "type": "text",
          "default": "Item"
        }
      ],
      "default": [
        {
          "text": "Consent forms sent and stored with every recording"
        },
        {
          "text": "Personal details redacted from transcripts automatically"
        },
        {
          "text": "Retention rules per project, from 30 days to seven years"
        },
        {
          "text": "Access by team, by project or for a single interview"
        }
      ]
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "See security features",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "image",
      "label": "Image",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "A research operations lead reviewing interview access settings with a colleague",
        "decorative": false,
        "width": 1200,
        "height": 900,
        "placeholder": {
          "ratio": "4:3",
          "subject": "photo"
        }
      },
      "group": "Image"
    },
    {
      "name": "imageSide",
      "label": "Image side",
      "type": "segmented",
      "default": "left",
      "group": "Image",
      "options": [
        {
          "value": "left",
          "label": "Left",
          "icon": "panel-left"
        },
        {
          "value": "right",
          "label": "Right",
          "icon": "panel-right"
        }
      ]
    }
  ]
}
