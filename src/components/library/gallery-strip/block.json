{
  "name": "Gallery, scrolling strip",
  "category": "gallery",
  "description": "A heading and a row of photos of mixed widths that scrolls sideways, without JavaScript.",
  "tags": ["gallery", "photos", "images", "strip", "scroll", "horizontal", "filmstrip"],
  "fieldGroups": ["Heading", "Photos"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Behind the scenes",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "A year of Fieldnote in photos",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Launches, retreats and a lot of interviews.",
      "group": "Heading"
    },
    {
      "name": "hint",
      "label": "Scroll hint",
      "type": "text",
      "default": "Scroll for more",
      "group": "Heading"
    },
    {
      "name": "items",
