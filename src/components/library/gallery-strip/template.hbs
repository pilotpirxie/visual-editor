<section class="b-gallery-strip section">
  <div class="stack b-inner">
    <div class="container b-top">
      <header class="stack b-head">
        {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
        <h2 data-field="title">{{title}}</h2>
        {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
      </header>
      {{#if hint}}<p class="b-hint" data-field="hint">{{hint}}{{svgIcon "arrow-right"}}</p>{{/if}}
    </div>
    <div class="b-strip" role="region" aria-label="{{title}}" tabindex="0">
      {{#each items}}
      <figure class="b-item" style="--media-ratio: {{image.width}} / {{image.height}}" data-field="items.{{@index}}">
        <div class="media b-media">{{img image}}</div>
        {{#if caption}}<figcaption class="b-caption">{{caption}}</figcaption>{{/if}}
      </figure>
      {{/each}}
    </div>
  </div>
</section>
