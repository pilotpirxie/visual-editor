<section class="b-content-haiku section">
  <div class="container stack b-inner">
    {{#if icon}}<span class="b-icon" data-field="icon">{{svgIcon icon}}</span>{{/if}}
    <h2 class="b-poem">
      <span class="b-line" data-field="line1">{{line1}}</span>
      <span class="b-line" data-field="line2">{{line2}}</span>
      <span class="b-line" data-field="line3">{{line3}}</span>
    </h2>
    {{#if signature}}<p class="b-signature" data-field="signature">{{signature}}</p>{{/if}}
  </div>
</section>
