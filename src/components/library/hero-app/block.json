{
  "name": "Hero, mobile app",
  "category": "headers",
  "description": "Page heading, app store buttons and a rating next to a phone showing the app.",
  "tags": [
    "hero",
    "heading",
    "app",
    "mobile",
    "download",
    "app store",
    "google play",
    "phone",
    "launch"
  ],
  "fieldGroups": ["Heading", "Stores", "Phone"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "New: guided audio runs",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Your running coach, right in your pocket",
      "required": true,
      "maxLength": 120,
      "group": "Heading"
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Training plans that adapt to your pace, voice cues while you run and a streak that keeps you going. Free for the first month.",
      "group": "Heading"
    },
    {
      "name": "stores",
      "label": "Store buttons",
      "type": "list",
      "group": "Stores",
      "minItems": 1,
      "maxItems": 3,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "icon",
          "label": "Store logo",
          "type": "icon",
          "default": "simple-icons:apple",
          "iconPurpose": "brand"
        },
        {
          "name": "smallLabel",
          "label": "Small label",
          "type": "text",
          "default": "Download on the"
        },
        {
          "name": "label",
          "label": "Store name",
          "type": "text",
          "default": "App Store"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": true
          }
        }
      ],
      "default": [
        {
          "icon": "simple-icons:apple",
          "smallLabel": "Download on the",
          "label": "App Store",
          "link": {
            "type": "url",
            "url": "https://apps.apple.com",
            "newTab": true
          }
        },
        {
          "icon": "simple-icons:googleplay",
          "smallLabel": "Get it on",
          "label": "Google Play",
          "link": {
            "type": "url",
            "url": "https://play.google.com",
            "newTab": true
          }
        }
      ]
    },
    {
      "name": "rating",
      "label": "Rating",
      "type": "text",
      "default": "4.9 out of 5 from 18,000 runners",
      "group": "Stores"
    },
    {
      "name": "screenshot",
      "label": "Screenshot",
      "type": "image",
      "default": {
        "source": "placeholder",
        "src": "",
        "alt": "The app’s training plan with this week’s three runs and today’s pace target",
        "decorative": false,
        "width": 900,
        "height": 1200,
        "placeholder": {
          "ratio": "3:4",
          "subject": "screenshot"
        }
      },
      "group": "Phone"
    },
    {
      "name": "highlightIcon",
      "label": "Highlight icon",
      "type": "icon",
      "default": "trophy",
      "group": "Phone"
    },
    {
      "name": "highlight",
      "label": "Highlight next to the phone",
      "type": "text",
      "default": "21-day streak",
      "maxLength": 40,
      "group": "Phone"
    }
  ]
}
