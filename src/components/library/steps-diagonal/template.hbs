<section class="b-steps-diagonal section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ol class="b-cascade" role="list" style="--n: {{steps.length}}">
      {{#each steps}}
      <li style="--i: {{@index}}" data-field="steps.{{@index}}">
        <h3>{{title}}</h3>
        <p>{{nl2br text}}</p>
        {{#if time}}<p class="b-time">{{time}}</p>{{/if}}
      </li>
      {{/each}}
    </ol>
  </div>
</section>
