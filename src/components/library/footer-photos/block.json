        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Sticky notes grouped into themes on a wall",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          }
        },
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Team watching interview clips together",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          }
