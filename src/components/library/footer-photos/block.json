{
  "name": "Footer, photo strip",
  "category": "footers",
  "description": "An edge-to-edge row of square photos with a follow button for your social account, over a compact footer row.",
  "tags": ["footer", "photos", "instagram", "social", "gallery", "feed", "follow"],
  "fieldGroups": ["Photos", "Follow", "Links", "Legal"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "photos",
      "label": "Photos",
      "type": "list",
      "group": "Photos",
      "minItems": 3,
      "maxItems": 6,
      "itemFields": [
        {
          "name": "image",
          "label": "Photo",
          "type": "image",
          "default": {
            "source": "placeholder",
            "src": "",
            "alt": "Photo",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          }
        }
      ],
      "default": [
        {
          "image": {
            "source": "placeholder",
            "src": "",
            "alt": "Two researchers reviewing interview notes on a whiteboard",
            "decorative": false,
            "width": 1200,
            "height": 1200,
            "placeholder": {
              "ratio": "1:1",
              "subject": "photo"
            }
          }
        },
        {
