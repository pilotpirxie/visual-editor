    {
      "name": "handle",
      "label": "Account name",
      "type": "text",
      "default": "@fieldnote.research",
      "group": "Follow",
      "help": "Leave empty to hide the follow button."
    },
    {
      "name": "followLabel",
      "label": "Button text",
      "type": "text",
      "default": "Follow us on Instagram",
      "group": "Follow"
    },
    {
      "name": "followIcon",
      "label": "Icon",
      "type": "icon",
      "default": "simple-icons:instagram",
      "iconPurpose": "brand",
      "group": "Follow"
    },
    {
      "name": "followLink",
      "label": "Link",
      "type": "link",
      "default": {
        "type": "url",
        "url": "https://www.instagram.com",
        "newTab": true
      },
      "group": "Follow"
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 6,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
