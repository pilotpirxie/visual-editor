{
  "name": "Team, with hiring card",
  "category": "team",
  "description": "A grid of people that ends with a card inviting visitors to see open roles.",
  "tags": ["team", "people", "hiring", "careers", "jobs", "about"],
  "fieldGroups": ["Heading", "People", "Hiring card"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Our team",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Built by people who love a good interview",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "We are a remote-first team with an office on King Street West for anyone who wants one.",
      "group": "Heading"
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 15,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "photo",
          "label": "Photo",
