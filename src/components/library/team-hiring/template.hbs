<section class="b-team-hiring section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-people" role="list">
      {{#each people}}
      <li class="stack b-person" data-field="people.{{@index}}">
        <div class="media b-photo">{{img photo}}</div>
        <div>
          <h3 class="b-name">{{name}}</h3>
          {{#if role}}<p class="b-role">{{role}}</p>{{/if}}
        </div>
      </li>
      {{/each}}
      {{#if showHiring}}
      <li class="stack b-hiring">
        <span class="b-hiring-icon" data-field="hiringIcon">{{svgIcon hiringIcon}}</span>
        <h3 class="b-name" data-field="hiringTitle">{{hiringTitle}}</h3>
        {{#if hiringText}}<p class="b-role" data-field="hiringText">{{nl2br hiringText}}</p>{{/if}}
        <a class="btn btn-{{hiringButton.variant}} b-hiring-button" href="{{href hiringButton.link}}" {{linkAttrs hiringButton.link}} data-field="hiringButton">{{hiringButton.label}}</a>
      </li>
      {{/if}}
    </ul>
  </div>
</section>
