{
  "name": "Team, ID badges",
  "category": "team",
  "description": "New teammates as hanging lanyard badges with a colored team band, photo, name and start date.",
  "tags": ["team", "new hires", "badges", "welcome", "people", "playful", "onboarding"],
  "fieldGroups": ["Heading", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "New this quarter",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Say hello to our newest teammates",
      "required": true,
      "group": "Heading"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Four people joined Fieldnote this spring. Their badges are printed, their laptops are set up and their first customer calls are booked.",
      "group": "Heading"
    },
    {
      "name": "people",
      "label": "People",
      "type": "list",
      "group": "People",
      "minItems": 1,
      "maxItems": 8,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "department",
          "label": "Team",
          "type": "text",
          "default": "Team"
        },
        {
          "name": "tone",
          "label": "Band color",
          "type": "select",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Brand color"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ]
        },
        {
          "name": "photo",
          "label": "Photo",
          "type": "image",
