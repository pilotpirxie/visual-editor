<section class="b-faq-accordion section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <div class="b-list">
      {{#each items}}
      <details class="b-item" name="{{../block.id}}-faq" data-field="items.{{@index}}">
        <summary class="b-question"><span>{{question}}</span><span class="b-icon">{{svgIcon ../expandIcon}}</span></summary>
        <div class="prose b-answer">{{richText answer}}</div>
      </details>
      {{/each}}
    </div>
  </div>
</section>
