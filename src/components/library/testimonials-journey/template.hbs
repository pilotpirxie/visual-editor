<section class="b-testimonials-journey section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <figure class="stack b-figure">
      <ol class="b-path" role="list">
        {{#each stages}}
        <li class="stack b-stage" data-field="stages.{{@index}}">
          <p class="b-when">{{label}}</p>
          <blockquote class="b-quote"><p>{{nl2br quote}}</p></blockquote>
        </li>
        {{/each}}
      </ol>
      <figcaption class="b-person">
        <div class="media b-photo" data-field="photo">{{img photo}}</div>
        <div>
          <p class="b-name" data-field="name">{{name}}</p>
          {{#if role}}<p class="b-role" data-field="role">{{role}}</p>{{/if}}
        </div>
      </figcaption>
    </figure>
  </div>
</section>
