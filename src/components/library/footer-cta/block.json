{
  "name": "Footer, with call to action",
  "category": "footers",
  "description": "A bold call to action panel above a row with the logo, links and legal line.",
  "tags": ["footer", "cta", "call to action", "signup", "links"],
  "fieldGroups": ["Call to action", "Links", "Legal"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Your next roadmap decision deserves a real customer voice",
      "group": "Call to action",
      "required": true
    },
    {
      "name": "text",
      "label": "Text",
      "type": "textarea",
      "default": "Run your first five interviews free. Setup takes ten minutes.",
      "group": "Call to action"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Call to action"
    },
    {
      "name": "showSecondaryButton",
      "label": "Show second button",
      "type": "boolean",
      "default": true,
      "group": "Call to action"
    },
    {
      "name": "secondaryButton",
      "label": "Second button",
      "type": "button",
      "default": {
        "label": "Book a demo",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "secondary"
      },
      "group": "Call to action",
      "visibleWhen": {
        "field": "showSecondaryButton",
        "equals": true
      }
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 0,
      "maxItems": 10,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ],
      "default": [
        {
          "label": "Features",
          "link": {
            "type": "section",
            "anchor": "features",
            "newTab": false
          }
        },
        {
          "label": "Pricing",
          "link": {
            "type": "section",
            "anchor": "pricing",
            "newTab": false
          }
        },
        {
          "label": "Customers",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Help center",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "label": "Privacy",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        }
      ]
    },
    {
      "name": "copyright",
      "label": "Legal line",
      "type": "text",
      "default": "© 2026 Fieldnote Inc. All rights reserved.",
      "group": "Legal"
    }
  ]
}
