<section class="b-gallery-portholes section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
    </header>
    <ul class="b-row" role="list">
      {{#each items}}
      <li class="b-item" data-field="items.{{@index}}">
        <figure>
          <div class="media b-photo">{{img image}}</div>
          <figcaption class="b-caption">
            <span class="b-name">{{caption}}</span>
            {{#if detail}}<span>{{detail}}</span>{{/if}}
          </figcaption>
        </figure>
      </li>
      {{/each}}
    </ul>
  </div>
</section>
