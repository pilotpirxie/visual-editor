<section class="b-features-sticky section">
  <div class="container b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if intro}}<p class="b-intro" data-field="intro">{{nl2br intro}}</p>{{/if}}
      {{#if showButton}}<div class="cluster"><a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}</a></div>{{/if}}
    </header>
    <ol class="b-list" role="list">
      {{#each items}}
      <li class="stack b-item" data-field="items.{{@index}}">
        <span class="b-icon">{{svgIcon icon}}</span>
        <h3>{{title}}</h3>
        <p class="b-text">{{nl2br text}}</p>
        <div class="media b-media" style="--media-ratio: {{image.width}} / {{image.height}}">{{img image}}</div>
      </li>
      {{/each}}
    </ol>
  </div>
</section>
