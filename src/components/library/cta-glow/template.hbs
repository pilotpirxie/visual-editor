<section class="b-cta-glow section">
  <div class="container">
    <div class="b-panel stack">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
      {{#if text}}<p class="b-text" data-field="text">{{nl2br text}}</p>{{/if}}
      <p class="b-cta">
        <a class="btn btn-{{button.variant}}" href="{{href button.link}}" {{linkAttrs button.link}} data-field="button">{{button.label}}{{svgIcon "arrow-right"}}</a>
      </p>
      {{#if note}}<p class="b-note" data-field="note">{{note}}</p>{{/if}}
    </div>
  </div>
</section>
