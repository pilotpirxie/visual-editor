<section class="b-logos-results section">
  <div class="container stack b-inner">
    <header class="stack b-head">
      {{#if eyebrow}}<p class="eyebrow" data-field="eyebrow">{{eyebrow}}</p>{{/if}}
      <h2 data-field="title">{{title}}</h2>
    </header>
    <ul class="b-list" role="list">
      {{#each items}}
      <li class="stack b-item" data-field="items.{{@index}}">
        <div class="b-logo">{{img image}}</div>
        <p class="b-metric">{{metric}}</p>
        <p class="b-label">{{label}}</p>
        {{#if linkLabel}}<a class="b-link" href="{{href link}}" {{linkAttrs link}}>{{linkLabel}}<span class="visually-hidden">: {{company}}</span>{{svgIcon "arrow-right"}}</a>{{/if}}
      </li>
      {{/each}}
    </ul>
  </div>
</section>
