{
  "name": "Navigation, tab bar",
  "category": "navigations",
  "description": "Links in a segmented tab bar with the current page raised, logo on the left and a button on the right; a menu button below 1024 px.",
  "tags": ["menu", "navbar", "header", "tabs", "segmented", "pill", "current page", "app"],
  "fieldGroups": ["Logo", "Links", "Button", "Menu"],
  "styleOverrides": ["--color-background", "--color-text"],
  "fields": [
    {
      "name": "logoIcon",
      "label": "Logo icon",
      "type": "icon",
      "default": "lucide:audio-lines",
      "iconPurpose": "logo",
      "group": "Logo"
    },
    {
      "name": "links",
      "label": "Links",
      "type": "list",
      "group": "Links",
      "minItems": 1,
      "maxItems": 6,
      "itemLabel": "label",
      "itemFields": [
        {
          "name": "label",
          "label": "Label",
          "type": "text",
          "default": "Link"
        },
        {
          "name": "link",
          "label": "Link",
          "type": "link",
          "default": {
            "type": "url",
            "url": "#",
            "newTab": false
          }
        },
        {
          "name": "current",
          "label": "Current page",
          "type": "boolean",
          "default": false,
          "help": "Raises this tab to show visitors where they are."
        }
      ],
      "default": [
        {
          "label": "Product",
          "link": {
            "type": "section",
            "anchor": "features",
            "newTab": false
          },
          "current": true
        },
        {
          "label": "Research library",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          },
          "current": false
        },
        {
          "label": "Pricing",
          "link": {
            "type": "section",
            "anchor": "pricing",
            "newTab": false
          },
          "current": false
        },
        {
          "label": "Changelog",
          "link": {
            "type": "url",
            "url": "#",
            "newTab": false
          },
          "current": false
        }
      ]
    },
    {
      "name": "showCta",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "cta",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "Start free trial",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "visibleWhen": {
        "field": "showCta",
        "equals": true
      },
      "group": "Button"
    },
    {
      "name": "menuIcon",
      "label": "Menu icon",
      "type": "icon",
      "default": "menu",
      "group": "Menu"
    }
  ]
}
