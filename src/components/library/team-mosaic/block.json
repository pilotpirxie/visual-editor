{
  "name": "Team, avatar mosaic",
  "category": "team",
  "description": "A big team number and short pitch beside a dense mosaic of round portraits.",
  "tags": ["team", "avatars", "mosaic", "people", "hiring", "culture", "number"],
  "fieldGroups": ["Text", "Button", "People"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Our people",
      "group": "Text"
    },
    {
      "name": "number",
      "label": "Big number",
      "type": "text",
      "default": "28",
      "maxLength": 8,
      "group": "Text"
    },
    {
      "name": "numberLabel",
      "label": "Number label",
      "type": "text",
      "default": "people in 6 cities",
      "group": "Text"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "A small team that talks to customers every week",
      "required": true,
      "group": "Text"
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Researchers, engineers and designers who would rather hear it from a customer than guess. We are hiring in Toronto, Lisbon and remotely across the Americas.",
      "group": "Text"
    },
    {
      "name": "showButton",
      "label": "Show button",
      "type": "boolean",
      "default": true,
      "group": "Button"
    },
    {
      "name": "button",
      "label": "Button",
      "type": "button",
      "default": {
        "label": "See open roles",
        "link": {
          "type": "url",
          "url": "#",
          "newTab": false
        },
        "variant": "primary"
      },
      "group": "Button",
      "visibleWhen": {
        "field": "showButton",
        "equals": true
      }
    },
    {
      "name": "people",
      "label": "People",
