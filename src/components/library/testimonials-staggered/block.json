{
  "name": "Testimonials, staggered columns",
  "category": "testimonials",
  "description": "Three columns of quote cards with the middle column set lower and in the primary color.",
  "tags": ["testimonials", "quotes", "cards", "grid", "staggered", "columns"],
  "fieldGroups": ["Heading", "Quotes"],
  "styleOverrides": ["--color-background", "--color-text", "--section-padding-y"],
  "fields": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "default": "Reviews",
      "group": "Heading"
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Research that travels beyond the research team",
      "group": "Heading",
      "required": true
    },
    {
      "name": "intro",
      "label": "Intro",
      "type": "textarea",
      "default": "Product managers, designers and support leads on what changed when customer evidence became easy to share.",
      "group": "Heading"
    },
    {
      "name": "items",
      "label": "Quotes",
      "type": "list",
      "group": "Quotes",
      "minItems": 1,
      "maxItems": 9,
      "itemLabel": "name",
      "itemFields": [
        {
          "name": "quote",
          "label": "Quote",
          "type": "textarea",
          "default": "What the customer said."
