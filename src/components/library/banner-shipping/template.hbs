<aside class="b-banner-shipping" aria-label="Free shipping">
  <div class="container b-bar">
    <p class="b-text" data-field="text">{{text}}</p>
    <div class="b-road" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{progress}}" aria-label="{{goal}}" style="--progress: {{progress}}" data-field="progress">
      <span class="b-fill"><span class="b-marker">{{svgIcon icon}}</span></span>
    </div>
    <p class="b-goal" data-field="goal">{{goal}}</p>
  </div>
</aside>
